                                        <Ellipse Width="10" Height="10" Fill="#B983FF"/>
                                        <Ellipse Width="10" Height="10" Fill="#FF8C42"/>
                                        <Ellipse Width="10" Height="10" Fill="#4CC2FF"/>
                                    </StackPanel>
                                    <TextBlock Text="霓虹" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="MonColorIce" Grid.Row="0" Grid.Column="2"
