<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.AddItemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameLocker"
    xmlns:ctl="using:GameLocker.Controls">

    <Grid Background="Transparent"
          RequestedTheme="Dark">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + 返回 -->
        <Grid Grid.Row="0" Padding="20,16">
            <TextBlock x:Name="PageTitle" Text="添加快捷项" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="BackButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Click="OnBackClick">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- 表单状态（ScrollViewer 包裹：窄窗口下内容超出可滚动，控件不被遮盖） -->
        <ScrollViewer x:Name="FormScroll" Grid.Row="1" Padding="24,8"
                      VerticalScrollMode="Auto" HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="FormPanel" Spacing="12">
                <TextBox x:Name="NameBox" Header="显示名称" PlaceholderText="例如：Steam"/>
                <Grid x:Name="TargetRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetBox" Grid.Column="0" Header="程序路径 / URL"
                             PlaceholderText="C:\...\game.exe 或 https://..." VerticalAlignment="Bottom"/>
                    <Button x:Name="BrowseButton" Grid.Column="1" Margin="8,24,0,0"
                            VerticalAlignment="Bottom" Click="OnBrowseClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE838;" FontSize="14"/>
                            <TextBlock Text="浏览…"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 图片组定向文件夹（仅图片组编辑时显示） -->
                <StackPanel x:Name="PhotoFolderRow" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="图片文件夹" FontSize="15" Opacity="0.9"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PhotoFolderText" Grid.Column="0" VerticalAlignment="Center"
                                   FontSize="14" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                   Text="未选择"/>
                        <Button x:Name="PhotoFolderButton" Grid.Column="1" Margin="8,0,0,0"
                                Click="OnPhotoFolderClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                <TextBlock Text="选择文件夹…"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- 图片组设置：轮播速度 / 切换动画 / 展示模式（仅图片组编辑时显示） -->
                <StackPanel x:Name="PhotoSettingsPanel" Spacing="14" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="轮播速度" FontSize="17" FontWeight="Bold" Opacity="0.95"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton x:Name="SpeedFastRadio" Content="快 · 30秒" GroupName="PhotoSpeed" Padding="14,10" IsChecked="True"/>
                            <RadioButton x:Name="SpeedSlowRadio" Content="慢 · 3分钟" GroupName="PhotoSpeed" Padding="14,10"/>
                            <RadioButton x:Name="SpeedArtRadio" Content="艺术 · 30分钟" GroupName="PhotoSpeed" Padding="14,10"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="切换动画" FontSize="17" FontWeight="Bold" Opacity="0.95" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="AnimationToggle" OnContent="开" OffContent="关"/>
                    </StackPanel>
                </StackPanel>

                <!-- 映射小组件：映射按键（仅映射编辑时显示） -->
                <StackPanel x:Name="MappingRow" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="映射按键" FontSize="15" Opacity="0.9"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MappingText" Grid.Column="0" VerticalAlignment="Center"
                                   FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Text="未设置"/>
                        <Button x:Name="MappingCaptureButton" Grid.Column="1" Margin="8,0,0,0"
                                Click="OnMappingCaptureClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7FC;" FontSize="14"/>
                                <TextBlock Text="捕获按键…"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- 类型 / 磁贴大小 / 磁贴颜色：三列并排，颜色为紧凑色块（无说明文字） -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="KindColumn" Grid.Column="0" Spacing="4" Margin="0,0,18,0">
                        <TextBlock Text="类型" FontSize="17" FontWeight="Bold" Opacity="0.95"/>
                        <RadioButtons x:Name="KindRadios" MaxColumns="1">
                            <RadioButton x:Name="AppRadio" Content="程序" Padding="14,10" IsChecked="True"/>
                            <RadioButton x:Name="UrlRadio" Content="网站" Padding="14,10"/>
                            <RadioButton x:Name="FolderRadio" Content="文件夹" Padding="14,10"/>
                        </RadioButtons>
                    </StackPanel>
                    <StackPanel x:Name="SizeColumn" Grid.Column="1" Spacing="4" Margin="0,0,18,0">
                        <TextBlock Text="磁贴大小" FontSize="17" FontWeight="Bold" Opacity="0.95"/>
                        <RadioButtons x:Name="SizeRadios" MaxColumns="1">
                            <RadioButton x:Name="SmallSizeRadio" Content="小" Padding="14,10"/>
                            <RadioButton x:Name="WideSizeRadio" Content="长方形" Padding="14,10" IsChecked="True"/>
                            <RadioButton x:Name="LargeSizeRadio" Content="大" Padding="14,10"/>
                        </RadioButtons>
                    </StackPanel>
                    <StackPanel x:Name="ColorColumn" Grid.Column="2" Spacing="4">
                        <TextBlock Text="磁贴颜色" FontSize="17" FontWeight="Bold" Opacity="0.95"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="ColorBlueRadio" Grid.Row="0" Grid.Column="0" GroupName="TileColor"
                                         Tag="#0078D4" Background="#0078D4" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                            <RadioButton x:Name="ColorRedRadio" Grid.Row="0" Grid.Column="1" GroupName="TileColor"
                                         Tag="#E83D2F" Background="#E83D2F" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                            <RadioButton x:Name="ColorGreenRadio" Grid.Row="0" Grid.Column="2" GroupName="TileColor"
                                         Tag="#108A45" Background="#108A45" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                            <RadioButton x:Name="ColorPurpleRadio" Grid.Row="1" Grid.Column="0" GroupName="TileColor"
                                         Tag="#744DA9" Background="#744DA9" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                            <RadioButton x:Name="ColorNoneRadio" Grid.Row="1" Grid.Column="1" GroupName="TileColor"
                                         Tag="none" Background="#1FFFFFFF" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0">
                                <FontIcon Glyph="&#xE711;" FontSize="16" Opacity="0.8"/>
                            </RadioButton>
                            <RadioButton x:Name="ColorTealRadio" Grid.Row="1" Grid.Column="2" GroupName="TileColor"
                                         Tag="#00B294" Background="#00B294" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                            <RadioButton x:Name="ColorYellowRadio" Grid.Row="2" Grid.Column="0" GroupName="TileColor"
                                         Tag="#F7B500" Background="#F7B500" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                            <RadioButton x:Name="ColorPinkRadio" Grid.Row="2" Grid.Column="1" GroupName="TileColor"
                                         Tag="#E3008C" Background="#E3008C" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                            <RadioButton x:Name="ColorIndigoRadio" Grid.Row="2" Grid.Column="2" GroupName="TileColor"
                                         Tag="#4B53CC" Background="#4B53CC" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 图标 -->
                <TextBlock x:Name="IconHeaderText" Text="图标" FontSize="15" Opacity="0.9"/>
                <StackPanel x:Name="IconRow" Orientation="Horizontal" Spacing="12">
                    <Border Width="44" Height="44" CornerRadius="6" Background="#22FFFFFF" VerticalAlignment="Center">
                        <Grid>
                            <FontIcon x:Name="PreviewGlyph" Glyph="&#xE7F8;" FontSize="26"/>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <Button x:Name="IconButton" VerticalAlignment="Center" Click="OnIconClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEB9F;" FontSize="14"/>
                            <TextBlock Text="更改图标…"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 磁贴背景图片 -->
                <TextBlock x:Name="CoverHeaderText" Text="磁贴图片（设置后整块磁贴显示图片）" FontSize="15" Opacity="0.9"/>
                <StackPanel x:Name="CoverRow" Orientation="Horizontal" Spacing="12">
                    <Border Width="44" Height="44" CornerRadius="6" Background="#22FFFFFF" VerticalAlignment="Center">
                        <Grid>
                            <FontIcon x:Name="CoverPreviewGlyph" Glyph="&#xEB9F;" FontSize="22" Opacity="0.5"/>
                            <Image x:Name="CoverPreviewImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <Button x:Name="CoverButton" VerticalAlignment="Center" Click="OnCoverClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B9;" FontSize="14"/>
                            <TextBlock Text="选择图片…"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CoverClearButton" VerticalAlignment="Center" Visibility="Collapsed" Click="OnCoverClearClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            <TextBlock Text="清除"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button x:Name="SaveButton" Margin="0,6,0,12" HorizontalAlignment="Left" Click="OnSaveClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                        <TextBlock Text="保存"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- 文件浏览状态 -->
        <Grid x:Name="BrowsePanel" Grid.Row="1" Padding="20,4" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="PathText" Grid.Row="0" FontSize="13" Opacity="0.7"
                       TextTrimming="CharacterEllipsis" Margin="4,4,4,8"/>
            <ListView x:Name="FileList" Grid.Row="1" SelectionMode="Single"
                      IsTabStop="False" ScrollViewer.VerticalScrollMode="Enabled">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FileEntry">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16"/>
                            <TextBlock Text="{x:Bind Name}" FontSize="15"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 底部按键提示：手柄图标徽章，单行，透明背景 -->
        <ctl:GamepadHintBar x:Name="HintBar" Grid.Row="2" Margin="0,8,0,12"/>
    </Grid>
</Page>
