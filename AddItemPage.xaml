                                <Grid>
                                    <TextBlock Text="显存使用" FontSize="14" Margin="0,0,22,0"/>
                                    <FontIcon x:Name="MonOptVramMark" Glyph="&#xE711;" FontSize="14"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
