<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.KeybindPage"
    IsTabStop="True"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:GameLocker.Controls"
    xmlns:local="using:GameLocker">

    <Page.Resources>
        <!-- 卡片：手柄焦点以"整张卡片"为一个选中框（代码里只改描边与底色），卡内内容只读 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12,14,12"/>
        </Style>

        <!-- 场景标签：卡片左上角的小胶囊 -->
        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="Background" Value="#2A4C9AFF"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="PillTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#BBD8FF"/>
        </Style>

        <!-- 键帽：手柄操作与触屏操作共用同款样式，保证两列外观完全一致 -->
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#3DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="ChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9ECBFF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 表头文字：与键帽同列对齐，用浅蓝弱化字表示"列名"而非数据 -->
        <Style x:Key="HeadTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7FB6F0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- 说明行，按「手柄操作 → 触屏操作 → 实际操作效果」排列；
             前两列同款键帽，效果列白字加粗并以 ▸ 标记突出 -->
        <DataTemplate x:Key="RowTpl" x:DataType="local:ControlRow">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="116"/>
                    <ColumnDefinition Width="116"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ChipStyle}">
                    <TextBlock Text="{x:Bind Pad}" Style="{StaticResource ChipTextStyle}"/>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ChipStyle}">
                    <TextBlock Text="{x:Bind Touch}" Style="{StaticResource ChipTextStyle}"/>
                </Border>

                <Grid Grid.Column="2" ColumnSpacing="7" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE76C;" FontSize="10" Foreground="#4CC2FF"
                              VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Effect}" FontSize="13.5"
                               FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- 说明列表只展示内容，不产生"行级选中"（手柄按卡片整体选择） -->
        <Style x:Key="RowListStyle" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource RowTpl}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="7"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分区标题 -->
        <Style x:Key="SectionHeadStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#BBD8FF"/>
            <Setter Property="Margin" Value="4,2,0,0"/>
        </Style>

        <!-- 键位捕获按钮：外形像一枚键帽，可点可按 A -->
        <Style x:Key="KeyCapStyle" TargetType="Button">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#3DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent"
          RequestedTheme="Dark" XYFocusKeyboardNavigation="Enabled">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 -->
        <Grid Grid.Row="0" Padding="20,16,20,10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="BackButton" Background="Transparent" BorderThickness="0" Click="OnBackClick" IsTabStop="False">
                    <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                </Button>
                <TextBlock Text="控制" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 内容区：每张卡片就是一个手柄选中框，方向键整卡上下切换 -->
        <ScrollViewer x:Name="PageScroller" Grid.Row="1" Padding="20,4,20,12" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- 一、快捷映射：只放三个键位捕获，和下方基本操作说明分开 -->
                <TextBlock Text="快捷映射" Style="{StaticResource SectionHeadStyle}"/>

                <!-- 呼出窗口组合键 -->
                <Border x:Name="CardSummon" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <Border Style="{StaticResource PillStyle}">
                            <TextBlock Style="{StaticResource PillTextStyle}" Text="呼出窗口组合键"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="CaptureButton" Style="{StaticResource KeyCapStyle}" Click="OnCaptureClick">
                                <TextBlock x:Name="CaptureText" FontSize="15" FontWeight="SemiBold" Foreground="#CFE2FF"/>
                            </Button>
                            <TextBlock Text="按 A 或点击后按住想要的组合键，全部松开即保存"
                                       FontSize="12.5" Opacity="0.55" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 键盘呼出键（仅键盘，按下即刻呼出，无需长按） -->
                <Border x:Name="CardKeySummon" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <Border Style="{StaticResource PillStyle}">
                            <TextBlock Style="{StaticResource PillTextStyle}" Text="键盘呼出键"/>
                        </Border>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="KeyCaptureButton" Style="{StaticResource KeyCapStyle}"
                                    Click="OnKeyCaptureClick" VerticalAlignment="Center">
                                <TextBlock x:Name="KeyCaptureText" FontSize="15" FontWeight="SemiBold" Foreground="#CFE2FF"/>
                            </Button>
                            <TextBlock Grid.Column="1" Text="按 A 或点击后按下想要的按键（可含 Ctrl/Shift/Alt/Win），松开即保存；再按呼出键收起"
                                       FontSize="12.5" Opacity="0.55" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 切换全屏组合键 -->
                <Border x:Name="CardFullscreen" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <Border Style="{StaticResource PillStyle}">
                            <TextBlock Style="{StaticResource PillTextStyle}" Text="切换全屏组合键"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="FsCaptureButton" Style="{StaticResource KeyCapStyle}" Click="OnFsCaptureClick">
                                <TextBlock x:Name="FsCaptureText" FontSize="15" FontWeight="SemiBold" Foreground="#CFE2FF"/>
                            </Button>
                            <TextBlock Text="按 A 或点击后按住想要的组合键，全部松开即保存"
                                       FontSize="12.5" Opacity="0.55" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 分隔：快捷映射 / 基本操作 -->
                <Border Height="1" Background="#1FFFFFFF" Margin="0,6"/>

                <!-- 二、基本操作：只列通用操作，不细分到每个页面 -->
                <TextBlock Text="基本操作" Style="{StaticResource SectionHeadStyle}"/>

                <Border x:Name="CardBasic" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <!-- 表头行：列宽与下方键帽行严格一致，读起来就是表格的列名 -->
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="116"/>
                                    <ColumnDefinition Width="116"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="手柄操作" Style="{StaticResource HeadTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="触屏操作" Style="{StaticResource HeadTextStyle}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="#4CC2FF"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="实际操作效果" Style="{StaticResource HeadTextStyle}"
                                               HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="#1FFFFFFF"/>
                        </StackPanel>

                        <ItemsControl x:Name="LvBasic" Style="{StaticResource RowListStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ctl:GamepadHintBar Grid.Row="2" Margin="0,8,0,12"
                            Hints="DPAD:切换卡片|A:捕获键位|B:返回"/>
    </Grid>
</Page>
