<Page
    x:Class="GameLocker.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameLocker"
    xmlns:ctl="using:GameLocker.Controls">

    <Grid Background="Transparent" RequestedTheme="Dark">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + 返回 -->
        <Grid Grid.Row="0" Padding="20,16">
            <TextBlock x:Name="PageTitle" Text="小组件" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="BackButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Click="OnBackClick">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- 组件列表：磁贴式自适应排布 —— 卡片尺寸固定，列数按可用宽度算（侧边栏 3 列、全屏/居中更多列），
             整块水平居中；实际坐标由 WidgetPage.LayoutCards() 写入，与主页磁贴同一套做法 -->
        <ScrollViewer x:Name="FormScroll" Grid.Row="1" Padding="12,8"
                      HorizontalContentAlignment="Left"
                      VerticalScrollMode="Auto" VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Canvas x:Name="FormPanel">

                <!-- 音乐控制器组件卡片：缩小磁贴预览（样式与主页一致）+ 名称 + 简述 -->
                <Button x:Name="MusicWidgetCard" Tag="music" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="TilePreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="音乐控制器" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="控制正在播放的音乐"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 图片组组件卡片：缩小磁贴预览（占位样式）+ 名称 + 简述 -->
                <Button x:Name="PhotoWidgetCard" Tag="photo" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="PhotoPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="图片组" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="轮番展示文件夹图片"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 天气组件卡片：缩小天气磁贴预览（显示当前位置当天天气）+ 名称 + 简述 -->
                <Button x:Name="WeatherWidgetCard" Tag="weather" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="WeatherPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="天气" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="当前位置当天天气"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 映射组件卡片：缩小映射磁贴预览（显示已映射按键）+ 名称 + 简述 -->
                <Button x:Name="MappingWidgetCard" Tag="mapping" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="MappingPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="磁贴映射" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="映射手柄或键盘按键"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 修改器组件卡片：缩小修改器磁贴预览（扳手图标）+ 名称 + 简述 -->
                <Button x:Name="TrainerWidgetCard" Tag="trainer" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="TrainerPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="修改器" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="自动下载并打开当前游戏修改器"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 游戏存档组件卡片：缩小游戏存档磁贴预览（保存图标）+ 名称 + 简述 -->
                <Button x:Name="BackupWidgetCard" Tag="backup" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="BackupPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="游戏存档" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="一键备份 · Y 键同步当前游戏存档"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 手柄映射组件卡片：缩小手柄映射磁贴预览（手柄图标 + 开关状态）+ 名称 + 简述 -->
                <Button x:Name="GamepadMapWidgetCard" Tag="gamepadmap" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="GamepadMapPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="手柄映射" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="把多个手柄键映射成键盘/鼠标/手柄键"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- OptiScaler 组件卡片：缩小 OptiScaler 磁贴预览（图像图标 + 名称）+ 名称 + 简述 -->
                <Button x:Name="OptiScalerWidgetCard" Tag="optiscaler" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="OptiScalerPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="OptiScaler" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="检测当前游戏适配性，一键注入 OptiScaler"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 回收站组件卡片：缩小回收站磁贴预览（垃圾桶图标）+ 名称 + 简述 -->
                <Button x:Name="RecycleBinWidgetCard" Tag="recyclebin" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="RecycleBinPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="回收站" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="A 打开回收站，Y 一键清空"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 前台应用监测组件卡片：缩小前台应用磁贴预览（应用图标 + 进程名 + 状态）+ 名称 + 简述 -->
                <Button x:Name="ForegroundWidgetCard" Tag="foreground" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="ForegroundPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="前台应用" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="监测当前前台应用，A 冻结/解冻，Y 结束进程"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 系统组件卡片：缩小系统磁贴预览 + 名称 + 简述（右摇杆切换面板项） -->
                <Button x:Name="SystemWidgetCard" Tag="system" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="SystemPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="系统" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="设置/电脑/音量/亮度&#x0A;WiFi/蓝牙/热点/夜间"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 性能监控组件卡片：缩小监控磁贴预览（状态点 + 运行状态）+ 名称 + 简述 -->
                <Button x:Name="MonitorWidgetCard" Tag="monitor" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="MonitorPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="性能监控" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="A 开启置顶条：帧率/CPU/GPU/电池/内存"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 文件传输组件卡片：缩小磁贴预览（发送图标 + 名称）+ 名称 + 简述 -->
                <Button x:Name="FileTransferWidgetCard" Tag="filetransfer" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="FileTransferPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="文件传输" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="局域网互传文件：搜索设备、连接、发送"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 小黄鸭联动组件卡片：状态磁贴预览 + 名称 + 简述 -->
                <Button x:Name="LosslessScalWidgetCard" Tag="lossless" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="LosslessScalPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="小黄鸭" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="窗口捕获插帧：一键启动并发送热键"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Canvas>
        </ScrollViewer>

        <!-- 底部按键提示：手柄图标徽章，单行，透明背景 -->
        <ctl:GamepadHintBar Grid.Row="2" Margin="0,8,0,12"
                            Hints="A:添加到主页|B:返回"/>
    </Grid>
</Page>
