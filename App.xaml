<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="GameLocker.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary
            xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 卡片式单选项：圆角边框 + 半透明底色与背景区分 + 选中态左侧青色竖条 -->
            <Style TargetType="RadioButton">
                <Setter Property="Background" Value="#1FFFFFFF"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="Accent" Width="4" CornerRadius="2"
                                            Margin="2,4,0,4" Background="#4CC2FF"
                                            Visibility="Collapsed"/>
                                    <ContentPresenter Grid.Column="1" Margin="12,0,4,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                </Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked"/>
                                        <VisualState x:Name="Indeterminate"/>
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Accent"
                                                                               Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 卡片式开关：圆角边框 + 半透明底色与背景区分 + 开启时左侧青色竖条 + 右侧药丸 -->
            <Style TargetType="ToggleSwitch">
                <Setter Property="Background" Value="#1FFFFFFF"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <!-- 与默认样式一致：缺少它时触摸轻触不会产生手势/切换（仅鼠标或代码赋值有效） -->
                <Setter Property="ManipulationMode" Value="System,TranslateX"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleSwitch">
                            <Border x:Name="Card"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 交互所需模板部件（对齐默认模板）：命中测试区 + 焦点目标。
                                         原先自定义模板缺失它们，导致开关无法被点击/触摸切换。 -->
                                    <Grid x:Name="SwitchAreaGrid" Grid.ColumnSpan="3"
                                          Background="Transparent"
                                          Control.IsTemplateFocusTarget="True"/>

                                    <Border x:Name="Accent" Width="4" CornerRadius="2"
                                            Margin="2,4,0,4" Background="#4CC2FF"
                                            Visibility="Collapsed"/>
                                    <ContentPresenter Grid.Column="1" Margin="12,0,8,0"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding Header}"/>
                                    <Border Grid.Column="2" Width="44" Height="22"
                                            CornerRadius="11" VerticalAlignment="Center">
                                        <Grid>
                                            <Border x:Name="Pill" CornerRadius="11"
                                                    Background="#33FFFFFF"
                                                    BorderBrush="#88FFFFFF" BorderThickness="1"/>
                                            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="White"
                                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                                     Margin="5,0,0,0">
                                                <Ellipse.RenderTransform>
                                                    <TranslateTransform x:Name="KnobT"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>
                                    </Border>

                                    <!-- ToggleSwitch 内部拖拽逻辑引用的位移元素（不可见，仅占位防空引用） -->
                                    <Grid x:Name="SwitchKnob" Visibility="Collapsed">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="KnobTranslateTransform"/>
                                        </Grid.RenderTransform>
                                    </Grid>

                                    <!-- 覆盖整张卡片的透明拖拽层：轻触卡片任意位置即可切换开关 -->
                                    <primitives:Thumb x:Name="SwitchThumb" Grid.ColumnSpan="3"
                                                      AutomationProperties.AccessibilityView="Raw">
                                        <primitives:Thumb.Template>
                                            <ControlTemplate TargetType="primitives:Thumb">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </primitives:Thumb.Template>
                                    </primitives:Thumb>
                                </Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="ToggleSwitchStates">
                                        <VisualState x:Name="Off">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Accent"
                                                                               Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Pill"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#33FFFFFF"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Pill"
                                                                               Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#88FFFFFF"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="KnobT"
                                                                 Storyboard.TargetProperty="X" To="0"
                                                                 Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate"/>
                                        <VisualState x:Name="On">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Accent"
                                                                               Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Pill"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#FF4CC2FF"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Pill"
                                                                               Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#FF4CC2FF"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="KnobT"
                                                                 Storyboard.TargetProperty="X" To="22"
                                                                 Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources></Application>
