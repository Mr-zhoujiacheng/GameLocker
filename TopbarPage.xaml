<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.TopbarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:GameLocker.Controls">

    <Page.Resources>
        <!-- 开关行卡片：直角 + 浅蓝渐变底；选中时由代码改 BorderBrush 画白框 -->
        <Style x:Key="SettingRowStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
        <!-- 开关本体：自绘胶囊（隐去 On/Off 文字与多余留白），随 IsOn 变色、滑块滑动 -->
        <Style x:Key="CleanToggleStyle" TargetType="ToggleSwitch">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleSwitch">
                        <Grid Width="44" Height="22" Background="Transparent">
                            <Border Width="40" Height="20" CornerRadius="10" Background="#2AFFFFFF"
                                    BorderThickness="1" BorderBrush="#4DFFFFFF"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="Fill" Width="40" Height="20" CornerRadius="10" Background="#C64CC2FF"
                                    Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#FFFFFF"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <CompositeTransform/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="ToggleStates">
                                    <VisualState x:Name="Off">
                                        <VisualState.Setters>
                                            <Setter Target="Knob.Fill" Value="#FFFFFF"/>
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                                                             To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="On">
                                        <VisualState.Setters>
                                            <Setter Target="Knob.Fill" Value="#1F1F1F"/>
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                                                             To="20" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent"
          RequestedTheme="Dark" XYFocusKeyboardNavigation="Enabled">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="20,16">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="BackButton" Background="Transparent" BorderThickness="0" Click="OnBackClick" IsTabStop="False">
                    <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                </Button>
                <TextBlock Text="顶栏" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 内容区可滚动：窄窗口下控件不被遮盖 -->
        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="20,8,20,10" VerticalScrollBarVisibility="Hidden">
            <Grid x:Name="SwitchGrid" ColumnSpacing="10" RowSpacing="10" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 时钟 -->
                <Button x:Name="ClockRow" Style="{StaticResource SettingRowStyle}" Click="OnRowClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#4A4CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="40" Background="#B34CC2FF" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="34" Height="34" Background="#3D4CC2FF"
                                BorderThickness="1" BorderBrush="#6B4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE823;" FontSize="16"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="时钟" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="顶栏左侧显示当前时间与日期" FontSize="11.5"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="ClockToggle" Grid.Column="3" Style="{StaticResource CleanToggleStyle}"
                                      IsHitTestVisible="False" IsTabStop="False" VerticalAlignment="Center"
                                      OnContent="" OffContent=""
                                      Toggled="OnToggleChanged"/>
                    </Grid>
                </Button>

                <!-- 电池 -->
                <Button x:Name="BatteryRow" Style="{StaticResource SettingRowStyle}" Click="OnRowClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#4A4CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="40" Background="#B34CC2FF" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="34" Height="34" Background="#3D4CC2FF"
                                BorderThickness="1" BorderBrush="#6B4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE850;" FontSize="16"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="电池" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="顶栏右侧按格显示电量，颜色随电量变化" FontSize="11.5"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="BatteryToggle" Grid.Column="3" Style="{StaticResource CleanToggleStyle}"
                                      IsHitTestVisible="False" IsTabStop="False" VerticalAlignment="Center"
                                      OnContent="" OffContent=""
                                      Toggled="OnToggleChanged"/>
                    </Grid>
                </Button>

                <!-- 无线网络 -->
                <Button x:Name="WifiRow" Style="{StaticResource SettingRowStyle}" Click="OnRowClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#4A4CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="40" Background="#B34CC2FF" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="34" Height="34" Background="#3D4CC2FF"
                                BorderThickness="1" BorderBrush="#6B4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE701;" FontSize="16"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="无线网络" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="顶栏右侧显示 Wi-Fi 状态，绿=已连接" FontSize="11.5"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="WifiToggle" Grid.Column="3" Style="{StaticResource CleanToggleStyle}"
                                      IsHitTestVisible="False" IsTabStop="False" VerticalAlignment="Center"
                                      OnContent="" OffContent=""
                                      Toggled="OnToggleChanged"/>
                    </Grid>
                </Button>

                <!-- 蓝牙 -->
                <Button x:Name="BluetoothRow" Style="{StaticResource SettingRowStyle}" Click="OnRowClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#4A4CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="40" Background="#B34CC2FF" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="34" Height="34" Background="#3D4CC2FF"
                                BorderThickness="1" BorderBrush="#6B4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE702;" FontSize="16"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="蓝牙" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="顶栏右侧显示蓝牙状态，绿=已连接" FontSize="11.5"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="BluetoothToggle" Grid.Column="3" Style="{StaticResource CleanToggleStyle}"
                                      IsHitTestVisible="False" IsTabStop="False" VerticalAlignment="Center"
                                      OnContent="" OffContent=""
                                      Toggled="OnToggleChanged"/>
                    </Grid>
                </Button>

                <!-- 手柄 -->
                <Button x:Name="GamepadRow" Style="{StaticResource SettingRowStyle}" Click="OnRowClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#4A4CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="40" Background="#B34CC2FF" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="34" Height="34" Background="#3D4CC2FF"
                                BorderThickness="1" BorderBrush="#6B4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7FC;" FontSize="16"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="手柄" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="顶栏右侧显示手柄连接状态，绿=已连接" FontSize="11.5"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="GamepadIconToggle" Grid.Column="3" Style="{StaticResource CleanToggleStyle}"
                                      IsHitTestVisible="False" IsTabStop="False" VerticalAlignment="Center"
                                      OnContent="" OffContent=""
                                      Toggled="OnToggleChanged"/>
                    </Grid>
                </Button>
            </Grid>
        </ScrollViewer>

        <ctl:GamepadHintBar Grid.Row="2" Margin="0,8,0,12"
                            Hints="DPAD:选择|A:切换|B:返回"/>
    </Grid>
</Page>
