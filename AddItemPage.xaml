<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.AddItemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameLocker"
    xmlns:ctl="using:GameLocker.Controls">

    <Page.Resources>
        <!-- 页脚保存按钮：透明底 + 浅蓝强调色内容，悬停/按下/焦点只用极淡白叠加，
             避免实心色块与半透明背景割裂（与本页其他控件、KeybindPage 卡片同款语言） -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BBD8FF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="Overlay" Background="Transparent"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter x:Name="Presenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Overlay.Background" Value="#0FFFFFFF"/>
                                            <Setter Target="Overlay.BorderBrush" Value="#4C9AFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Overlay.Background" Value="#1FFFFFFF"/>
                                            <Setter Target="Overlay.BorderBrush" Value="#4C9AFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="Overlay.BorderBrush" Value="#BBD8FF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 手柄映射编辑面板·输出类型三选一：胶囊分段样式（未选=半透明白描边，选中=淡蓝底+浅蓝描边+白字）。
             两个描边元素分工：CursorRing 绑定控件本地 BorderBrush（手柄光标白色高亮），
             StateRing 表达选中/键盘焦点态——VisualState 的 Setter 优先级高于本地值，
             若两者共用一个 Border，手柄光标就会被选中态覆盖而看不见（用户实测）。 -->
        <Style x:Key="ChipRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="Foreground" Value="#E6EEF9"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <!-- 选中/键盘焦点描边（淡蓝），与光标描边互不覆盖 -->
                            <Border x:Name="StateRing" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="1.5"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter x:Name="Presenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- 光标描边：只跟控件本地 BorderBrush 走（任何 VisualState 都不改它），
                                 且画在最上层，选中态也不会把光标白框盖掉 -->
                            <Border x:Name="CursorRing"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#1AFFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#26FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked"/>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#332E6BE6"/>
                                            <Setter Target="StateRing.BorderBrush" Value="#BBD8FF"/>
                                            <Setter Target="Presenter.Foreground" Value="#FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="StateRing.BorderBrush" Value="#BBD8FF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 系统小组件编辑·显示项目：图标 + 名称胶囊。
             选中/未选的视觉（底色、文字色、右侧勾/叉图标）全部由代码 ApplySysChipVisual 直接设置：
             该自定义模板下 VisualState 的 Setter 实测不生效（IsChecked 已翻转但界面无变化），故不走 VisualState。
             光标描边单独一层，只跟控件本地 BorderBrush 走，不会和选中态互相覆盖。 -->
        <Style x:Key="SysOptionChipStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="Foreground" Value="#E6EEF9"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter x:Name="Presenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                            <!-- 光标描边：只跟控件本地 BorderBrush 走（任何状态都不改它），画在最上层 -->
                            <Border x:Name="CursorRing"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 手柄映射编辑面板·次操作（删除映射）：透明底 + 柔红描边 -->
        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFC9BE"/>
            <Setter Property="BorderBrush" Value="#3DFF8A7A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="Overlay" Background="Transparent"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Overlay.Background" Value="#14FFFFFF"/>
                                            <Setter Target="Overlay.BorderBrush" Value="#BBD8FF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Overlay.Background" Value="#22FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.35"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="Overlay.BorderBrush" Value="#BBD8FF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 手柄映射编辑面板·主操作（设置/切换输出目标）：实心强调蓝 -->
        <Style x:Key="ChipPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E6BE6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#3D7BF2"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#2459C4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.35"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.85"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent"
          RequestedTheme="Dark">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>  <!-- 页脚固定操作栏：保存 -->
            <RowDefinition Height="Auto"/>  <!-- 底部按键提示 -->
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 -->
        <Grid Grid.Row="0" Padding="20,16">
            <TextBlock x:Name="PageTitle" Text="添加快捷项" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Grid>

        <!-- 表单状态（ScrollViewer 包裹：窄窗口下内容超出可滚动，控件不被遮盖）；
             内容放进一层 FormHost 里，由 AddItemPage.LayoutForm() 把它的宽度设为视口宽、表单限宽居中，
             这样在侧边栏 / 全屏 / 居中三种模式下排版一致（自动跟随窗口宽度变化） -->
        <ScrollViewer x:Name="FormScroll" Grid.Row="1" Padding="24,8"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollMode="Auto" HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Hidden">
            <Grid x:Name="FormHost">
                <!-- 表单内容限宽居中：窗口变宽（全屏/居中模式）时保持与侧边栏下一致的排版 -->
                <StackPanel x:Name="FormPanel" Spacing="12" HorizontalAlignment="Center">
                <TextBox x:Name="NameBox" Header="显示名称" PlaceholderText="例如：Steam"/>
                <Grid x:Name="TargetRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetBox" Grid.Column="0" Header="程序路径 / URL"
                             PlaceholderText="C:\...\game.exe 或 https://..." VerticalAlignment="Bottom"/>
                    <Button x:Name="BrowseButton" Grid.Column="1" Margin="8,24,0,0"
                            VerticalAlignment="Bottom" Click="OnBrowseClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE838;" FontSize="14"/>
                            <TextBlock Text="浏览…"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 图片组定向文件夹（仅图片组编辑时显示） -->
                <StackPanel x:Name="PhotoFolderRow" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="图片文件夹" FontSize="15" Opacity="0.9"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PhotoFolderText" Grid.Column="0" VerticalAlignment="Center"
                                   FontSize="14" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                   Text="未选择"/>
                        <Button x:Name="PhotoFolderButton" Grid.Column="1" Margin="8,0,0,0"
                                Click="OnPhotoFolderClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                <TextBlock Text="选择文件夹…"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- 图片组设置：轮播速度 / 切换动画 / 展示模式（仅图片组编辑时显示） -->
                <StackPanel x:Name="PhotoSettingsPanel" Spacing="14" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="轮播速度" FontSize="15" Opacity="0.9"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton x:Name="SpeedFastRadio" Content="快 · 30秒" GroupName="PhotoSpeed" Padding="14,10" IsChecked="True"/>
                            <RadioButton x:Name="SpeedSlowRadio" Content="慢 · 3分钟" GroupName="PhotoSpeed" Padding="14,10"/>
                            <RadioButton x:Name="SpeedArtRadio" Content="艺术 · 30分钟" GroupName="PhotoSpeed" Padding="14,10"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="切换动画" FontSize="15" Opacity="0.9" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="AnimationToggle" OnContent="开" OffContent="关"/>
                    </StackPanel>
                </StackPanel>

                <!-- 壁纸小组件：来源 / 轮番速度 / 个性喜好 / 下载到本地
                     （仅壁纸编辑时显示；固定大磁贴，名称固定为「壁纸」，不可改大小与颜色） -->
                <StackPanel x:Name="WallpaperRow" Spacing="14" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="图片来源" FontSize="15" Opacity="0.9"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton x:Name="WpSourceBingRadio" Content="Bing 每日壁纸" GroupName="WallpaperSource" Padding="14,10" IsChecked="True"/>
                            <RadioButton x:Name="WpSourcePicsumRadio" Content="Picsum 随机壁纸" GroupName="WallpaperSource" Padding="14,10"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="轮番速度" FontSize="15" Opacity="0.9"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton x:Name="WpSpeedFastRadio" Content="快 · 1分钟" GroupName="WallpaperSpeed" Padding="14,10"/>
                            <RadioButton x:Name="WpSpeedSlowRadio" Content="慢 · 10分钟" GroupName="WallpaperSpeed" Padding="14,10" IsChecked="True"/>
                            <RadioButton x:Name="WpSpeedArtRadio" Content="长 · 30分钟" GroupName="WallpaperSpeed" Padding="14,10"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="个性喜好" FontSize="15" Opacity="0.9"/>
                        <Border HorizontalAlignment="Left" CornerRadius="8" Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                            <Image x:Name="WpPreview" Height="150" Stretch="Uniform"/>
                        </Border>
                        <TextBlock x:Name="WpCurrentText" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                   Text="当前壁纸：—"/>
                        <TextBlock x:Name="WpPreferenceText" FontSize="12" Opacity="0.7" Text="已收藏 0 张 · 已排除 0 张"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="WpLikeButton" Click="OnWpLikeClick" ToolTipService.ToolTip="收藏后这张壁纸在轮播中出现得更频繁">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEB51;" FontSize="14"/>
                                    <TextBlock Text="收藏当前"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="WpBlockButton" Click="OnWpBlockClick" ToolTipService.ToolTip="排除后这张壁纸不再参与轮播">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE711;" FontSize="14"/>
                                    <TextBlock Text="排除当前"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="WpClearButton" Click="OnWpClearClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    <TextBlock Text="清空喜好"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="本地缓存" FontSize="15" Opacity="0.9"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="WpDownloadButton" Click="OnWpDownloadClick" ToolTipService.ToolTip="立即下载多张壁纸到本地缓存目录">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="14"/>
                                    <TextBlock Text="下载到本地"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="WpOpenFolderButton" Click="OnWpOpenFolderClick" ToolTipService.ToolTip="在资源管理器中打开壁纸缓存目录">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                    <TextBlock Text="打开文件夹"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="WpClearCacheButton" Click="OnWpClearCacheClick" ToolTipService.ToolTip="删除本地缓存的壁纸，之后会重新下载（收藏与排除名单保留）">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    <TextBlock Text="清除缓存"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="WpStatusText" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- 映射小组件：映射按键（仅映射编辑时显示） -->
                <StackPanel x:Name="MappingRow" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="映射按键" FontSize="15" Opacity="0.9"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MappingText" Grid.Column="0" VerticalAlignment="Center"
                                   FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Text="未设置"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="MappingCaptureButton" Click="OnMappingCaptureClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7FC;" FontSize="14"/>
                                    <TextBlock Text="捕获按键…"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="MappingKeyboardButton" Click="OnMappingKeyboardClick"
                                    ToolTipService.ToolTip="打开屏幕键盘，方便触屏输入">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE765;" FontSize="14"/>
                                    <TextBlock Text="显示键盘"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 修改器小组件：已下载的修改器（仅修改器编辑时显示）——一键打开存放目录 -->
                <StackPanel x:Name="TrainerRow" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="已下载修改器" FontSize="15" Opacity="0.9"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TrainerFolderText" Grid.Column="0" VerticalAlignment="Center"
                                   FontSize="14" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                   Text="未下载"/>
                        <Button x:Name="OpenTrainerFolderButton" Grid.Column="1" Margin="8,0,0,0"
                                Click="OnOpenTrainerFolderClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                <TextBlock Text="打开文件夹…"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

