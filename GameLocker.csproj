<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>GameLocker</AssemblyName>
    <Version>1.9.9</Version>
    <ApplicationIcon>Assets\GameLocker.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- dotnet CLI 构建时指向 VS BuildTools 的 AppxPackage 任务目录（生成 PRI 所需） -->
    <AppxMSBuildToolsPath Condition="Exists('C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\Microsoft.Build.AppxPackage.dll')">C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</AppxMSBuildToolsPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.422" />
    <PackageReference Include="SharpCompress" Version="0.39.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- 存档位置清单（ludusavi manifest）的流式 YAML 解析 -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <!-- 非打包应用的凭据保护（DPAPI），用于加密保存云端备份的 WebDAV 应用密码 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 运行时加载托盘/窗口图标所需 -->
    <Content Include="Assets\GameLocker.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- 关于页展示的软件图标（ms-appx:///Assets/GameLocker-256.png） -->
    <Content Include="Assets\GameLocker-256.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 手柄映射编辑器的手柄底图（ms-appx:///Assets/gamepad-base.png） -->
    <Content Include="Assets\gamepad-base.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- PawnIO：静默安装器（驱动缺失时由提权助手执行一次）与再分发许可文本，放到程序根目录便于查找 -->
    <Content Include="Resources\PawnIO_setup.exe" Link="PawnIO_setup.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\COPYING-PawnIO.txt" Link="COPYING-PawnIO.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- IntelMSR 签名模块（PawnIO 驱动校验签名后执行） -->
    <EmbeddedResource Include="Resources\IntelMSR.bin" />
    <!-- LpcACPIEC 签名模块：ACPI EC 端口访问，用于探测厂商 EC 里的 GPU 温度 -->
    <EmbeddedResource Include="Resources\LpcACPIEC.bin" />
    <!-- 屏幕键盘的中文拼音字典（音节 → 常用字，按频次排序） -->
    <EmbeddedResource Include="Resources\pinyin.tsv" />
    <!-- 屏幕键盘的双字词表（拼音 → 词语，按词频排序），用于提高两字词联想准确度 -->
    <EmbeddedResource Include="Resources\words.tsv" />
    <!-- 屏幕键盘的简拼表（首字母组合 → 词语，如 nh → 你好），支持只打声母联想 -->
    <EmbeddedResource Include="Resources\abbr.tsv" />
    <!-- 屏幕键盘的三字词表（如 shurufa → 输入法），只收最常用的 3 万词以控制体积 -->
    <EmbeddedResource Include="Resources\words3.tsv" />
    <!-- 屏幕键盘的五笔（86 版）码表（编码 → 候选字词，按字频排序） -->
    <EmbeddedResource Include="Resources\wubi.tsv" />
  </ItemGroup>

</Project>
