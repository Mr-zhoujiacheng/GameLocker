<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.KeybindPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:GameLocker.Controls"
    xmlns:local="using:GameLocker">

    <Page.Resources>
        <!-- 说明行模板：键帽徽章 + 触控说明 -->
        <DataTemplate x:Key="RowTpl" x:DataType="local:ControlRow">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="122"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1FFFFFFF" BorderBrush="#38FFFFFF"
                        BorderThickness="1,1,1,2" CornerRadius="6"
                        Padding="8,3" HorizontalAlignment="Stretch">
                    <TextBlock Text="{x:Bind Pad}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="#9ECBFF" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{x:Bind Touch}"
                           FontSize="13" Opacity="0.85" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>

        <!-- 说明列表样式：ListView 自带可见选中高亮，手柄/鼠标都能定位光标 -->
        <Style x:Key="RowListStyle" TargetType="ListView">
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsSwipeEnabled" Value="False"/>
            <Setter Property="ItemTemplate" Value="{StaticResource RowTpl}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="2,4"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent"
          RequestedTheme="Dark" XYFocusKeyboardNavigation="Enabled">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="20,16">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="BackButton" Background="Transparent" BorderThickness="0" Click="OnBackClick" IsTabStop="False">
                    <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                </Button>
                <TextBlock Text="控制" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="PageScroller" Grid.Row="1" Padding="20,4,20,12" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <!-- 呼出组合键 -->
                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                        CornerRadius="10" Padding="14,12">
                    <StackPanel Spacing="8">
                        <Border Background="#2A4C9AFF" CornerRadius="9" Padding="10,3" HorizontalAlignment="Left">
                            <TextBlock Text="组合键" FontSize="12" FontWeight="SemiBold" Foreground="#BBD8FF"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="CaptureButton" Click="OnCaptureClick">
                                <TextBlock x:Name="CaptureText" FontSize="14"/>
                            </Button>
                            <TextBlock Text="呼出窗口 · 按 A 或点击后按住组合键，松开即保存"
                                       FontSize="12" Opacity="0.55" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="FsCaptureButton" Click="OnFsCaptureClick">
                                <TextBlock x:Name="FsCaptureText" FontSize="14"/>
                            </Button>
                            <TextBlock Text="切换全屏 · 按 A 或点击后按住组合键，松开即保存"
                                       FontSize="12" Opacity="0.55" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 手柄 ↔ 触控对照：每个场景一张卡片，卡片内 ListView 提供可见选中高亮 -->
                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                        CornerRadius="10" Padding="14,12">
                    <StackPanel Spacing="8">
                        <Border Background="#2A4C9AFF" CornerRadius="9" Padding="10,3" HorizontalAlignment="Left">
                            <TextBlock Text="主页 / 磁贴集" FontSize="12" FontWeight="SemiBold" Foreground="#BBD8FF"/>
                        </Border>
                        <ListView x:Name="LvHome" Style="{StaticResource RowListStyle}"/>
                    </StackPanel>
                </Border>

                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                        CornerRadius="10" Padding="14,12">
                    <StackPanel Spacing="8">
                        <Border Background="#2A4C9AFF" CornerRadius="9" Padding="10,3" HorizontalAlignment="Left">
                            <TextBlock Text="编辑模式" FontSize="12" FontWeight="SemiBold" Foreground="#BBD8FF"/>
                        </Border>
                        <ListView x:Name="LvEdit" Style="{StaticResource RowListStyle}"/>
                    </StackPanel>
                </Border>

                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                        CornerRadius="10" Padding="14,12">
                    <StackPanel Spacing="8">
                        <Border Background="#2A4C9AFF" CornerRadius="9" Padding="10,3" HorizontalAlignment="Left">
                            <TextBlock Text="设置" FontSize="12" FontWeight="SemiBold" Foreground="#BBD8FF"/>
                        </Border>
                        <ListView x:Name="LvSettings" Style="{StaticResource RowListStyle}"/>
                    </StackPanel>
                </Border>

                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                        CornerRadius="10" Padding="14,12">
                    <StackPanel Spacing="8">
                        <Border Background="#2A4C9AFF" CornerRadius="9" Padding="10,3" HorizontalAlignment="Left">
                            <TextBlock Text="全局呼出" FontSize="12" FontWeight="SemiBold" Foreground="#BBD8FF"/>
                        </Border>
                        <ListView x:Name="LvGlobal" Style="{StaticResource RowListStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ctl:GamepadHintBar Grid.Row="2" Margin="0,8,0,12"
                            Hints="A:捕获键位|B:返回"/>
    </Grid>
</Page>
