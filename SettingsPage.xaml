<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.SettingsPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:GameLocker.Controls">

    <Grid Background="Transparent"
          RequestedTheme="Dark" XYFocusKeyboardNavigation="Enabled">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0" Padding="20,16">
            <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="BackButton" HorizontalAlignment="Right" VerticalAlignment="Center" IsTabStop="False"
                    Background="Transparent" BorderThickness="0" Click="OnBackClick">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- 分类入口列表 -->
        <ListView x:Name="CategoryList" Grid.Row="1" Padding="20,4" Margin="0,0,0,0"
                  SelectionMode="Single" IsTabStop="False">
            <ListViewItem Tapped="OnCategoryTapped">
                <StackPanel Orientation="Horizontal" Spacing="14" Padding="0,10">
                    <FontIcon Glyph="&#xE713;" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Spacing="2">
                        <TextBlock Text="常规" FontSize="17"/>
                        <TextBlock Text="开机自启 · 启动行为 · 停靠位置" FontSize="12" Opacity="0.6"/>
                    </StackPanel>
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tapped="OnCategoryTapped">
                <StackPanel Orientation="Horizontal" Spacing="14" Padding="0,10">
                    <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Spacing="2">
                        <TextBlock Text="外观" FontSize="17"/>
                        <TextBlock Text="玻璃效果 · 背景颜色 · 窗口透明度" FontSize="12" Opacity="0.6"/>
                    </StackPanel>
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tapped="OnCategoryTapped">
                <StackPanel Orientation="Horizontal" Spacing="14" Padding="0,10">
                    <FontIcon Glyph="&#xE917;" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Spacing="2">
                        <TextBlock Text="顶栏" FontSize="17"/>
                        <TextBlock Text="时钟 · 电池 · 网络 · 手柄图标显示" FontSize="12" Opacity="0.6"/>
                    </StackPanel>
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tapped="OnCategoryTapped">
                <StackPanel Orientation="Horizontal" Spacing="14" Padding="0,10">
                    <FontIcon Glyph="&#xE7FC;" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Spacing="2">
                        <TextBlock Text="控制" FontSize="17"/>
                        <TextBlock Text="呼出组合键 · 手柄/触控操作对照" FontSize="12" Opacity="0.6"/>
                    </StackPanel>
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tapped="OnCategoryTapped">
                <StackPanel Orientation="Horizontal" Spacing="14" Padding="0,10">
                    <FontIcon Glyph="&#xE946;" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Spacing="2">
                        <TextBlock Text="关于" FontSize="17"/>
                        <TextBlock Text="软件信息 · GitHub · QQ 群" FontSize="12" Opacity="0.6"/>
                    </StackPanel>
                </StackPanel>
            </ListViewItem>
        </ListView>

        <!-- 底部按键提示：手柄图标徽章，单行，透明背景 -->
        <ctl:GamepadHintBar Grid.Row="2" Margin="0,8,0,12"
                            Hints="DPAD:选择|A:进入|B:返回"/>
    </Grid>
</Page>
