<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.KeybindPage"
    IsTabStop="True"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:GameLocker.Controls"
    xmlns:local="using:GameLocker">

    <Page.Resources>
        <!-- 卡片：手柄焦点以"整张卡片"为一个选中框（代码里只改描边与底色），卡内内容只读 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#22FFFFFF" Offset="0"/>
                        <GradientStop Color="#33B7E6B0" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#3DFFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12,14,12"/>
        </Style>

        <!-- 卡片内的小徽标：给每一行键位一个图形锚点，卡片再多也能一眼区分 -->
        <Style x:Key="CardBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#33B7E6B0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#59B7E6B0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 键帽：手柄操作与触屏操作共用同款样式，保证两列外观完全一致 -->
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#26B7E6B0"/>
            <Setter Property="BorderBrush" Value="#4DB7E6B0"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="ChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 表头文字：与键帽同列对齐，用浅灰弱化字表示"列名"而非数据 -->
        <Style x:Key="HeadTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#C6EEC0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- 说明行，按「手柄操作 → 触屏操作 → 实际操作效果」排列；
             前两列同款键帽，效果列白字加粗并以 ▸ 标记突出 -->
        <DataTemplate x:Key="RowTpl" x:DataType="local:ControlRow">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="108"/>
                    <ColumnDefinition Width="108"/>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ChipStyle}">
                    <TextBlock Text="{x:Bind Pad}" Style="{StaticResource ChipTextStyle}"/>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ChipStyle}">
                    <TextBlock Text="{x:Bind Touch}" Style="{StaticResource ChipTextStyle}"/>
                </Border>

                <Grid Grid.Column="2" ColumnSpacing="7" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE76C;" FontSize="10" Foreground="#B7E6B0"
                              VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Effect}" FontSize="13.5"
                               FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- 说明列表只展示内容，不产生"行级选中"（手柄按卡片整体选择） -->
        <Style x:Key="RowListStyle" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource RowTpl}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="7"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分区标题徽标 -->
        <Style x:Key="SectionBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#33B7E6B0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#59B7E6B0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 键位捕获按钮：外形像一枚键帽，可点可按 A -->
        <Style x:Key="KeyCapStyle" TargetType="Button">
            <Setter Property="Background" Value="#26B7E6B0"/>
            <Setter Property="BorderBrush" Value="#59B7E6B0"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent"
          RequestedTheme="Dark" XYFocusKeyboardNavigation="Enabled">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 -->
        <Grid Grid.Row="0" Padding="20,16,20,10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="BackButton" Background="Transparent" BorderThickness="0" Click="OnBackClick" IsTabStop="False">
                    <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                </Button>
                <TextBlock Text="控制" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 内容区：每张卡片就是一个手柄选中框，方向键整卡上下切换 -->
        <ScrollViewer x:Name="PageScroller" Grid.Row="1" Padding="20,4,20,18" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- 一、快捷映射：只放三个键位捕获，和下方基本操作说明分开 -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                    <Border Style="{StaticResource SectionBadgeStyle}">
                        <FontIcon Glyph="&#xE7FC;" FontSize="14" Foreground="#FFDDF4D6"/>
                    </Border>
                    <TextBlock Text="快捷映射" Style="{StaticResource SectionTitleStyle}"/>
                </StackPanel>

                <!-- 四个键位各占一张卡，两列排布（窄窗口自动回成一列，见 LayoutCards） -->
                <Grid x:Name="MapGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 呼出窗口组合键 -->
                    <Border x:Name="CardSummon" Style="{StaticResource CardStyle}" Grid.Row="0" Grid.Column="0">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Style="{StaticResource CardBadgeStyle}">
                                    <FontIcon Glyph="&#xE7FC;" FontSize="11" Foreground="#FFDDF4D6"/>
                                </Border>
                                <TextBlock Text="呼出窗口" Style="{StaticResource CardTitleStyle}"/>
                            </StackPanel>
                            <Button x:Name="CaptureButton" Style="{StaticResource KeyCapStyle}"
                                    Click="OnCaptureClick" HorizontalAlignment="Left">
                                <TextBlock x:Name="CaptureText" FontSize="16" FontWeight="SemiBold" Foreground="#F0F0F0"/>
                            </Button>
                            <TextBlock Text="长按 1 秒呼出或收起启动器" Style="{StaticResource RowDescStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- 键盘呼出键（仅键盘，按下即刻呼出，无需长按） -->
                    <Border x:Name="CardKeySummon" Style="{StaticResource CardStyle}" Grid.Row="0" Grid.Column="1">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Style="{StaticResource CardBadgeStyle}">
                                    <FontIcon Glyph="&#xE765;" FontSize="11" Foreground="#FFDDF4D6"/>
                                </Border>
                                <TextBlock Text="键盘呼出键" Style="{StaticResource CardTitleStyle}"/>
                            </StackPanel>
                            <Button x:Name="KeyCaptureButton" Style="{StaticResource KeyCapStyle}"
                                    Click="OnKeyCaptureClick" HorizontalAlignment="Left">
                                <TextBlock x:Name="KeyCaptureText" FontSize="16" FontWeight="SemiBold" Foreground="#F0F0F0"/>
                            </Button>
                            <TextBlock Text="按下即刻呼出，可带 Ctrl / Shift / Alt / Win" Style="{StaticResource RowDescStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- 切换全屏组合键 -->
                    <Border x:Name="CardFullscreen" Style="{StaticResource CardStyle}" Grid.Row="1" Grid.Column="0">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Style="{StaticResource CardBadgeStyle}">
                                    <FontIcon Glyph="&#xE740;" FontSize="11" Foreground="#FFDDF4D6"/>
                                </Border>
                                <TextBlock Text="切换全屏" Style="{StaticResource CardTitleStyle}"/>
                            </StackPanel>
                            <Button x:Name="FsCaptureButton" Style="{StaticResource KeyCapStyle}"
                                    Click="OnFsCaptureClick" HorizontalAlignment="Left">
                                <TextBlock x:Name="FsCaptureText" FontSize="16" FontWeight="SemiBold" Foreground="#F0F0F0"/>
                            </Button>
                            <TextBlock Text="长按 1 秒在全屏与侧边栏之间切换" Style="{StaticResource RowDescStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- 恢复默认键位 -->
                    <Border x:Name="CardReset" Style="{StaticResource CardStyle}" Grid.Row="1" Grid.Column="1">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Style="{StaticResource CardBadgeStyle}">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="11" Foreground="#FFDDF4D6"/>
                                </Border>
                                <TextBlock Text="恢复默认" Style="{StaticResource CardTitleStyle}"/>
                            </StackPanel>
                            <Button x:Name="ResetButton" Content="恢复默认键位" Style="{StaticResource KeyCapStyle}"
                                    Click="OnResetClick" HorizontalAlignment="Left"
                                    FontSize="14" Foreground="#F0F0F0"/>
                            <TextBlock Text="呼出键、键盘呼出键、全屏键都还原为初始值" Style="{StaticResource RowDescStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 分隔：快捷映射 / 基本操作 -->
                <Border Height="1" Background="#1FB7E6B0" Margin="0,6"/>

                <!-- 二、基本操作：只列通用操作，不细分到每个页面 -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                    <Border Style="{StaticResource SectionBadgeStyle}">
                        <FontIcon Glyph="&#xE71D;" FontSize="14" Foreground="#FFDDF4D6"/>
                    </Border>
                    <TextBlock Text="基本操作" Style="{StaticResource SectionTitleStyle}"/>
                </StackPanel>

                <Border x:Name="CardBasic" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <!-- 表头行：列宽与下方键帽行严格一致，读起来就是表格的列名 -->
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="手柄操作" Style="{StaticResource HeadTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="触屏操作" Style="{StaticResource HeadTextStyle}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="#B7E6B0"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="实际操作效果" Style="{StaticResource HeadTextStyle}"
                                               HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="#1FFFFFFF"/>
                        </StackPanel>

                        <ItemsControl x:Name="LvBasic" Style="{StaticResource RowListStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ctl:GamepadHintBar Grid.Row="2" Margin="0,8,0,12"
                            Hints="DPAD:切换|A:捕获/恢复|B:返回"/>
    </Grid>
</Page>
