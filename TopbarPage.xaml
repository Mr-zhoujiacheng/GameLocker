<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.TopbarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:GameLocker.Controls">

    <Page.Resources>
        <!-- 开关行卡片：直角 + 浅蓝渐变底；选中时由代码改 BorderBrush 画白框 -->
        <Style x:Key="SettingRowStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
        <!-- 开关本体：自绘胶囊（隐去 On/Off 文字与多余留白），随 IsOn 变色、滑块滑动 -->
        <Style x:Key="CleanToggleStyle" TargetType="ToggleSwitch">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleSwitch">
                        <Grid Width="44" Height="22" Background="Transparent">
                            <Border Width="40" Height="20" CornerRadius="10" Background="#2AFFFFFF"
                                    BorderThickness="1" BorderBrush="#4DFFFFFF"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="Fill" Width="40" Height="20" CornerRadius="10" Background="#C64CC2FF"
                                    Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#FFFFFF"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <CompositeTransform/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="ToggleStates">
                                    <VisualState x:Name="Off">
                                        <VisualState.Setters>
                                            <Setter Target="Knob.Fill" Value="#FFFFFF"/>
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                                                             To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="On">
                                        <VisualState.Setters>
                                            <Setter Target="Knob.Fill" Value="#1F1F1F"/>
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                                                             To="20" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 顶栏状态图标：与主页顶栏同一套（46×46 独立圆角气泡，整组再套一枚大圆角玻璃框） -->
        <Style x:Key="StatusBubbleStyle" TargetType="Border">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent"
          RequestedTheme="Dark" XYFocusKeyboardNavigation="Enabled">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ctl:SettingsHeader Grid.Row="0" Title="顶栏" Subtitle="TOP BAR"/>

        <!-- 内容区可滚动：窄窗口下控件不被遮盖。
             预览条与开关卡同属一个内容块，宽度一致、一起居中/靠上，并与开关紧挨着显示 -->
        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="20,8,20,10" VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="ContentStack" Spacing="12" VerticalAlignment="Top">

                <!-- 顶栏预览：按当前开关实时演示主页顶栏的样子（拨动下面的开关即刻生效） -->
                <StackPanel x:Name="PreviewBlock" Spacing="6">
                    <TextBlock Text="顶栏预览" FontSize="11.5" Opacity="0.55"/>
                    <Border Padding="14,10" CornerRadius="12" Background="#14FFFFFF"
                            BorderBrush="#1FFFFFFF" BorderThickness="1" MinHeight="58">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左：时钟（与主页顶栏同一套：2px 渐隐竖线 + 字距微调） -->
                            <Grid x:Name="PreviewClock" Grid.Column="0" ColumnSpacing="8" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="2" Height="26" VerticalAlignment="Center" CornerRadius="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#8C4CC2FF" Offset="0"/>
                                            <GradientStop Color="#004CC2FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="0">
                                    <TextBlock x:Name="PreviewClockText" Text="--:--" FontSize="26" FontWeight="SemiBold"
                                               CharacterSpacing="25"/>
                                    <TextBlock x:Name="PreviewDateText" Text="" FontSize="11.5" Opacity="0.65"
                                               CharacterSpacing="30"/>
                                </StackPanel>
                            </Grid>

                            <!-- 全部关闭时的占位提示 -->
                            <TextBlock x:Name="PreviewEmpty" Grid.Column="0" Text="顶栏图标已全部关闭"
                                       FontSize="12" Opacity="0.4" VerticalAlignment="Center" Visibility="Collapsed"/>

                            <!-- 右：状态图标（收在一枚大圆角玻璃框里，与主页一致） -->
                            <Border x:Name="PreviewTray" Grid.Column="1" CornerRadius="24" Padding="6" BorderThickness="1"
                                    Background="#12FFFFFF" BorderBrush="#33FFFFFF" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <!-- 搜索固定在最左，与主页顶栏一致 -->
                                    <Border x:Name="PreviewSearchBubble" Style="{StaticResource StatusBubbleStyle}">
                                        <Grid Width="24" Height="24">
                                            <Path Stroke="#FFFFFFFF" StrokeThickness="2.8"
                                                  Data="M10.4,5.2 A5.2,5.2 0 1,1 10.4,15.6 A5.2,5.2 0 1,1 10.4,5.2 Z"/>
                                            <Path Stroke="#FFFFFFFF" StrokeThickness="2.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M14.6,14.6 L19.4,19.4"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="PreviewWifiBubble" Style="{StaticResource StatusBubbleStyle}">
                                        <FontIcon x:Name="PreviewWifiIcon" Glyph="&#xE701;" FontSize="26"/>
                                    </Border>
                                    <Border x:Name="PreviewBluetoothBubble" Style="{StaticResource StatusBubbleStyle}">
                                        <FontIcon x:Name="PreviewBluetoothIcon" Glyph="&#xE702;" FontSize="26"/>
                                    </Border>
                                    <Border x:Name="PreviewBatteryBubble" Style="{StaticResource StatusBubbleStyle}">
                                        <FontIcon x:Name="PreviewBatteryIcon" Glyph="&#xE850;" FontSize="26"/>
                                    </Border>
                                    <Border x:Name="PreviewGamepadBubble" Style="{StaticResource StatusBubbleStyle}">
                                        <FontIcon x:Name="PreviewGamepadIcon" Glyph="&#xE7FC;" FontSize="26"/>
                                    </Border>
                                    <!-- 夜间模式：太阳/月亮随当前开关状态切换 -->
                                    <Border x:Name="PreviewNightBubble" Style="{StaticResource StatusBubbleStyle}">
                                        <Grid Width="24" Height="24">
                                            <Path x:Name="PreviewSunIcon" Stroke="#FFB9BEC6" StrokeThickness="2.6"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Data="M12,8.1 A3.9,3.9 0 1,1 12,15.9 A3.9,3.9 0 1,1 12,8.1 Z
                                                        M12,3.2 V4.9 M12,19.1 V20.8 M3.2,12 H4.9 M19.1,12 H20.8
                                                        M5.8,5.8 L7,7 M17,17 L18.2,18.2
                                                        M18.2,5.8 L17,7 M7,17 L5.8,18.2"/>
                                            <Path x:Name="PreviewMoonIcon" Fill="#FFFFB86B" Visibility="Collapsed"
                                                  Data="M14.9,3.5 A8.9,8.9 0 1,0 20.5,14.4 A7.2,7.2 0 0,1 14.9,3.5 Z"/>
                                        </Grid>
                                    </Border>
                                    <!-- 通知固定在最右 -->
                                    <Border x:Name="PreviewNotificationBubble" Style="{StaticResource StatusBubbleStyle}">
                                        <FontIcon x:Name="PreviewNotificationIcon" Glyph="&#xEA8F;" FontSize="26"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid x:Name="SwitchGrid" ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 时钟 -->
                <Button x:Name="ClockRow" Style="{StaticResource SettingRowStyle}" Click="OnRowClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#4A4CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="40" Background="#B34CC2FF" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="34" Height="34" Background="#3D4CC2FF"
                                BorderThickness="1" BorderBrush="#6B4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE823;" FontSize="16"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="时钟" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="顶栏左侧显示当前时间与日期" FontSize="11.5"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="ClockToggle" Grid.Column="3" Style="{StaticResource CleanToggleStyle}"
                                      IsHitTestVisible="False" IsTabStop="False" VerticalAlignment="Center"
                                      OnContent="" OffContent=""
                                      Toggled="OnToggleChanged"/>
                    </Grid>
                </Button>

                <!-- 电池 -->
                <Button x:Name="BatteryRow" Style="{StaticResource SettingRowStyle}" Click="OnRowClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#4A4CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="40" Background="#B34CC2FF" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="34" Height="34" Background="#3D4CC2FF"
                                BorderThickness="1" BorderBrush="#6B4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE850;" FontSize="16"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="电池" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="顶栏右侧按格显示电量，颜色随电量变化" FontSize="11.5"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="BatteryToggle" Grid.Column="3" Style="{StaticResource CleanToggleStyle}"
                                      IsHitTestVisible="False" IsTabStop="False" VerticalAlignment="Center"
                                      OnContent="" OffContent=""
                                      Toggled="OnToggleChanged"/>
                    </Grid>
                </Button>

                <!-- 无线网络 -->
                <Button x:Name="WifiRow" Style="{StaticResource SettingRowStyle}" Click="OnRowClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#4A4CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="40" Background="#B34CC2FF" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="34" Height="34" Background="#3D4CC2FF"
                                BorderThickness="1" BorderBrush="#6B4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE701;" FontSize="16"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="无线网络" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="顶栏右侧显示 Wi-Fi 状态，绿=已连接" FontSize="11.5"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="WifiToggle" Grid.Column="3" Style="{StaticResource CleanToggleStyle}"
                                      IsHitTestVisible="False" IsTabStop="False" VerticalAlignment="Center"
                                      OnContent="" OffContent=""
                                      Toggled="OnToggleChanged"/>
                    </Grid>
                </Button>

                <!-- 蓝牙 -->
                <Button x:Name="BluetoothRow" Style="{StaticResource SettingRowStyle}" Click="OnRowClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#4A4CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="40" Background="#B34CC2FF" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="34" Height="34" Background="#3D4CC2FF"
                                BorderThickness="1" BorderBrush="#6B4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE702;" FontSize="16"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="蓝牙" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="顶栏右侧显示蓝牙状态，绿=已连接" FontSize="11.5"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="BluetoothToggle" Grid.Column="3" Style="{StaticResource CleanToggleStyle}"
                                      IsHitTestVisible="False" IsTabStop="False" VerticalAlignment="Center"
                                      OnContent="" OffContent=""
                                      Toggled="OnToggleChanged"/>
                    </Grid>
                </Button>

                <!-- 手柄 -->
                <Button x:Name="GamepadRow" Style="{StaticResource SettingRowStyle}" Click="OnRowClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#4A4CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="40" Background="#B34CC2FF" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="34" Height="34" Background="#3D4CC2FF"
                                BorderThickness="1" BorderBrush="#6B4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7FC;" FontSize="16"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="手柄" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="顶栏右侧显示手柄连接状态，绿=已连接" FontSize="11.5"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="GamepadIconToggle" Grid.Column="3" Style="{StaticResource CleanToggleStyle}"
                                      IsHitTestVisible="False" IsTabStop="False" VerticalAlignment="Center"
                                      OnContent="" OffContent=""
                                      Toggled="OnToggleChanged"/>
                    </Grid>
                </Button>

                <!-- 通知 -->
                <Button x:Name="NotificationRow" Style="{StaticResource SettingRowStyle}" Click="OnRowClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#4A4CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="40" Background="#B34CC2FF" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="34" Height="34" Background="#3D4CC2FF"
                                BorderThickness="1" BorderBrush="#6B4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEA8F;" FontSize="16"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="通知" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="点击打开通知中心，有新通知时右上角亮绿点" FontSize="11.5"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="NotificationToggle" Grid.Column="3" Style="{StaticResource CleanToggleStyle}"
                                      IsHitTestVisible="False" IsTabStop="False" VerticalAlignment="Center"
                                      OnContent="" OffContent=""
                                      Toggled="OnToggleChanged"/>
                    </Grid>
                </Button>

                <!-- 夜间模式 -->
                <Button x:Name="NightLightRow" Style="{StaticResource SettingRowStyle}" Click="OnRowClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#4A4CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="40" Background="#B34CC2FF" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="34" Height="34" Background="#3D4CC2FF"
                                BorderThickness="1" BorderBrush="#6B4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE708;" FontSize="16"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="夜间模式" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="顶栏显示夜间模式图标，点击切换暖色滤镜" FontSize="11.5"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="NightLightToggle" Grid.Column="3" Style="{StaticResource CleanToggleStyle}"
                                      IsHitTestVisible="False" IsTabStop="False" VerticalAlignment="Center"
                                      OnContent="" OffContent=""
                                      Toggled="OnToggleChanged"/>
                    </Grid>
                </Button>

                <!-- 搜索 -->
                <Button x:Name="SearchRow" Style="{StaticResource SettingRowStyle}" Click="OnRowClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#4A4CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="3" Height="40" Background="#B34CC2FF" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="34" Height="34" Background="#3D4CC2FF"
                                BorderThickness="1" BorderBrush="#6B4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE721;" FontSize="16"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="搜索" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="顶栏最左侧的搜索图标，点击打开搜索浮层" FontSize="11.5"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="SearchToggle" Grid.Column="3" Style="{StaticResource CleanToggleStyle}"
                                      IsHitTestVisible="False" IsTabStop="False" VerticalAlignment="Center"
                                      OnContent="" OffContent=""
                                      Toggled="OnToggleChanged"/>
                    </Grid>
                </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 悬浮放大的按键提示：浮在内容之上，不占布局行（与主页一致） -->
        <Border Grid.Row="0" Grid.RowSpan="99"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,14,20,0" Padding="14,9" CornerRadius="12"
                Background="#26000000">
            <ctl:GamepadHintBar BadgeScale="1"
                                Hints="DPAD:选择|A:切换|B:返回"/>
        </Border>
    </Grid>
</Page>
