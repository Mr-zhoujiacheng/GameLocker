<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:GameLocker.Controls">

    <Grid Background="Transparent"
          RequestedTheme="Dark" XYFocusKeyboardNavigation="Enabled">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="20,16">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="BackButton" Background="Transparent" BorderThickness="0" Click="OnBackClick" IsTabStop="False">
                    <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                </Button>
                <TextBlock Text="常规" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 内容区可滚动：窄窗口下控件不被遮盖 -->
        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="24,8" VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="20">
                <ToggleSwitch x:Name="AutoStartToggle" Padding="14,10" Toggled="OnToggleChanged">
                    <ToggleSwitch.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="自启动" FontSize="16"/>
                            <TextBlock Text="开机后自动运行 Game Locker" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </ToggleSwitch.Header>
                </ToggleSwitch>
                <ToggleSwitch x:Name="HideAfterLaunchToggle" Padding="14,10" Toggled="OnToggleChanged">
                    <ToggleSwitch.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="启动后隐藏" FontSize="16"/>
                            <TextBlock Text="启动程序后自动隐藏窗口到托盘" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </ToggleSwitch.Header>
                </ToggleSwitch>
                <ToggleSwitch x:Name="StartFullscreenToggle" Padding="14,10" Toggled="OnToggleChanged">
                    <ToggleSwitch.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="启动全屏" FontSize="16"/>
                            <TextBlock Text="运行时直接进入全屏模式而非侧边栏" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </ToggleSwitch.Header>
                </ToggleSwitch>
                <ToggleSwitch x:Name="AnimationToggle" Padding="14,10" Toggled="OnToggleChanged">
                    <ToggleSwitch.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="弹出动画" FontSize="16"/>
                            <TextBlock Text="呼出/隐藏时窗口滑入滑出过渡效果" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </ToggleSwitch.Header>
                </ToggleSwitch>
                <ToggleSwitch x:Name="EdgeGestureToggle" Padding="14,10" Toggled="OnEdgeGestureChanged">
                    <ToggleSwitch.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="边缘手势呼出" FontSize="16"/>
                            <TextBlock Text="从屏幕边缘向中心滑动唤起（左/右停靠对应左右边缘，全屏对应上边缘）" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </ToggleSwitch.Header>
                </ToggleSwitch>

                <ToggleSwitch x:Name="TabletModeToggle" Padding="14,10" Toggled="OnTabletModeChanged">
                    <ToggleSwitch.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="平板模式" FontSize="16"/>
                            <TextBlock Text="隐藏所有页面底部的手柄按键提示条" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </ToggleSwitch.Header>
                </ToggleSwitch>

                <TextBlock Text="窗口位置" FontSize="15" Opacity="0.9"/>
                <TextBlock Text="居中时窗口不贴屏幕四边，边缘手势从顶边呼出；宽度按外观页的比例放大（38% ≈ 70% 屏宽）" FontSize="12" Opacity="0.6"/>
                <!-- 三列并排显式 Grid（勿用 RadioButtons 容器，坐标不可靠）：手柄行感知导航左右跨列 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="LeftRadio" Grid.Column="0" GroupName="DockSide"
                                 Content="左侧" Padding="14,10" Margin="2" Checked="OnSideChanged"/>
                    <RadioButton x:Name="CenterRadio" Grid.Column="1" GroupName="DockSide"
                                 Content="居中" Padding="14,10" Margin="2" Checked="OnSideChanged"/>
                    <RadioButton x:Name="RightRadio" Grid.Column="2" GroupName="DockSide"
                                 Content="右侧" Padding="14,10" Margin="2" Checked="OnSideChanged"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <ctl:GamepadHintBar x:Name="HintBar" Grid.Row="2" Margin="0,8,0,12"
                            Hints="DPAD:选择|A:切换|B:返回"/>
    </Grid>
</Page>
