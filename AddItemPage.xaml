<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.AddItemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameLocker"
    xmlns:ctl="using:GameLocker.Controls">

    <Page.Resources>
        <!-- 页脚保存按钮：透明底 + 浅蓝强调色内容，悬停/按下/焦点只用极淡白叠加，
             避免实心色块与半透明背景割裂（与本页其他控件、KeybindPage 卡片同款语言） -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BBD8FF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="Overlay" Background="Transparent"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter x:Name="Presenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Overlay.Background" Value="#0FFFFFFF"/>
                                            <Setter Target="Overlay.BorderBrush" Value="#4C9AFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Overlay.Background" Value="#1FFFFFFF"/>
                                            <Setter Target="Overlay.BorderBrush" Value="#4C9AFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="Overlay.BorderBrush" Value="#BBD8FF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 手柄映射编辑面板·输出类型三选一：胶囊分段样式（未选=半透明白描边，选中=淡蓝底+浅蓝描边+白字）。
             两个描边元素分工：CursorRing 绑定控件本地 BorderBrush（手柄光标白色高亮），
             StateRing 表达选中/键盘焦点态——VisualState 的 Setter 优先级高于本地值，
             若两者共用一个 Border，手柄光标就会被选中态覆盖而看不见（用户实测）。 -->
        <Style x:Key="ChipRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="Foreground" Value="#E6EEF9"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <!-- 选中/键盘焦点描边（淡蓝），与光标描边互不覆盖 -->
                            <Border x:Name="StateRing" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="1.5"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter x:Name="Presenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- 光标描边：只跟控件本地 BorderBrush 走（任何 VisualState 都不改它），
                                 且画在最上层，选中态也不会把光标白框盖掉 -->
                            <Border x:Name="CursorRing"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#1AFFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#26FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked"/>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#332E6BE6"/>
                                            <Setter Target="StateRing.BorderBrush" Value="#BBD8FF"/>
                                            <Setter Target="Presenter.Foreground" Value="#FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="StateRing.BorderBrush" Value="#BBD8FF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 系统小组件编辑·显示项目：图标 + 名称胶囊。
             选中/未选的视觉（底色、文字色、右侧勾/叉图标）全部由代码 ApplySysChipVisual 直接设置：
             该自定义模板下 VisualState 的 Setter 实测不生效（IsChecked 已翻转但界面无变化），故不走 VisualState。
             光标描边单独一层，只跟控件本地 BorderBrush 走，不会和选中态互相覆盖。 -->
        <Style x:Key="SysOptionChipStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="Foreground" Value="#E6EEF9"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter x:Name="Presenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                            <!-- 光标描边：只跟控件本地 BorderBrush 走（任何状态都不改它），画在最上层 -->
                            <Border x:Name="CursorRing"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 手柄映射编辑面板·次操作（删除映射）：透明底 + 柔红描边 -->
        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFC9BE"/>
            <Setter Property="BorderBrush" Value="#3DFF8A7A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="Overlay" Background="Transparent"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Overlay.Background" Value="#14FFFFFF"/>
                                            <Setter Target="Overlay.BorderBrush" Value="#BBD8FF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Overlay.Background" Value="#22FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.35"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="Overlay.BorderBrush" Value="#BBD8FF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 手柄映射编辑面板·主操作（设置/切换输出目标）：实心强调蓝 -->
        <Style x:Key="ChipPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E6BE6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#3D7BF2"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#2459C4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.35"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.85"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent"
          RequestedTheme="Dark">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>  <!-- 页脚固定操作栏：保存 -->
            <RowDefinition Height="Auto"/>  <!-- 底部按键提示 -->
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + 返回 -->
        <Grid Grid.Row="0" Padding="20,16">
            <TextBlock x:Name="PageTitle" Text="添加快捷项" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="BackButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Click="OnBackClick">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- 表单状态（ScrollViewer 包裹：窄窗口下内容超出可滚动，控件不被遮盖）；
             内容放进一层 FormHost 里，由 AddItemPage.LayoutForm() 把它的宽度设为视口宽、表单限宽居中，
             这样在侧边栏 / 全屏 / 居中三种模式下排版一致（自动跟随窗口宽度变化） -->
        <ScrollViewer x:Name="FormScroll" Grid.Row="1" Padding="24,8"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollMode="Auto" HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Hidden">
            <Grid x:Name="FormHost">
                <!-- 表单内容限宽居中：窗口变宽（全屏/居中模式）时保持与侧边栏下一致的排版 -->
                <StackPanel x:Name="FormPanel" Spacing="12" HorizontalAlignment="Center">
                <TextBox x:Name="NameBox" Header="显示名称" PlaceholderText="例如：Steam"/>
                <Grid x:Name="TargetRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetBox" Grid.Column="0" Header="程序路径 / URL"
                             PlaceholderText="C:\...\game.exe 或 https://..." VerticalAlignment="Bottom"/>
                    <Button x:Name="BrowseButton" Grid.Column="1" Margin="8,24,0,0"
                            VerticalAlignment="Bottom" Click="OnBrowseClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE838;" FontSize="14"/>
                            <TextBlock Text="浏览…"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 图片组定向文件夹（仅图片组编辑时显示） -->
                <StackPanel x:Name="PhotoFolderRow" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="图片文件夹" FontSize="15" Opacity="0.9"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PhotoFolderText" Grid.Column="0" VerticalAlignment="Center"
                                   FontSize="14" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                   Text="未选择"/>
                        <Button x:Name="PhotoFolderButton" Grid.Column="1" Margin="8,0,0,0"
                                Click="OnPhotoFolderClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                <TextBlock Text="选择文件夹…"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- 图片组设置：轮播速度 / 切换动画 / 展示模式（仅图片组编辑时显示） -->
                <StackPanel x:Name="PhotoSettingsPanel" Spacing="14" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="轮播速度" FontSize="17" FontWeight="Bold" Opacity="0.95"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton x:Name="SpeedFastRadio" Content="快 · 30秒" GroupName="PhotoSpeed" Padding="14,10" IsChecked="True"/>
                            <RadioButton x:Name="SpeedSlowRadio" Content="慢 · 3分钟" GroupName="PhotoSpeed" Padding="14,10"/>
                            <RadioButton x:Name="SpeedArtRadio" Content="艺术 · 30分钟" GroupName="PhotoSpeed" Padding="14,10"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="切换动画" FontSize="17" FontWeight="Bold" Opacity="0.95" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="AnimationToggle" OnContent="开" OffContent="关"/>
                    </StackPanel>
                </StackPanel>

                <!-- 映射小组件：映射按键（仅映射编辑时显示） -->
                <StackPanel x:Name="MappingRow" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="映射按键" FontSize="15" Opacity="0.9"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MappingText" Grid.Column="0" VerticalAlignment="Center"
                                   FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Text="未设置"/>
                        <Button x:Name="MappingCaptureButton" Grid.Column="1" Margin="8,0,0,0"
                                Click="OnMappingCaptureClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7FC;" FontSize="14"/>
                                <TextBlock Text="捕获按键…"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- 修改器小组件：已下载的修改器（仅修改器编辑时显示）——一键打开存放目录 -->
                <StackPanel x:Name="TrainerRow" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="已下载修改器" FontSize="15" Opacity="0.9"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TrainerFolderText" Grid.Column="0" VerticalAlignment="Center"
                                   FontSize="14" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                   Text="未下载"/>
                        <Button x:Name="OpenTrainerFolderButton" Grid.Column="1" Margin="8,0,0,0"
                                Click="OnOpenTrainerFolderClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                <TextBlock Text="打开文件夹…"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- 性能监控小组件：悬浮条位置（小图示六选一）/ 大小 / 透明度（仅监控编辑时显示） -->
                <StackPanel x:Name="MonitorRow" Spacing="14" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="监控条位置" FontSize="17" FontWeight="Bold" Opacity="0.95"/>
                        <TextBlock Text="点选小图示选择悬浮条贴在屏幕的哪个角或边" FontSize="12"
                                   Opacity="0.6" TextWrapping="Wrap"/>
                        <Grid HorizontalAlignment="Left" Margin="0,2,0,0"
                              ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <RadioButton x:Name="MonPosTopLeft" Grid.Row="0" Grid.Column="0" GroupName="MonitorPos"
                                         Padding="6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="左上">
                                <Border Width="52" Height="34" CornerRadius="5" Background="#22000000"
                                        BorderBrush="#66FFFFFF" BorderThickness="1">
                                    <Border Width="20" Height="5" CornerRadius="2.5" Background="#FF2E6BE6"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3"/>
                                </Border>
                            </RadioButton>
                            <RadioButton x:Name="MonPosTopCenter" Grid.Row="0" Grid.Column="1" GroupName="MonitorPos"
                                         Padding="6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="上居中">
                                <Border Width="52" Height="34" CornerRadius="5" Background="#22000000"
                                        BorderBrush="#66FFFFFF" BorderThickness="1">
                                    <Border Width="20" Height="5" CornerRadius="2.5" Background="#FF2E6BE6"
                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                </Border>
                            </RadioButton>
                            <RadioButton x:Name="MonPosTopRight" Grid.Row="0" Grid.Column="2" GroupName="MonitorPos"
                                         Padding="6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="右上">
                                <Border Width="52" Height="34" CornerRadius="5" Background="#22000000"
                                        BorderBrush="#66FFFFFF" BorderThickness="1">
                                    <Border Width="20" Height="5" CornerRadius="2.5" Background="#FF2E6BE6"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"/>
                                </Border>
                            </RadioButton>

                            <RadioButton x:Name="MonPosBottomLeft" Grid.Row="1" Grid.Column="0" GroupName="MonitorPos"
                                         Padding="6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="左下">
                                <Border Width="52" Height="34" CornerRadius="5" Background="#22000000"
                                        BorderBrush="#66FFFFFF" BorderThickness="1">
                                    <Border Width="20" Height="5" CornerRadius="2.5" Background="#FF2E6BE6"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,0,0,3"/>
                                </Border>
                            </RadioButton>
                            <RadioButton x:Name="MonPosBottomCenter" Grid.Row="1" Grid.Column="1" GroupName="MonitorPos"
                                         Padding="6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="下居中">
                                <Border Width="52" Height="34" CornerRadius="5" Background="#22000000"
                                        BorderBrush="#66FFFFFF" BorderThickness="1">
                                    <Border Width="20" Height="5" CornerRadius="2.5" Background="#FF2E6BE6"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                </Border>
                            </RadioButton>
                            <RadioButton x:Name="MonPosBottomRight" Grid.Row="1" Grid.Column="2" GroupName="MonitorPos"
                                         Padding="6" MinWidth="0" MinHeight="0" ToolTipService.ToolTip="右下">
                                <Border Width="52" Height="34" CornerRadius="5" Background="#22000000"
                                        BorderBrush="#66FFFFFF" BorderThickness="1">
                                    <Border Width="20" Height="5" CornerRadius="2.5" Background="#FF2E6BE6"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"/>
                                </Border>
                            </RadioButton>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="监控条大小" FontSize="17" FontWeight="Bold" Opacity="0.95"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton x:Name="MonSizeSmall" Content="小" GroupName="MonitorSize" Padding="14,10"/>
                            <RadioButton x:Name="MonSizeNormal" Content="标准" GroupName="MonitorSize" Padding="14,10"
                                         IsChecked="True"/>
                            <RadioButton x:Name="MonSizeLarge" Content="大" GroupName="MonitorSize" Padding="14,10"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="监控条不透明度" FontSize="17" FontWeight="Bold" Opacity="0.95"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton x:Name="MonOpaque100" Content="100%" GroupName="MonitorOpacity" Padding="14,10"
                                         IsChecked="True"/>
                            <RadioButton x:Name="MonOpaque50" Content="50%" GroupName="MonitorOpacity" Padding="14,10"/>
                            <RadioButton x:Name="MonOpaque0" Content="0%（无外框）" GroupName="MonitorOpacity" Padding="14,10"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 文件传输小组件：可发送目录 / 接收目录（仅文件传输编辑时显示；留空=系统下载文件夹） -->
                <StackPanel x:Name="FileTransferRow" Spacing="14" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="可发送目录" FontSize="15" Opacity="0.9"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FtSendFolderText" Grid.Column="0" VerticalAlignment="Center"
                                       FontSize="14" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                       Text="未设置（默认：下载文件夹）"/>
                            <Button x:Name="FtSendFolderButton" Grid.Column="1" Margin="8,0,0,0"
                                    Click="OnFtSendFolderClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                    <TextBlock Text="选择文件夹…"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="接收目录" FontSize="15" Opacity="0.9"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FtRecvFolderText" Grid.Column="0" VerticalAlignment="Center"
                                       FontSize="14" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                       Text="未设置（默认：下载文件夹）"/>
                            <Button x:Name="FtRecvFolderButton" Grid.Column="1" Margin="8,0,0,0"
                                    Click="OnFtRecvFolderClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                    <TextBlock Text="选择文件夹…"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="两台设备都装了这个软件并打开「文件传输」浮层，即可在同一局域网内互相搜索与发送；收到的文件会直接存进上面的接收目录，重名自动追加 (1)。"
                               FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 游戏存档小组件：备份方式（本地目录 / 云端 WebDAV 上传）/ 目标文件夹 / 保留份数（仅游戏存档编辑时显示） -->
                <StackPanel x:Name="BackupRow" Spacing="14" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="备份方式" FontSize="17" FontWeight="Bold" Opacity="0.95"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton x:Name="BackupLocalRadio" Content="本地" GroupName="BackupMode" Padding="14,10"
                                         IsChecked="True" Checked="OnBackupModeChanged"/>
                            <RadioButton x:Name="BackupCloudRadio" Content="云端" GroupName="BackupMode" Padding="14,10"
                                         Checked="OnBackupModeChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 本地：备份文件夹 + 打开目录 -->
                    <StackPanel x:Name="BackupLocalPanel" Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="备份文件夹" FontSize="15" Opacity="0.9"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="BackupFolderText" Grid.Column="0" VerticalAlignment="Center"
                                           FontSize="14" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                           Text="默认目录"/>
                                <Button x:Name="BackupFolderButton" Grid.Column="1" Margin="8,0,0,0"
                                        Click="OnBackupFolderClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                        <TextBlock Text="选择文件夹…"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <Button x:Name="OpenBackupFolderButton" HorizontalAlignment="Left" Click="OnOpenBackupFolderClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                <TextBlock Text="打开备份目录…"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 云端：WebDAV 上传到网盘（默认坚果云），账号在「设置 → 云端备份」里配置（默认折叠，选「云端」时展开） -->
                    <StackPanel x:Name="BackupCloudPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="云端存档" FontSize="15" Opacity="0.9"/>
                        <TextBlock x:Name="CloudStateText" FontSize="14" Opacity="0.8" Text="未配置"/>
                        <Button x:Name="CloudSettingsButton" HorizontalAlignment="Left" Click="OnCloudSettingsClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE713;" FontSize="14"/>
                                <TextBlock Text="打开云端备份设置"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="CloudHintText" FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                                   Text="备份会通过 WebDAV 上传到你的网盘；请先在「设置 → 云端备份」填写地址、账号与应用密码。"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="保留份数" FontSize="15" Opacity="0.9"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton x:Name="Keep3Radio" Content="3 份" GroupName="BackupKeep" Padding="14,10"/>
                            <RadioButton x:Name="Keep5Radio" Content="5 份" GroupName="BackupKeep" Padding="14,10" IsChecked="True"/>
                            <RadioButton x:Name="Keep10Radio" Content="10 份" GroupName="BackupKeep" Padding="14,10"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 手柄映射小组件：可视化手柄（仅手柄映射编辑时显示）：点击图上按键 → 设置该键的输出（键盘/鼠标/手柄） -->
                <StackPanel x:Name="GamepadMapRow" Spacing="10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7FC;" FontSize="16" Foreground="#BBD8FF" VerticalAlignment="Center"/>
                        <TextBlock Text="手柄映射" FontSize="17" FontWeight="Bold" Opacity="0.95" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 用法说明：要点分行（小圆点导引），替代原先的一整段折行文字 -->
                    <Border Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                            CornerRadius="10" Padding="14,12">
                        <StackPanel Spacing="7">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Border Width="4" Height="4" CornerRadius="2" Background="#8FA3BF" VerticalAlignment="Center"/>
                                <TextBlock Text="点击手柄图上的按键，为它选择目标输出" FontSize="12" Opacity="0.85"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Border Width="4" Height="4" CornerRadius="2" Background="#8FA3BF" VerticalAlignment="Center"/>
                                <TextBlock Text="A / 点击磁贴 = 开启或关闭映射，长按 = 关闭" FontSize="12" Opacity="0.85"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Border Width="4" Height="4" CornerRadius="2" Background="#8FA3BF" VerticalAlignment="Center"/>
                                <TextBlock Text="手柄输出仅在本启动器内生效" FontSize="12" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 手柄图画布：尺寸与 Assets/gamepad-base.png（460×311.6）一致，热区坐标按同一比例换算 -->
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" MaxWidth="520">
                        <Canvas x:Name="GamepadMapCanvas" Width="460" Height="311.6"/>
                    </Viewbox>

                    <!-- 已设置映射概要 -->
                    <Border Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                            CornerRadius="10" Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#BBD8FF"
                                      VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <TextBlock x:Name="GamepadMapSummary" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 选中某个手柄键后展开：输出类型（胶囊三选一）+ 目标按键 + 删除 -->
                    <Border x:Name="GamepadMapEditor" Visibility="Collapsed"
                            Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                            CornerRadius="10" Padding="14,12">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="6" Height="6" CornerRadius="3" Background="#BBD8FF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GamepadMapEditorTitle" FontSize="14.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Spacing="7">
                                <TextBlock Text="输出类型" FontSize="12" Opacity="0.55"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <RadioButton x:Name="GamepadMapKeyRadio" Content="键盘" GroupName="GamepadMapKind"
                                                 Style="{StaticResource ChipRadioStyle}" Click="OnGamepadMapKindClick"/>
                                    <RadioButton x:Name="GamepadMapMouseRadio" Content="鼠标" GroupName="GamepadMapKind"
                                                 Style="{StaticResource ChipRadioStyle}" Click="OnGamepadMapKindClick"/>
                                    <RadioButton x:Name="GamepadMapPadRadio" Content="手柄" GroupName="GamepadMapKind"
                                                 Style="{StaticResource ChipRadioStyle}" Click="OnGamepadMapKindClick"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="GamepadMapCaptureButton" Style="{StaticResource ChipPrimaryButtonStyle}"
                                        Click="OnGamepadMapCaptureClick"/>
                                <Button x:Name="GamepadMapDeleteButton" Style="{StaticResource ChipButtonStyle}"
                                        Click="OnGamepadMapDeleteClick"
                                        ToolTipService.ToolTip="删除该手柄键的映射">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="#FF7A6B"/>
                                </Button>
                            </StackPanel>
                            <Border x:Name="GamepadMapHintBox" Visibility="Collapsed"
                                    Background="#1FFFD166" BorderBrush="#40FFD166" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8">
                                <TextBlock x:Name="GamepadMapHintText" FontSize="12" Foreground="#FFE3A9" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- OptiScaler 小组件：注入 DLL 名 / ini 关键项（Dx12Upscaler + 帧生成）/ 本地包 / 一键还原（仅 OptiScaler 编辑时显示） -->
                <StackPanel x:Name="OptiScalerRow" Spacing="12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C8;" FontSize="16" Foreground="#BBD8FF" VerticalAlignment="Center"/>
                        <TextBlock Text="OptiScaler 设置" FontSize="17" FontWeight="Bold" Opacity="0.95" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                            CornerRadius="10" Padding="14,12">
                        <StackPanel Spacing="7">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Border Width="4" Height="4" CornerRadius="2" Background="#8FA3BF" VerticalAlignment="Center"/>
                                <TextBlock Text="Y 键 = 检测适配性并注入，A 键 = 游戏内呼出菜单" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Border Width="4" Height="4" CornerRadius="2" Background="#8FA3BF" VerticalAlignment="Center"/>
                                <TextBlock Text="注入会自动关游戏 → 写入 → 重开游戏" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Border Width="4" Height="4" CornerRadius="2" Background="#8FA3BF" VerticalAlignment="Center"/>
                                <TextBlock Text="注入前自动备份，可用下方「一键还原」撤销" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 设置项：先选版本（渠道 + 具体版本），再选注入 DLL 名 / 画质提升；
                         FSR4（画质档 / 文件 / 具体版本）从"画质提升"里独立出来，单独成组，
                         仅当画质提升 = FSR4 时展开（含自己的版本下载与 ✓ 已下载标记）；
                         本地包文件夹紧跟其下方；帧生成开关独占一行；其下输入+输出并排、倍数落在输入正下方。
                         帧生成关闭时，倍数/输入/输出三格整体收起（行高归零，下方内容随之上移）。
                         用 Margin 代替 RowSpacing，收起后不留空档。 -->
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5" Margin="0,0,0,14">
                            <TextBlock Text="OptiScaler 版本" FontSize="13" Opacity="0.72"/>
                            <ComboBox x:Name="OptiVersionCombo" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnOptiVersionChanged"
                                      ToolTipService.ToolTip="正式版：官方仓库的 Release，最稳定；测试版：社区镜像的预览版，更新更快但可能有 Bug；本地包：不联网，直接使用下方「本地包文件夹」里的包。"/>
                        </StackPanel>
                        <StackPanel x:Name="OptiVersionTagCell" Grid.Row="0" Grid.Column="1" Spacing="5" Margin="0,0,0,14">
                            <TextBlock Text="具体版本" FontSize="13" Opacity="0.72"/>
                            <ComboBox x:Name="OptiVersionTagCombo" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnOptiVersionTagChanged"
                                      ToolTipService.ToolTip="列出该渠道在 GitHub 上可下载的版本；默认「最新版（自动）」。选中后会在后台下载，注入（Y 键）时直接用缓存。"/>
                            <TextBlock x:Name="OptiVersionStatus" FontSize="12" Opacity="0.55"
                                       TextWrapping="Wrap" Text="默认使用最新版"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5" Margin="0,0,0,14">
                            <TextBlock Text="注入 DLL 名" FontSize="13" Opacity="0.72"/>
                            <ComboBox x:Name="OptiDllCombo" HorizontalAlignment="Stretch"
                                      ToolTipService.ToolTip="自动 = 按 OptiScaler wiki 对该游戏的建议（默认 dxgi）。若游戏自带同名 DLL，可改用 version / winmm 等规避。"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5" Margin="0,0,0,14">
                            <TextBlock Text="画质提升" FontSize="13" Opacity="0.72"/>
                            <ComboBox x:Name="OptiUpscalerCombo" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnOptiUpscalerChanged"
                                      ToolTipService.ToolTip="写入 [Upscalers] Dx12Upscaler：实际使用的超分方案。选 FSR4 = ffx + [FSR] UpscalerIndex=0（FSR 4.0.2，RDNA4 原生支持；其他卡由驱动回退到 FSR3）。"/>
                        </StackPanel>

                        <!-- FSR4 独立分组：画质档 / 文件（变体）/ 具体版本，仅在画质提升=FSR4 时展开 -->
                        <StackPanel x:Name="OptiFsr4Cell" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                    Spacing="5" Margin="0,0,0,14" Visibility="Collapsed">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5" Margin="0,0,0,14">
                                    <TextBlock Text="FSR4 画质档" FontSize="13" Opacity="0.72"/>
                                    <ComboBox x:Name="OptiFsr4PresetCombo" HorizontalAlignment="Stretch"
                                              ToolTipService.ToolTip="写入 [FSR] Fsr4Preset 内部 FSR4 预设：原生 AA / 质量 / 平衡 / 性能 / DRS / 超级性能。"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5" Margin="0,0,0,14">
                                    <TextBlock Text="FSR4 文件" FontSize="13" Opacity="0.72"/>
                                    <ComboBox x:Name="OptiFsr4FilesCombo" HorizontalAlignment="Stretch"
                                              SelectionChanged="OnOptiFsr4FilesChanged"
                                              ToolTipService.ToolTip="INT8：NVIDIA / AMD / Intel 通用（Intel Arc 走 XMX）；FP8：AMD RDNA4 官方模型。「不额外注入」沿用游戏自带 FSR4 文件。"/>
                                </StackPanel>
                                <StackPanel x:Name="OptiFsr4VersionCell" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Spacing="5" Visibility="Collapsed">
                                    <TextBlock Text="FSR4 具体版本" FontSize="13" Opacity="0.72"/>
                                    <ComboBox x:Name="OptiFsr4VersionCombo" HorizontalAlignment="Stretch"
                                              SelectionChanged="OnOptiFsr4VersionChanged"
                                              ToolTipService.ToolTip="该变体仓库里可下载的 Release 列表；默认取最新版。选中后会自动在后台下载，已下载的版本名称后带 ✓。"/>
                                    <TextBlock x:Name="OptiFsr4VersionStatus" FontSize="12" Opacity="0.55"
                                               TextWrapping="Wrap" Text="默认取该仓库最新版本"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="OptiLocalRow" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                    Spacing="6" Margin="0,0,0,14" Visibility="Collapsed">
                            <TextBlock Text="本地包文件夹" FontSize="13" Opacity="0.72"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OptiLocalFolderText" Grid.Column="0" VerticalAlignment="Center"
                                           FontSize="13" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="OptiLocalFolderButton" Grid.Column="1" Margin="8,0,0,0"
                                        Click="OnOptiLocalFolderClick"
                                        ToolTipService.ToolTip="打开本地包文件夹，把 zip / 7z / rar 或已解压目录放进去即可">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                        <TextBlock Text="打开文件夹…"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="把 zip / 7z / rar 或已解压的 OptiScaler 目录放进这个文件夹，注入时自动使用（不联网）"
                                       FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Spacing="5" Margin="0,0,0,14">
                            <TextBlock Text="帧生成" FontSize="13" Opacity="0.72"/>
                            <ToggleSwitch x:Name="OptiFrameGenToggle" HorizontalAlignment="Left"
                                          OnContent="开" OffContent="关" Toggled="OnOptiFrameGenToggled"
                                          ToolTipService.ToolTip="写入 OptiScaler.ini 的 FrameGen.Enabled。关闭时输入/输出/倍数不生效，会一并收起。"/>
                        </StackPanel>

                        <StackPanel x:Name="OptiFgInputCell" Grid.Row="5" Grid.Column="0" Spacing="5" Margin="0,0,0,14">
                            <TextBlock Text="帧生成输入" FontSize="13" Opacity="0.72"/>
                            <ComboBox x:Name="OptiFgInputCombo" HorizontalAlignment="Stretch"
                                      ToolTipService.ToolTip="FrameGen.FGInput 帧生成的帧源。DLSSG 需游戏走 Streamline + DLSSG，NvngxFG 需游戏支持 DLSS 帧生成；FSRFG / FSRFG 3.0 可配合任意输出；OptiFG（ini 值就是 upscaler）走 OptiScaler 内置的实验性补帧通路，需超分开启，细节由 [OptiFG] 段调节。"/>
                        </StackPanel>
                        <StackPanel x:Name="OptiFgOutputCell" Grid.Row="5" Grid.Column="1" Spacing="5" Margin="0,0,0,14">
                            <TextBlock Text="帧生成输出" FontSize="13" Opacity="0.72"/>
                            <ComboBox x:Name="OptiFgOutputCombo" HorizontalAlignment="Stretch"
                                      ToolTipService.ToolTip="FrameGen.FGOutput 实际补帧的实现。FSRFG 需 amd_fidelityfx 系列 DLL，XeFG 需 libxess_fg.dll 与 libxell.dll，NvngxFG 需 dlssg_to_fsr3_amd_is_better.dll，DLSSG 需 streamline + nvngx_dlssg.dll，DLSSG+NvngxFG 还需一个 NvNGX 提供方。"/>
                        </StackPanel>

                        <StackPanel x:Name="OptiFgMultiplierCell" Grid.Row="6" Grid.Column="0" Spacing="5" Margin="0,0,0,14">
                            <TextBlock Text="帧生成倍数" FontSize="13" Opacity="0.72"/>
                            <ComboBox x:Name="OptiFgMultiplierCombo" HorizontalAlignment="Stretch"
                                      ToolTipService.ToolTip="写入 DLSSG / XeFG 的 InterpolationCount：1=2X、2=3X、3=4X、4=5X、5=6X。5X/6X 仅 DLSSG 系输出支持（XeFG 上限 4X）；FSRFG 固定 2X。"/>
                        </StackPanel>
                    </Grid>

                    <!-- 一键还原：先选要还原的游戏（按备份时间倒序），再执行还原；数据目录：包缓存与备份 -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="已备份的游戏" FontSize="13" Opacity="0.72"/>
                        <ComboBox x:Name="OptiRestoreCombo" HorizontalAlignment="Stretch"
                                  PlaceholderText="没有可还原的备份"
                                  ToolTipService.ToolTip="列出已备份的游戏（每次注入前自动备份被覆盖的文件）；选中后按「一键还原」只还原这个游戏。"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OptiRestoreButton" Click="OnOptiRestoreClick"
                                    ToolTipService.ToolTip="把选中的游戏恢复到注入前（删除注入的文件，复原被覆盖的原文件）">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="14"/>
                                    <TextBlock Text="一键还原"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="OptiOpenFolderButton" Click="OnOptiOpenFolderClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                    <TextBlock Text="打开数据目录…"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="OptiRestoreStatus" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- 磁贴抽屉组件：抽屉列表（名称 + 上一个/下一个切换 + 新增/删除）。
                     抽屉里的磁贴不在这里放：主页区域内部按 X 添加、或编辑模式标记后放入、或直接拖入 -->
                <StackPanel x:Name="DrawerRow" Spacing="10" Visibility="Collapsed">
                    <TextBlock Text="抽屉" FontSize="17" FontWeight="Bold" Opacity="0.95"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DrawerNameBox" Grid.Column="0" PlaceholderText="抽屉名称"
                                 TextChanged="OnDrawerNameChanged"/>
                        <Button x:Name="DrawerPrevButton" Grid.Column="1" Click="OnDrawerPrevClick"
                                ToolTipService.ToolTip="上一个抽屉">
                            <FontIcon Glyph="&#xE76B;" FontSize="14"/>
                        </Button>
                        <Button x:Name="DrawerNextButton" Grid.Column="2" Click="OnDrawerNextClick"
                                ToolTipService.ToolTip="下一个抽屉">
                            <FontIcon Glyph="&#xE76C;" FontSize="14"/>
                        </Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DrawerAddButton" Click="OnDrawerAddClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                <TextBlock Text="新增抽屉"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DrawerDeleteButton" Click="OnDrawerDeleteClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                <TextBlock Text="删除此抽屉"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="DrawerStatusText" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 组件标题（仅手柄映射小组件）：独立一行，显示在下方类型/大小/颜色行的上方 -->
                <StackPanel x:Name="TitleColumn" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="组件标题" FontSize="17" FontWeight="Bold" Opacity="0.95"/>
                    <TextBox x:Name="WidgetTitleBox" PlaceholderText="留空则显示「手柄映射」"/>
                </StackPanel>

                <!-- 系统小组件：勾选的项目才会参与右摇杆 ←→ 切换；未勾选的从切换序列中去掉 -->
                <StackPanel x:Name="SystemOptionsPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="显示的项目" FontSize="17" FontWeight="Bold" Opacity="0.95"/>
                    <TextBlock Text="勾选的项目才会出现在右摇杆 ←→ 的切换里" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="SysOptSettings" Grid.Row="0" Grid.Column="0" Tag="0" Style="{StaticResource SysOptionChipStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <FontIcon Glyph="&#xE713;" FontSize="16" Opacity="0.9"/>
                                    <TextBlock Text="Win 设置" FontSize="14"/>
                                </StackPanel>
                                <FontIcon x:Name="SysOptSettingsMark" Glyph="&#xE711;" FontSize="14"
                                          Foreground="#59FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="SysOptThisPc" Grid.Row="0" Grid.Column="1" Tag="1" Style="{StaticResource SysOptionChipStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="16" Opacity="0.9"/>
                                    <TextBlock Text="我的电脑" FontSize="14"/>
                                </StackPanel>
                                <FontIcon x:Name="SysOptThisPcMark" Glyph="&#xE711;" FontSize="14"
                                          Foreground="#59FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="SysOptVolume" Grid.Row="1" Grid.Column="0" Tag="2" Style="{StaticResource SysOptionChipStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <FontIcon Glyph="&#xE767;" FontSize="16" Opacity="0.9"/>
                                    <TextBlock Text="音量" FontSize="14"/>
                                </StackPanel>
                                <FontIcon x:Name="SysOptVolumeMark" Glyph="&#xE711;" FontSize="14"
                                          Foreground="#59FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="SysOptBrightness" Grid.Row="1" Grid.Column="1" Tag="3" Style="{StaticResource SysOptionChipStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <FontIcon Glyph="&#xE706;" FontSize="16" Opacity="0.9"/>
                                    <TextBlock Text="亮度" FontSize="14"/>
                                </StackPanel>
                                <FontIcon x:Name="SysOptBrightnessMark" Glyph="&#xE711;" FontSize="14"
                                          Foreground="#59FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="SysOptWifi" Grid.Row="2" Grid.Column="0" Tag="4" Style="{StaticResource SysOptionChipStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <FontIcon Glyph="&#xE701;" FontSize="16" Opacity="0.9"/>
                                    <TextBlock Text="WiFi" FontSize="14"/>
                                </StackPanel>
                                <FontIcon x:Name="SysOptWifiMark" Glyph="&#xE711;" FontSize="14"
                                          Foreground="#59FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="SysOptBluetooth" Grid.Row="2" Grid.Column="1" Tag="5" Style="{StaticResource SysOptionChipStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <FontIcon Glyph="&#xE702;" FontSize="16" Opacity="0.9"/>
                                    <TextBlock Text="蓝牙" FontSize="14"/>
                                </StackPanel>
                                <FontIcon x:Name="SysOptBluetoothMark" Glyph="&#xE711;" FontSize="14"
                                          Foreground="#59FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="SysOptHotspot" Grid.Row="3" Grid.Column="0" Tag="6" Style="{StaticResource SysOptionChipStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <FontIcon Glyph="&#xE704;" FontSize="16" Opacity="0.9"/>
                                    <TextBlock Text="移动热点" FontSize="14"/>
                                </StackPanel>
                                <FontIcon x:Name="SysOptHotspotMark" Glyph="&#xE711;" FontSize="14"
                                          Foreground="#59FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="SysOptNightLight" Grid.Row="3" Grid.Column="1" Tag="7" Style="{StaticResource SysOptionChipStyle}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <FontIcon Glyph="&#xE708;" FontSize="16" Opacity="0.9"/>
                                    <TextBlock Text="夜间模式" FontSize="14"/>
                                </StackPanel>
                                <FontIcon x:Name="SysOptNightLightMark" Glyph="&#xE711;" FontSize="14"
                                          Foreground="#59FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </ToggleButton>
                    </Grid>
                </StackPanel>

                <!-- 类型 / 磁贴大小 / 磁贴颜色：三列并排，颜色为紧凑色块（无说明文字） -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="KindColumn" Grid.Column="0" Spacing="4" Margin="0,0,18,0">
                        <TextBlock Text="类型" FontSize="17" FontWeight="Bold" Opacity="0.95"/>
                        <RadioButtons x:Name="KindRadios" MaxColumns="1">
                            <RadioButton x:Name="AppRadio" Content="程序" Padding="14,10" IsChecked="True"/>
                            <RadioButton x:Name="UrlRadio" Content="网站" Padding="14,10"/>
                            <RadioButton x:Name="FolderRadio" Content="文件夹" Padding="14,10"/>
                        </RadioButtons>
                    </StackPanel>
                    <StackPanel x:Name="SizeColumn" Grid.Column="1" Spacing="4" Margin="0,0,18,0">
                        <TextBlock Text="磁贴大小" FontSize="17" FontWeight="Bold" Opacity="0.95"/>
                        <RadioButtons x:Name="SizeRadios" MaxColumns="1">
                            <RadioButton x:Name="SmallSizeRadio" Content="小" Padding="14,10"/>
                            <RadioButton x:Name="WideSizeRadio" Content="长方形" Padding="14,10" IsChecked="True"/>
                            <RadioButton x:Name="LargeSizeRadio" Content="大" Padding="14,10"/>
                        </RadioButtons>
                    </StackPanel>
                    <StackPanel x:Name="ColorColumn" Grid.Column="2" Spacing="4">
                        <TextBlock Text="磁贴颜色" FontSize="17" FontWeight="Bold" Opacity="0.95"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="ColorBlueRadio" Grid.Row="0" Grid.Column="0" GroupName="TileColor"
                                         Tag="#0078D4" Background="#0078D4" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                            <RadioButton x:Name="ColorRedRadio" Grid.Row="0" Grid.Column="1" GroupName="TileColor"
                                         Tag="#E83D2F" Background="#E83D2F" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                            <RadioButton x:Name="ColorGreenRadio" Grid.Row="0" Grid.Column="2" GroupName="TileColor"
                                         Tag="#108A45" Background="#108A45" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                            <RadioButton x:Name="ColorPurpleRadio" Grid.Row="1" Grid.Column="0" GroupName="TileColor"
                                         Tag="#744DA9" Background="#744DA9" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                            <RadioButton x:Name="ColorNoneRadio" Grid.Row="1" Grid.Column="1" GroupName="TileColor"
                                         Tag="none" Background="#1FFFFFFF" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0">
                                <FontIcon Glyph="&#xE711;" FontSize="16" Opacity="0.8"/>
                            </RadioButton>
                            <RadioButton x:Name="ColorTealRadio" Grid.Row="1" Grid.Column="2" GroupName="TileColor"
                                         Tag="#00B294" Background="#00B294" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                            <RadioButton x:Name="ColorYellowRadio" Grid.Row="2" Grid.Column="0" GroupName="TileColor"
                                         Tag="#F7B500" Background="#F7B500" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                            <RadioButton x:Name="ColorPinkRadio" Grid.Row="2" Grid.Column="1" GroupName="TileColor"
                                         Tag="#E3008C" Background="#E3008C" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                            <RadioButton x:Name="ColorIndigoRadio" Grid.Row="2" Grid.Column="2" GroupName="TileColor"
                                         Tag="#4B53CC" Background="#4B53CC" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                         HorizontalAlignment="Stretch" Margin="2" Padding="0"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 图标 -->
                <TextBlock x:Name="IconHeaderText" Text="图标" FontSize="15" Opacity="0.9"/>
                <StackPanel x:Name="IconRow" Orientation="Horizontal" Spacing="12">
                    <Border Width="44" Height="44" CornerRadius="6" Background="#22FFFFFF" VerticalAlignment="Center">
                        <Grid>
                            <FontIcon x:Name="PreviewGlyph" Glyph="&#xE7F8;" FontSize="26"/>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <Button x:Name="IconButton" VerticalAlignment="Center" Click="OnIconClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEB9F;" FontSize="14"/>
                            <TextBlock Text="更改图标…"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 磁贴背景图片 -->
                <TextBlock x:Name="CoverHeaderText" Text="磁贴图片（设置后整块磁贴显示图片）" FontSize="15" Opacity="0.9"/>
                <StackPanel x:Name="CoverRow" Orientation="Horizontal" Spacing="12">
                    <Border Width="44" Height="44" CornerRadius="6" Background="#22FFFFFF" VerticalAlignment="Center">
                        <Grid>
                            <FontIcon x:Name="CoverPreviewGlyph" Glyph="&#xEB9F;" FontSize="22" Opacity="0.5"/>
                            <Image x:Name="CoverPreviewImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <Button x:Name="CoverButton" VerticalAlignment="Center" Click="OnCoverClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B9;" FontSize="14"/>
                            <TextBlock Text="选择图片…"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CoverClearButton" VerticalAlignment="Center" Visibility="Collapsed" Click="OnCoverClearClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            <TextBlock Text="清除"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 文件浏览状态 -->
        <Grid x:Name="BrowsePanel" Grid.Row="1" Padding="20,4" Visibility="Collapsed"
              MaxWidth="680" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="PathText" Grid.Row="0" FontSize="13" Opacity="0.7"
                       TextTrimming="CharacterEllipsis" Margin="4,4,4,8"/>
            <ListView x:Name="FileList" Grid.Row="1" SelectionMode="Single"
                      IsTabStop="False" ScrollViewer.VerticalScrollMode="Enabled">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FileEntry">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16"/>
                            <TextBlock Text="{x:Bind Name}" FontSize="15"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 页脚固定操作栏：保存按钮固定在页面最下方，不随表单滚动（文件浏览时收起）；
             宽度由 AddItemPage.LayoutForm() 设为与表单一致（min(640, 可用宽)）并居中，
             避免全屏/居中模式下被拉成整屏宽，也不会因内容自适应而缩成小按钮 -->
        <Border x:Name="FooterBar" Grid.Row="2" Padding="24,12,24,0"
                BorderThickness="0,1,0,0" BorderBrush="#1AFFFFFF">
            <Button x:Name="SaveButton" Style="{StaticResource SaveButtonStyle}" Click="OnSaveClick"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                    <TextBlock Text="保存" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Border>

        <!-- 底部按键提示：手柄图标徽章，单行，透明背景 -->
        <ctl:GamepadHintBar x:Name="HintBar" Grid.Row="3" Margin="0,8,0,12"/>
    </Grid>
</Page>
