<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameLocker"
    xmlns:ctl="using:GameLocker.Controls">

    <Grid Background="Transparent" RequestedTheme="Dark">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + 返回 -->
        <Grid Grid.Row="0" Padding="20,16">
            <TextBlock x:Name="PageTitle" Text="小组件" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="BackButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Click="OnBackClick">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- 组件列表：三列等宽（Grid * 列），一排 3 个不错位；第 4 张卡片换行到第二行左对齐 -->
        <ScrollViewer x:Name="FormScroll" Grid.Row="1" Padding="12,8"
                      VerticalScrollMode="Auto" VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="FormPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 音乐控制器组件卡片：缩小磁贴预览（样式与主页一致）+ 名称 + 简述 -->
                <Button x:Name="MusicWidgetCard" Grid.Row="0" Grid.Column="0" Tag="music" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" Margin="6" Height="204" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="TilePreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="音乐控制器" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="控制正在播放的音乐"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 图片组组件卡片：缩小磁贴预览（占位样式）+ 名称 + 简述 -->
                <Button x:Name="PhotoWidgetCard" Grid.Row="0" Grid.Column="1" Tag="photo" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" Margin="6" Height="204" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="PhotoPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="图片组" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="轮番展示文件夹图片"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 磁贴集组件卡片：缩小磁贴预览（集合 glyph）+ 名称 + 简述 -->
                <Button x:Name="TileSetWidgetCard" Grid.Row="0" Grid.Column="2" Tag="tileset" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" Margin="6" Height="204" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="TileSetPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="磁贴集" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="复制当前主页磁贴"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 天气组件卡片：缩小天气磁贴预览（显示当前位置当天天气）+ 名称 + 简述 -->
                <Button x:Name="WeatherWidgetCard" Grid.Row="1" Grid.Column="0" Tag="weather" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" Margin="6" Height="204" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="WeatherPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="天气" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="当前位置当天天气"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 映射组件卡片：缩小映射磁贴预览（显示已映射按键）+ 名称 + 简述 -->
                <Button x:Name="MappingWidgetCard" Grid.Row="1" Grid.Column="1" Tag="mapping" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" Margin="6" Height="204" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="MappingPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="磁贴映射" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="映射手柄或键盘按键"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 修改器组件卡片：缩小修改器磁贴预览（扳手图标）+ 名称 + 简述 -->
                <Button x:Name="TrainerWidgetCard" Grid.Row="1" Grid.Column="2" Tag="trainer" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" Margin="6" Height="204" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="TrainerPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="修改器" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="自动下载并打开当前游戏修改器"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 游戏存档组件卡片：缩小游戏存档磁贴预览（保存图标）+ 名称 + 简述 -->
                <Button x:Name="BackupWidgetCard" Grid.Row="2" Grid.Column="0" Tag="backup" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" Margin="6" Height="204" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="BackupPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="游戏存档" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="一键备份 · Y 键同步当前游戏存档"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- 手柄映射组件卡片：缩小手柄映射磁贴预览（手柄图标 + 开关状态）+ 名称 + 简述 -->
                <Button x:Name="GamepadMapWidgetCard" Grid.Row="2" Grid.Column="1" Tag="gamepadmap" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" Margin="6" Height="204" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="GamepadMapPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="手柄映射" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="把多个手柄键映射成键盘/鼠标/手柄键"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- OptiScaler 组件卡片：缩小 OptiScaler 磁贴预览（图像图标 + 名称）+ 名称 + 简述 -->
                <Button x:Name="OptiScalerWidgetCard" Grid.Row="2" Grid.Column="2" Tag="optiscaler" Background="#14FFFFFF" BorderThickness="1"
                        BorderBrush="Transparent" Margin="6" Height="204" VerticalAlignment="Top"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Padding="10" Click="OnAddClick">
                    <StackPanel Spacing="8">
                        <Viewbox MaxHeight="116" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="OptiScalerPreviewHost"/>
                        </Viewbox>
                        <StackPanel Spacing="3">
                            <TextBlock Text="OptiScaler" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="检测当前游戏适配性，一键注入 OptiScaler"
                                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>
        </ScrollViewer>

        <!-- 底部按键提示：手柄图标徽章，单行，透明背景 -->
        <ctl:GamepadHintBar Grid.Row="2" Margin="0,8,0,12"
                            Hints="A:添加到主页|B:返回"/>
    </Grid>
</Page>
