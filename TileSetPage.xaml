<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.TileSetPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:GameLocker.Controls">

    <Grid Background="Transparent" RequestedTheme="Dark">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：磁贴集名称（L3 排列时替换为"编辑模式"） -->
        <Grid Grid.Row="0" Padding="20,12">
            <StackPanel VerticalAlignment="Center" Spacing="0">
                <TextBlock x:Name="SetTitle" Text="磁贴集" FontSize="26" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                <TextBlock x:Name="EditModeText" Text="编辑模式" FontSize="26" FontWeight="Bold"
                           Foreground="White" FontFamily="Segoe UI Variable Display, Segoe UI"
                           Visibility="Collapsed"/>
            </StackPanel>
            <!-- 临时提示条（关闭反馈 toast）：顶栏水平居中，与标题同高 -->
            <Border x:Name="MoveHintBar" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="14,6" CornerRadius="4" Background="#CC000000" Visibility="Collapsed">
                <TextBlock x:Name="MoveHintText" Text="" FontSize="13"/>
            </Border>
        </Grid>

        <!-- 磁贴画布：与主页同款 ScrollViewer + Canvas 流式排布 -->
        <ScrollViewer x:Name="TileScroll" Grid.Row="1" Padding="12,10"
                      VerticalAlignment="Top" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                      VerticalScrollMode="Auto" HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Hidden">
            <Canvas x:Name="TileHost"
                    MinWidth="{Binding ActualWidth, ElementName=TileScroll}"
                    MinHeight="{Binding ActualHeight, ElementName=TileScroll}"/>
        </ScrollViewer>

        <!-- 底部按键提示：手柄图标徽章，单行，透明背景 -->
        <ctl:GamepadHintBar x:Name="HintBar" Grid.Row="2" Margin="0,8,0,12"
                            Hints="DPAD:选择|A:启动|Y:关闭|R3:编辑|L3:排列|LB/RB:翻页|B:返回"/>
    </Grid>
</Page>
