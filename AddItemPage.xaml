                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Ellipse Width="10" Height="10" Fill="#7FE7FF"/>
                                        <Ellipse Width="10" Height="10" Fill="#6BB6FF"/>
                                        <Ellipse Width="10" Height="10" Fill="#8FB3FF"/>
                                        <Ellipse Width="10" Height="10" Fill="#9BE0FF"/>
                                        <Ellipse Width="10" Height="10" Fill="#6FE0D8"/>
                                    </StackPanel>
                                    <TextBlock Text="冰蓝" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="MonColorSunset" Grid.Row="1" Grid.Column="0"
                                         GroupName="MonitorColor" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Ellipse Width="10" Height="10" Fill="#FFD166"/>
                                        <Ellipse Width="10" Height="10" Fill="#FFB86B"/>
                                        <Ellipse Width="10" Height="10" Fill="#FF8C42"/>
                                        <Ellipse Width="10" Height="10" Fill="#FFE0A3"/>
                                        <Ellipse Width="10" Height="10" Fill="#FFA07A"/>
                                    </StackPanel>
                                    <TextBlock Text="暖阳" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="MonColorMono" Grid.Row="1" Grid.Column="1"
                                         GroupName="MonitorColor" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Ellipse Width="10" Height="10" Fill="#FFFFFF"/>
                                        <Ellipse Width="10" Height="10" Fill="#E6E6E6"/>
                                        <Ellipse Width="10" Height="10" Fill="#FFFFFF"/>
                                        <Ellipse Width="10" Height="10" Fill="#E6E6E6"/>
                                        <Ellipse Width="10" Height="10" Fill="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock Text="单色" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="MonColorAurora" Grid.Row="1" Grid.Column="2"
                                         GroupName="MonitorColor" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Ellipse Width="10" Height="10" Fill="#7CF2C6"/>
                                        <Ellipse Width="10" Height="10" Fill="#6FA8FF"/>
                                        <Ellipse Width="10" Height="10" Fill="#A48CFF"/>
                                        <Ellipse Width="10" Height="10" Fill="#FF8AD4"/>
                                        <Ellipse Width="10" Height="10" Fill="#8FE9FF"/>
                                    </StackPanel>
                                    <TextBlock Text="极光" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="显示项目" FontSize="15" Opacity="0.9"/>
                        <TextBlock Text="至少保留一项" FontSize="12" Opacity="0.55"/>
                        <Grid Margin="0,2,0,0" ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="MonOptFps" Grid.Row="0" Grid.Column="0" Style="{StaticResource SysOptionChipStyle}">
                                <Grid>
                                    <TextBlock Text="帧率" FontSize="14" Margin="0,0,22,0"/>
                                    <FontIcon x:Name="MonOptFpsMark" Glyph="&#xE711;" FontSize="14"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="MonOptFrameTime" Grid.Row="0" Grid.Column="1" Style="{StaticResource SysOptionChipStyle}">
                                <Grid>
                                    <TextBlock Text="帧延迟" FontSize="14" Margin="0,0,22,0"/>
                                    <FontIcon x:Name="MonOptFrameTimeMark" Glyph="&#xE711;" FontSize="14"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="MonOptGraph" Grid.Row="0" Grid.Column="2" Style="{StaticResource SysOptionChipStyle}">
                                <Grid>
                                    <TextBlock Text="帧波动线" FontSize="14" Margin="0,0,22,0"/>
                                    <FontIcon x:Name="MonOptGraphMark" Glyph="&#xE711;" FontSize="14"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="MonOptMemory" Grid.Row="0" Grid.Column="3" Style="{StaticResource SysOptionChipStyle}">
                                <Grid>
                                    <TextBlock Text="内存" FontSize="14" Margin="0,0,22,0"/>
                                    <FontIcon x:Name="MonOptMemoryMark" Glyph="&#xE711;" FontSize="14"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>

                            <ToggleButton x:Name="MonOptCpuUsage" Grid.Row="1" Grid.Column="0" Style="{StaticResource SysOptionChipStyle}">
                                <Grid>
                                    <TextBlock Text="CPU 使用" FontSize="14" Margin="0,0,22,0"/>
                                    <FontIcon x:Name="MonOptCpuUsageMark" Glyph="&#xE711;" FontSize="14"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="MonOptCpuFreq" Grid.Row="1" Grid.Column="1" Style="{StaticResource SysOptionChipStyle}">
                                <Grid>
                                    <TextBlock Text="CPU 频率" FontSize="14" Margin="0,0,22,0"/>
                                    <FontIcon x:Name="MonOptCpuFreqMark" Glyph="&#xE711;" FontSize="14"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="MonOptCpuTemp" Grid.Row="1" Grid.Column="2" Style="{StaticResource SysOptionChipStyle}">
                                <Grid>
