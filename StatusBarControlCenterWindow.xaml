<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GameLocker.StatusBarControlCenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 控制中心面板：无标题栏小窗，By DWM 圆角裁剪；磨砂来自 SystemBackdrop -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="RootTransform"/>
        </Grid.RenderTransform>
        <Grid.Resources>
            <!-- 方块开关：直角 + 淡渐变底；开启时由代码把描边换成青色 -->
            <Style x:Key="TileStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#26FFFFFF"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="MinHeight" Value="78"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="IsTabStop" Value="False"/>
            </Style>
            <Style x:Key="ExtraTileStyle" TargetType="Button" BasedOn="{StaticResource TileStyle}">
                <Setter Property="MinHeight" Value="64"/>
                <Setter Property="Padding" Value="6"/>
            </Style>
        </Grid.Resources>

        <Border CornerRadius="16" Background="#D91A1A1E"
                BorderThickness="1" BorderBrush="#33FFFFFF"/>

        <Grid Padding="16,14,16,14" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0">
                <StackPanel Spacing="1">
                    <TextBlock Text="控制中心" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="CONTROL CENTER" FontSize="8.5" Opacity="0.45"
                               CharacterSpacing="180"/>
                </StackPanel>
                <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="30" Height="30" Padding="0" CornerRadius="8"
                        Background="#14FFFFFF" BorderThickness="0" Click="OnCloseClick"
                        IsTabStop="False">
                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                </Button>
            </Grid>

            <!-- 四个快捷开关 -->
            <Grid x:Name="TopTilesGrid" Grid.Row="1" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="WifiTile" Grid.Row="0" Grid.Column="0" Style="{StaticResource TileStyle}"
                        Tag="wifi" CanDrag="True" AllowDrop="True"
                        DragStarting="OnTileDragStarting" DragOver="OnTileDragOver" Drop="OnTileDrop"
                        Click="OnWifiClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#227AD9C4" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="3">
                        <FontIcon Glyph="&#xE701;" FontSize="18" HorizontalAlignment="Left"/>
                        <TextBlock Text="Wi-Fi" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="WifiState" Text="—" FontSize="10" Opacity="0.55"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BluetoothTile" Grid.Row="0" Grid.Column="1" Style="{StaticResource TileStyle}"
                        Tag="bluetooth" CanDrag="True" AllowDrop="True"
                        DragStarting="OnTileDragStarting" DragOver="OnTileDragOver" Drop="OnTileDrop"
                        Click="OnBluetoothClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#224C9FFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="3">
                        <FontIcon Glyph="&#xE702;" FontSize="18" HorizontalAlignment="Left"/>
                        <TextBlock Text="蓝牙" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BluetoothState" Text="—" FontSize="10" Opacity="0.55"/>
                    </StackPanel>
                </Button>

                <Button x:Name="NightTile" Grid.Row="1" Grid.Column="0" Style="{StaticResource TileStyle}"
                        Tag="night" CanDrag="True" AllowDrop="True"
                        DragStarting="OnTileDragStarting" DragOver="OnTileDragOver" Drop="OnTileDrop"
                        Click="OnNightClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#22FFB86B" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="3">
                        <FontIcon Glyph="&#xE708;" FontSize="18" HorizontalAlignment="Left"/>
                        <TextBlock Text="夜间模式" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="NightState" Text="—" FontSize="10" Opacity="0.55"/>
                    </StackPanel>
                </Button>

                <Button x:Name="MuteTile" Grid.Row="1" Grid.Column="1" Style="{StaticResource TileStyle}"
                        Tag="mute" CanDrag="True" AllowDrop="True"
                        DragStarting="OnTileDragStarting" DragOver="OnTileDragOver" Drop="OnTileDrop"
                        Click="OnMuteClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#22FF7A9C" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="3">
                        <FontIcon Glyph="&#xE74F;" FontSize="18" HorizontalAlignment="Left"/>
                        <TextBlock Text="静音" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MuteState" Text="—" FontSize="10" Opacity="0.55"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 更多：展开/收起下方控件 -->
            <Button x:Name="MoreButton" Grid.Row="2" MinHeight="30" CornerRadius="8"
                    Background="#14FFFFFF" BorderThickness="0" Click="OnMoreClick"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="MoreText" Text="更多" FontSize="11.5"/>
                    <FontIcon x:Name="MoreChevron" Glyph="&#xE70D;" FontSize="10"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 音量 -->
            <Grid Grid.Row="4" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="38"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE767;" FontSize="15" VerticalAlignment="Center"/>
                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                        StepFrequency="1" ValueChanged="OnVolumeChanged" VerticalAlignment="Center"/>
                <TextBlock x:Name="VolumeText" Grid.Column="2" Text="—" FontSize="11"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- 亮度 -->
            <Grid Grid.Row="5" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="38"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE706;" FontSize="15" VerticalAlignment="Center"/>
                <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100"
                        StepFrequency="1" ValueChanged="OnBrightnessChanged" VerticalAlignment="Center"/>
                <TextBlock x:Name="BrightnessText" Grid.Column="2" Text="—" FontSize="11"
                           TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- 更多控件（展开后显示） -->
            <Grid x:Name="MorePanel" Grid.Row="3" ColumnSpacing="6" RowSpacing="6"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="ScreenshotTile" Grid.Column="0" Style="{StaticResource TileStyle}"
                        Tag="screenshot" CanDrag="True" AllowDrop="True"
                        DragStarting="OnTileDragStarting" DragOver="OnTileDragOver" Drop="OnTileDrop"
                        Click="OnScreenshotClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#22B07CFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="3">
                        <FontIcon Glyph="&#xE722;" FontSize="18" HorizontalAlignment="Left"/>
                        <TextBlock Text="截屏" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock Text="全屏" FontSize="10" Opacity="0.55"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ThemeTile" Grid.Column="1" Style="{StaticResource TileStyle}"
                        Tag="theme" CanDrag="True" AllowDrop="True"
                        DragStarting="OnTileDragStarting" DragOver="OnTileDragOver" Drop="OnTileDrop"
                        Click="OnThemeClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#22FFD34D" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="3">
                        <FontIcon x:Name="ThemeIcon" Glyph="&#xE790;" FontSize="18" HorizontalAlignment="Left"/>
                        <TextBlock Text="深色" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ThemeState" Text="—" FontSize="10" Opacity="0.55"/>
                    </StackPanel>
                </Button>

                <Button x:Name="HotspotTile" Grid.Column="2" Style="{StaticResource TileStyle}"
                        Tag="hotspot" CanDrag="True" AllowDrop="True"
                        DragStarting="OnTileDragStarting" DragOver="OnTileDragOver" Drop="OnTileDrop"
                        Click="OnHotspotClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#2200B4FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="3">
                        <FontIcon Glyph="&#xE704;" FontSize="18" HorizontalAlignment="Left"/>
                        <TextBlock Text="热点" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HotspotState" Text="—" FontSize="10" Opacity="0.55"/>
                    </StackPanel>
                </Button>

                <Button x:Name="AirplaneTile" Grid.Column="3" Style="{StaticResource TileStyle}"
                        Tag="airplane" CanDrag="True" AllowDrop="True"
                        DragStarting="OnTileDragStarting" DragOver="OnTileDragOver" Drop="OnTileDrop"
                        Click="OnAirplaneClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#2260E0A0" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="3">
                        <FontIcon Glyph="&#xE709;" FontSize="18" HorizontalAlignment="Left"/>
                        <TextBlock Text="飞行" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AirplaneState" Text="—" FontSize="10" Opacity="0.55"/>
                    </StackPanel>
                </Button>

                <Button x:Name="EnergyTile" Grid.Row="1" Grid.Column="0" Style="{StaticResource TileStyle}"
                        Tag="energy" CanDrag="True" AllowDrop="True"
                        DragStarting="OnTileDragStarting" DragOver="OnTileDragOver" Drop="OnTileDrop"
                        Click="OnEnergyClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#229BE870" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="3">
                        <FontIcon Glyph="&#xE945;" FontSize="18" HorizontalAlignment="Left"/>
                        <TextBlock Text="节能" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="EnergyState" Text="—" FontSize="10" Opacity="0.55"/>
                    </StackPanel>
                </Button>

                <Button x:Name="RestartTile" Grid.Row="1" Grid.Column="1" Style="{StaticResource TileStyle}"
                        Tag="restart" CanDrag="True" AllowDrop="True"
                        DragStarting="OnTileDragStarting" DragOver="OnTileDragOver" Drop="OnTileDrop"
                        Click="OnRestartClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                            <GradientStop Color="#22FF7A7A" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="3">
                        <FontIcon Glyph="&#xE777;" FontSize="18" HorizontalAlignment="Left"/>
                        <TextBlock Text="重启" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock Text="立即重启" FontSize="10" Opacity="0.55"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 底部入口 -->
            <Grid Grid.Row="6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="系统设置" FontSize="11.5" MinHeight="30"
                        CornerRadius="8" Background="#14FFFFFF" BorderThickness="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="OnSystemSettingsClick" IsTabStop="False"/>
                <Button Grid.Column="1" Content="我的电脑" FontSize="11.5" MinHeight="30"
                        CornerRadius="8" Background="#14FFFFFF" BorderThickness="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="OnThisPcClick" IsTabStop="False"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
