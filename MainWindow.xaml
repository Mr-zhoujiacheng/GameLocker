<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GameLocker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:GameLocker.Controls">

    <!-- 页面容器：MainPage（快捷项网格）与 SettingsPage（设置）之间导航 -->
    <!-- BackgroundRect：用户可选的背景色层，页面背景透明后透出 -->
    <Grid>
        <Rectangle x:Name="BackgroundRect" IsHitTestVisible="False" Fill="#202020"/>
        <Frame x:Name="Root" Background="Transparent"/>

        <!-- 修改器候选选择遮罩：精确匹配失败时弹出，让用户从相似结果里挑一个下载。
             视觉语言与主页"添加"弹窗一致：玻璃质感面板 + 强调色图标徽章 + 选中描边高亮，手柄可操作 -->
        <Grid x:Name="TrainerChoiceOverlay" RequestedTheme="Dark" Visibility="Collapsed">
            <!-- 遮罩层：点击空白处取消 -->
            <Border x:Name="TrainerChoiceMask" Background="#C00A0C10" Tapped="OnTrainerChoiceMaskTapped"/>

            <Border x:Name="TrainerChoicePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="16" Padding="20,20,20,0"
                    Background="#E6242424" BorderBrush="#33FFFFFF" BorderThickness="1.5"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="TrainerChoiceScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <StackPanel Width="392" Spacing="12">
                    <!-- 标题：扳手徽章 + 标题（与主页修改器磁贴同一视觉语言） -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,0,0,6">
                        <Border Width="26" Height="26" CornerRadius="8" Background="#2A4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE90F;" FontSize="13" Foreground="#4CC2FF"/>
                        </Border>
                        <TextBlock Text="选择修改器" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="TrainerChoiceHint" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Margin="2,0,2,2"/>

                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TrainerChoiceList" Spacing="8"/>
                    </ScrollViewer>

                    <!-- 触屏：图标行贴住面板底边，图标放大后可点按（A=下载，B=取消） -->
                    <ctl:GamepadHintBar x:Name="TrainerChoiceHintBar" TouchMode="True"
                                        HorizontalAlignment="Center" Margin="0,8,0,0"
                                        Hints="DPAD:选择|A:下载|B:取消"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OptiScaler 适配性确认遮罩：点击 OptiScaler 磁贴后弹出，显示当前游戏的适配性、建议注入的代理 DLL 与 wiki 备注；
             询问是否注入，A=注入并重启游戏，B=取消。视觉语言与修改器候选弹窗一致。 -->
        <Grid x:Name="OptiOverlay" RequestedTheme="Dark" Visibility="Collapsed">
            <Border x:Name="OptiMask" Background="#C00A0C10" Tapped="OnOptiMaskTapped"/>

            <Border x:Name="OptiPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="16" Padding="20,20,20,0"
                    Background="#E6242424" BorderBrush="#33FFFFFF" BorderThickness="1.5"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="OptiScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <StackPanel Width="400" Spacing="12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,0,0,2">
                        <Border Width="26" Height="26" CornerRadius="8" Background="#2A4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8C8;" FontSize="13" Foreground="#4CC2FF"/>
                        </Border>
                        <TextBlock Text="OptiScaler 适配性" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 已注入过：覆盖警告（继续注入会覆盖现有文件，A=覆盖注入 / B=取消） -->
                    <Border x:Name="OptiWarnBox" Visibility="Collapsed" CornerRadius="12"
                            Background="#2AFF6B5C" BorderBrush="#55FF6B5C" BorderThickness="1" Padding="14,12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="#FF8A7A" VerticalAlignment="Top"/>
                            <TextBlock Text="该游戏已注入过 OptiScaler。继续注入会覆盖现有文件，若已装其他 Mod 或旧版本容易冲突、甚至无法启动；被覆盖的文件会先备份，可一键还原。是否仍要注入？"
                                       FontSize="12.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Background="#14FFFFFF" BorderBrush="#26FFFFFF"
                            BorderThickness="1" Padding="16,14">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="OptiStatusEmoji" Text="❔" FontSize="34" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="OptiGameName" Text="—" FontSize="16" FontWeight="SemiBold"
                                               MaxWidth="296" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="OptiStatusText" Text="适配性：未收录" FontSize="13" Opacity="0.8"/>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Height="1" Fill="#1FFFFFFF"/>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="建议注入" FontSize="13" Opacity="0.6" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" x:Name="OptiDllText" Text="dxgi.dll"
                                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid x:Name="OptiInputsRow" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="可用输入" FontSize="13" Opacity="0.6" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" x:Name="OptiInputsText" Text=""
                                           FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="OptiNoteBox" MaxHeight="96" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="OptiNoteText" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <TextBlock x:Name="OptiHintText" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               Text="选择注入将关闭游戏、写入 OptiScaler 后重新打开游戏；注入前会自动备份被覆盖的同名文件。"/>

                    <!-- 触屏：图标行贴住面板底边，图标放大后可点按（A=注入，B=取消） -->
                    <ctl:GamepadHintBar x:Name="OptiHintBar" TouchMode="True"
                                        HorizontalAlignment="Center" Margin="0,8,0,0" Hints="A:注入|B:取消"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SaveRestoreOverlay" RequestedTheme="Dark" Visibility="Collapsed">
            <Border x:Name="SaveRestoreMask" Background="#D80A0C10" Tapped="OnSaveRestoreMaskTapped"/>
            <Border x:Name="SaveRestorePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="24" Padding="18,18,18,0" Margin="12"
                    BorderBrush="#2EFFFFFF" BorderThickness="1.2" RenderTransformOrigin="0.5,0.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                        <GradientStop Color="#F22A2E36" Offset="0"/>
                        <GradientStop Color="#F21A1D23" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <CompositeTransform x:Name="SaveRestorePanelTransform"/>
                </Border.RenderTransform>
                <Grid Width="520" MaxHeight="680" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12" Margin="2,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="22" Background="#264CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="19" Foreground="#4CC2FF"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="SaveRestoreTitle" Text="恢复存档" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SaveRestoreSubtitle" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="SaveRestoreDescription" FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="4,0"/>
                            <Border CornerRadius="14" Padding="14,10" Background="#2A4CC2FF" BorderBrush="#554CC2FF" BorderThickness="1">
                                <TextBlock x:Name="SaveRestoreWarning" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                            <StackPanel x:Name="SaveRestoreList" Spacing="6"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ctl:GamepadHintBar x:Name="SaveRestoreHintBar" Grid.Row="2" TouchMode="True"
                                        HorizontalAlignment="Center" Margin="0,8,0,0"
                                        Hints="DPAD:选择|A:恢复|X:同步|B:取消"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
