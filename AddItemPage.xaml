                                    <FontIcon x:Name="MonOptCpuTempMark" Glyph="&#xE711;" FontSize="14"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="MonOptCpuPower" Grid.Row="1" Grid.Column="3" Style="{StaticResource SysOptionChipStyle}">
                                <Grid>
                                    <TextBlock Text="CPU 功耗" FontSize="14" Margin="0,0,22,0"/>
                                    <FontIcon x:Name="MonOptCpuPowerMark" Glyph="&#xE711;" FontSize="14"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>

                            <ToggleButton x:Name="MonOptGpuUsage" Grid.Row="2" Grid.Column="0" Style="{StaticResource SysOptionChipStyle}">
                                <Grid>
                                    <TextBlock Text="GPU 使用" FontSize="14" Margin="0,0,22,0"/>
                                    <FontIcon x:Name="MonOptGpuUsageMark" Glyph="&#xE711;" FontSize="14"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="MonOptGpuFreq" Grid.Row="2" Grid.Column="1" Style="{StaticResource SysOptionChipStyle}">
                                <Grid>
                                    <TextBlock Text="GPU 频率" FontSize="14" Margin="0,0,22,0"/>
                                    <FontIcon x:Name="MonOptGpuFreqMark" Glyph="&#xE711;" FontSize="14"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="MonOptGpuPower" Grid.Row="2" Grid.Column="2" Style="{StaticResource SysOptionChipStyle}">
                                <Grid>
                                    <TextBlock Text="GPU 功耗" FontSize="14" Margin="0,0,22,0"/>
                                    <FontIcon x:Name="MonOptGpuPowerMark" Glyph="&#xE711;" FontSize="14"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="MonOptGpuTemp" Grid.Row="2" Grid.Column="3" Style="{StaticResource SysOptionChipStyle}">
                                <Grid>
                                    <TextBlock Text="GPU 温度" FontSize="14" Margin="0,0,22,0"/>
                                    <FontIcon x:Name="MonOptGpuTempMark" Glyph="&#xE711;" FontSize="14"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>

                            <ToggleButton x:Name="MonOptBatteryPercent" Grid.Row="3" Grid.Column="0" Style="{StaticResource SysOptionChipStyle}">
                                <Grid>
                                    <TextBlock Text="电池电量" FontSize="14" Margin="0,0,22,0"/>
                                    <FontIcon x:Name="MonOptBatteryPercentMark" Glyph="&#xE711;" FontSize="14"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ToggleButton x:Name="MonOptBattery" Grid.Row="3" Grid.Column="1" Style="{StaticResource SysOptionChipStyle}">
                                <Grid>
                                    <TextBlock Text="电池功耗 · 预计" FontSize="14" Margin="0,0,22,0"/>
                                    <FontIcon x:Name="MonOptBatteryMark" Glyph="&#xE711;" FontSize="14"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
