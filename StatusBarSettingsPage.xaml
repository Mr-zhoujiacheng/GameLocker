<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.StatusBarSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:GameLocker.Controls">

    <Page.Resources>
        <!-- 开关行卡片：与「顶栏 / 底栏」设置页同一套（直角 + 浅蓝渐变底） -->
        <Style x:Key="SettingRowStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
        <!-- 开关本体：自绘胶囊，隐藏 On/Off 文案 -->
        <Style x:Key="CleanToggleStyle" TargetType="ToggleSwitch">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleSwitch">
                        <Grid Width="44" Height="22" Background="Transparent">
                            <Border Width="40" Height="20" CornerRadius="10" Background="#2AFFFFFF"
                                    BorderThickness="1" BorderBrush="#4DFFFFFF"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="Fill" Width="40" Height="20" CornerRadius="10" Background="#C67AD9C4"
                                    Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#FFFFFF"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <CompositeTransform/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="ToggleStates">
                                    <VisualState x:Name="Off">
                                        <VisualState.Setters>
                                            <Setter Target="Knob.Fill" Value="#FFFFFF"/>
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                                                             To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="On">
                                        <VisualState.Setters>
                                            <Setter Target="Knob.Fill" Value="#1F1F1F"/>
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                                                             To="20" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent"
          RequestedTheme="Dark" XYFocusKeyboardNavigation="Enabled">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ctl:SettingsHeader Grid.Row="0" Title="系统" Subtitle="SYSTEM"/>

        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="20,8,20,10"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="ContentStack" Spacing="12" VerticalAlignment="Top">

                <!-- 规划样张：说明目标形态，不代表已实现 -->
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Text="系统预览（顶栏 + 底栏）" FontSize="11.5" Opacity="0.55"
                                   VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Padding="9,3" CornerRadius="8"
                                Background="#14FFFFFF" BorderThickness="1" BorderBrush="#1FFFFFFF">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#FF8A8A92"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="未启用" FontSize="11"
                                           Opacity="0.8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Padding="12,10" CornerRadius="12" Background="#14FFFFFF"
                            BorderBrush="#1FFFFFFF" BorderThickness="1" MinHeight="66">
                        <Border x:Name="PreviewBar" Height="44" CornerRadius="12" Padding="14,0"
                                Background="#E6101013" BorderThickness="1" BorderBrush="#26FFFFFF"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="10:14" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PreviewDate" Text="周五 11/21" FontSize="11.5"
                                               Opacity="0.65" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE701;" FontSize="14" Opacity="0.9"/>
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE850;" FontSize="14"/>
                                        <TextBlock Text="86%" FontSize="11.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="⚡" FontSize="10" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border CornerRadius="5" Background="#33FFFFFF" Padding="6,2">
                                        <TextBlock Text="中" FontSize="10.5"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEA8F;" FontSize="14"/>
                                        <TextBlock Text="3" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- 设置行由代码构建（开关 / 循环 / 滑杆），与底栏设置页同一套版式 -->
                <StackPanel x:Name="Rows" Spacing="10" Padding="0,0,4,8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 悬浮按键提示：与其它设置子页一致 -->
        <Border Grid.Row="0" Grid.RowSpan="99"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,14,20,0" Padding="14,9" CornerRadius="12"
                Background="#26000000">
            <ctl:GamepadHintBar BadgeScale="1"
                                Hints="A:切换|B:返回"/>
        </Border>
    </Grid>
</Page>
