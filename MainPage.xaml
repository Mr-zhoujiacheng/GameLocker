<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.MainPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:GameLocker.Controls">

    <Page.Resources>
        <!-- 顶栏状态图标：每枚图标仍有自己的圆角气泡（悬停/按下提亮），整组再收在一枚大圆角框里 -->
        <Style x:Key="StatusBubbleStyle" TargetType="Border">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent" RequestedTheme="Dark"
          AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：时钟 + 手柄状态 -->
        <Grid Grid.Row="0" Padding="20,12">
            <!-- 时钟：左侧 2px 渐隐竖线 + 时间/日期两行（轻改精致版） -->
            <Grid x:Name="ClockPanel" VerticalAlignment="Center" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="2" Height="34" VerticalAlignment="Center" CornerRadius="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#8C4CC2FF" Offset="0"/>
                            <GradientStop Color="#004CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" Spacing="0">
                    <TextBlock x:Name="ClockText" Text="00:00" FontSize="32" FontWeight="SemiBold"
                               CharacterSpacing="25"
                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    <TextBlock x:Name="DateText" Text="" FontSize="12.5" Opacity="0.65"
                               CharacterSpacing="30" Margin="0,1,0,0"/>
                    <!-- 编辑模式：进入 L3 排列时替换整个时钟+日期模块，白色大字；高度与时钟+日期两行一致，顶栏不跳动 -->
                    <TextBlock x:Name="EditModeText" Text="编辑模式" FontSize="34" FontWeight="Bold"
                               Foreground="White" Height="58" VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
            <!-- 顶栏状态区：五枚图标收在一枚大圆角"玻璃框"里（渐变底 + 斜向亮边），
                 图标本身只有悬停/按下时提亮；状态只靠颜色区分
                 （Wi-Fi/蓝牙 绿=开启，电池 绿/黄/红，手柄 绿=已连接 / 红=未连接） -->
            <Border x:Name="StatusTray" HorizontalAlignment="Right" VerticalAlignment="Center"
                    CornerRadius="24" Padding="6" BorderThickness="1">
                <!-- 与时钟+日期两行的视觉中线对齐：文字字形重心整体偏下，图标框按几何居中会显得偏上，下移 3px -->
                <Border.RenderTransform>
                    <TranslateTransform Y="3"/>
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2AFFFFFF" Offset="0"/>
                        <GradientStop Color="#0AFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#59FFFFFF" Offset="0"/>
                        <GradientStop Color="#12FFFFFF" Offset="0.6"/>
                        <GradientStop Color="#2EFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <StackPanel x:Name="StatusIcons" Orientation="Horizontal" Spacing="6">
                    <!-- 搜索：固定在这一组的第一位（最左），点击打开自制搜索浮层 -->
                    <Border x:Name="SearchBubble" Style="{StaticResource StatusBubbleStyle}">
                        <Grid Width="24" Height="24">
                            <Path x:Name="SearchRing" Stroke="#FFFFFFFF" StrokeThickness="2.8"
                                  Data="M10.4,5.2 A5.2,5.2 0 1,1 10.4,15.6 A5.2,5.2 0 1,1 10.4,5.2 Z"/>
                            <Path x:Name="SearchHandle" Stroke="#FFFFFFFF" StrokeThickness="2.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M14.6,14.6 L19.4,19.4"/>
                        </Grid>
                    </Border>
                    <Border x:Name="WifiBubble" Style="{StaticResource StatusBubbleStyle}">
                        <FontIcon x:Name="WifiIcon" Glyph="&#xE701;" FontSize="26"/>
                    </Border>
                    <Border x:Name="BluetoothBubble" Style="{StaticResource StatusBubbleStyle}">
                        <FontIcon x:Name="BluetoothIcon" Glyph="&#xE702;" FontSize="26"/>
                    </Border>
                    <Border x:Name="BatteryBubble" Style="{StaticResource StatusBubbleStyle}">
                        <FontIcon x:Name="BatteryIcon" Glyph="&#xE850;" FontSize="26"/>
                    </Border>
                    <Border x:Name="GamepadBubble" Style="{StaticResource StatusBubbleStyle}">
                        <FontIcon x:Name="GamepadIcon" Glyph="&#xE7FC;" FontSize="26"/>
                    </Border>
                    <!-- 夜间模式：点击切换暖色滤镜；图标随开关在太阳/月亮之间切换（粗线圆头风格） -->
                    <Border x:Name="NightBubble" Style="{StaticResource StatusBubbleStyle}">
                        <Grid Width="24" Height="24">
                            <!-- 白天：圆环 + 八条光芒，统一 2.6px 圆头描边 -->
                            <Path x:Name="SunIcon" Stroke="#FFB9BEC6" StrokeThickness="2.6"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12,8.1 A3.9,3.9 0 1,1 12,15.9 A3.9,3.9 0 1,1 12,8.1 Z
                                        M12,3.2 V4.9 M12,19.1 V20.8 M3.2,12 H4.9 M19.1,12 H20.8
                                        M5.8,5.8 L7,7 M17,17 L18.2,18.2
                                        M18.2,5.8 L17,7 M7,17 L5.8,18.2"/>
                            <!-- 夜间：实心月牙（单一路径，避免拼两个圆的接缝） -->
                            <Path x:Name="MoonIcon" Fill="#FFFFB86B" Visibility="Collapsed"
                                  Data="M14.9,3.5 A8.9,8.9 0 1,0 20.5,14.4 A7.2,7.2 0 0,1 14.9,3.5 Z"/>
                        </Grid>
                    </Border>
                    <!-- 通知：固定在图标组末尾（最右）；有新通知时右上角亮小绿点 -->
                    <Grid x:Name="NotificationHost" Width="46" Height="46" VerticalAlignment="Center">
                        <Border x:Name="NotificationBubble" Style="{StaticResource StatusBubbleStyle}">
                            <FontIcon x:Name="NotificationIcon" Glyph="&#xEA8F;" FontSize="26"/>
                        </Border>
                        <Ellipse x:Name="NotificationDot" Width="10" Height="10" Fill="#3FC05B"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,2,2,0" Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 磁贴区：滚动画布铺满整页；抽屉面板悬浮在磁贴区底部，不再单独占一行、不挤压磁贴布局 -->
        <Grid x:Name="TileArea" Grid.Row="1">

            <!-- 磁贴画布：ScrollViewer + Canvas 手动布局（靠上排布，从上往下）。
                 副页切换：LT/RT 时整块画布沿切换方向滑出、换页后反向滑入（TranslateTransform 由 SwitchPage 驱动） -->
            <ScrollViewer x:Name="TileScroll" Grid.Row="0" Padding="12,10"
                          VerticalAlignment="Top" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                          VerticalScrollMode="Auto" HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Hidden">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform x:Name="PageSlide"/>
                </ScrollViewer.RenderTransform>
                <!-- MinWidth 用视口宽度（ActualWidth 含左右 Padding 会让画布比可视区宽，导致最右列被裁） -->
                <Canvas x:Name="TileHost"
                        MinWidth="{Binding ViewportWidth, ElementName=TileScroll}"
                        MinHeight="{Binding ActualHeight, ElementName=TileScroll}"/>
            </ScrollViewer>

            <!-- 副页页码指示：底部中央圆点，数量=主页页数、当前页高亮（LayoutPageDots 重建；仅一页时隐藏） -->
            <StackPanel x:Name="PageDots" Grid.Row="0" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,8" IsHitTestVisible="False" Visibility="Collapsed"/>

            <!-- 临时提示条（关闭反馈/删除反馈/拖入结果 toast）：玻璃质感药丸 + 状态图标徽章，
                 画布底部居中 —— 紧贴手柄提示条上方（页码圆点之上）；图标/强调色由 ShowToast 按消息语义
                 （成功=青色对勾 / 警告=琥珀感叹号）切换，入场淡入并自下方归位 -->
            <Border x:Name="MoveHintBar" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,30" IsHitTestVisible="False"
                    CornerRadius="12" Padding="12,7,16,7"
                    Background="#E6242424" BorderBrush="#33FFFFFF" BorderThickness="1.5"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MoveHintSlide"/>
                </Border.RenderTransform>
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border x:Name="MoveHintBadge" Width="22" Height="22" CornerRadius="6"
                                Background="#2A4CC2FF" VerticalAlignment="Center">
                            <FontIcon x:Name="MoveHintIcon" Glyph="&#xE73E;" FontSize="11" Foreground="#4CC2FF"/>
                        </Border>
                        <TextBlock x:Name="MoveHintText" Text="" FontSize="13" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   TextWrapping="Wrap" MaxWidth="500"/>
                    </StackPanel>
                    <!-- 联网下载时的细进度条：文案下方，仅下载期间显示（由 ShowToast 的 progress 参数驱动） -->
                    <ProgressBar x:Name="MoveHintProgress" Height="4" MinWidth="180" Minimum="0" Maximum="100"
                                 Value="0" Visibility="Collapsed" Background="#26FFFFFF"/>
                </StackPanel>
            </Border>

            <!-- 磁贴抽屉：固定在主页下方的独立区域，宽度随窗口自适应铺满；内容（标签条 + 内层磁贴）由
                 MainPage.RenderDrawerPanel 代码构建；无抽屉组件时折叠隐藏，不占高度。
                 注意：必须显式给一个背景（不能省略），否则空白处不参与命中测试，点面板空白无法进入区域 -->
            <!-- 抽屉面板（玻璃拟态浮层）：半透明渐变底（顶部略亮→底部更透）+ 1px 高光描边 + 投影浮起，
                 让它像一个浮在窗口上的玻璃卡片，而不是糊在背景里的一块灰。
                 渐变与描边是"玻璃"的骨架，投影由 ThemeShadow + Translation.Z 生成（见 MainPage 构造）。
                 注意：背景不能省略（Transparent 也参与命中测试），否则点空白无法进入抽屉区域。
                 DrawerSlide：开启"自动隐藏"时向下平移整块面板，滑出窗口下缘即不可见 -->
            <Border x:Name="DrawerHost" Grid.Row="0" Margin="12,6,12,8"
                    VerticalAlignment="Bottom"
                    CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1"
                    HorizontalAlignment="Stretch" Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1EFFFFFF" Offset="0"/>
                        <GradientStop Color="#0DFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DrawerSlide"/>
                </Border.RenderTransform>
            </Border>
        </Grid>

        <!-- 底部按键提示：无底板、无描边，只垫一层极淡暗底保证对比（简约但醒目）。
             抽屉展开时由代码给抽屉面板留出这条提示条的高度，抽屉在上、提示条在最下面，两者不重叠 -->
        <Border x:Name="HintBarShell" Grid.Row="0" Grid.RowSpan="3"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,20" Padding="14,9" CornerRadius="12" BorderThickness="0"
                Background="#26000000"
                Visibility="{x:Bind HintBar.Visibility, Mode=OneWay}">
            <ctl:GamepadHintBar x:Name="HintBar" BadgeScale="1" Highlight="True"/>
        </Border>

        <!-- 添加方式选择遮罩：X 键 / 编辑模式"添加磁贴"弹出，三选一（自定义 / 小组件 / 副页块），手柄可操作。
             玻璃质感面板 + 强调色图标徽章；选中项用强调色描边 + 底色高亮（见 UpdateChoiceCursor） -->
        <Grid x:Name="ChoiceOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <!-- 遮罩层：点击空白处关闭 -->
            <Border x:Name="ChoiceMask" Background="#C00A0C10"/>

            <Border x:Name="ChoicePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="16" Padding="20,20,20,0"
                    Background="#E6242424" BorderBrush="#33FFFFFF" BorderThickness="1.5"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ChoicePanelScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <StackPanel Width="292" Spacing="12">
                    <!-- 标题：加号徽章 + 标题（与主页编辑模式的"添加磁贴"入口同一视觉语言） -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,0,0,6">
                        <Border Width="26" Height="26" CornerRadius="8" Background="#2A4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="#4CC2FF"/>
                        </Border>
                        <TextBlock Text="添加" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border x:Name="ChoiceCustom" CornerRadius="12" Background="#14FFFFFF"
                            BorderBrush="#26FFFFFF" BorderThickness="1.5" Padding="14,12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#2A4CC2FF" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="#4CC2FF"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="自定义" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="快捷方式 / 程序 / 网站 / 文件夹" FontSize="11.5" Opacity="0.65"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ChoiceWidget" CornerRadius="12" Background="#14FFFFFF"
                            BorderBrush="#26FFFFFF" BorderThickness="1.5" Padding="14,12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#2A4CC2FF" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE71D;" FontSize="16" Foreground="#4CC2FF"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="小组件" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="音乐播放器等可交互磁贴" FontSize="11.5" Opacity="0.65"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 副页块：新增一块可 LT/RT 切换的主页（可加多个） -->
                    <Border x:Name="ChoiceSubPage" CornerRadius="12" Background="#14FFFFFF"
                            BorderBrush="#26FFFFFF" BorderThickness="1.5" Padding="14,12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#2A4CC2FF" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7C4;" FontSize="16" Foreground="#4CC2FF"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="副页块" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="新增一块可 LT/RT 切换的主页" FontSize="11.5" Opacity="0.65"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 触屏：图标行贴住面板底边，图标放大后可点按（DPAD=切换，A=确认，B=取消） -->
                    <ctl:GamepadHintBar x:Name="ChoiceHintBar" TouchMode="True" CapsuleChips="True"
                                        HorizontalAlignment="Center" Margin="0,8,0,0"
                                        Hints="DPAD:选择|A:确认|B:取消"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 抽屉改名遮罩：抽屉层 R3 / 双击抽屉标签 打开 —— 只改"当前抽屉"的名字（A/Enter 确认，B/Esc 取消） -->
        <Grid x:Name="RenameOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <Border x:Name="RenameMask" Background="#C00A0C10"/>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="16" Padding="20,18,20,0"
                    Background="#E6242424" BorderBrush="#33FFFFFF" BorderThickness="1.5">
                <StackPanel Width="292" Spacing="12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,0,0,4">
                        <Border Width="26" Height="26" CornerRadius="8" Background="#2A4CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8F1;" FontSize="13" Foreground="#4CC2FF"/>
                        </Border>
                        <TextBlock x:Name="RenameTitle" Text="抽屉名称" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox x:Name="RenameBox" FontSize="16" Padding="10,8"
                             PlaceholderText="抽屉名称" KeyDown="OnRenameBoxKeyDown"/>
                    <!-- 触屏：图标行贴住面板底边，放大后的 A/B 图标可直接点按确认/取消 -->
                    <ctl:GamepadHintBar x:Name="RenameHintBar" TouchMode="True" CapsuleChips="True"
                                        HorizontalAlignment="Center" Margin="0,8,0,0" Hints="A:确认|B:取消"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 电源菜单遮罩：电源磁贴 A/点击打开 —— 手机电源菜单风格（深色玻璃卡 + 纵向操作列表）。
             DPAD 选择、A 执行、B/点空白取消；点击某一项直接执行（选中项强调色描边高亮） -->
        <Grid x:Name="PowerOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <Border x:Name="PowerMask" Background="#D80A0C10"/>

            <Border x:Name="PowerPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="24" Padding="18,20,18,0"
                    BorderBrush="#2EFFFFFF" BorderThickness="1.2"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                        <GradientStop Color="#F22A2E36" Offset="0"/>
                        <GradientStop Color="#F21A1D23" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <CompositeTransform x:Name="PowerPanelTransform" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>

                <StackPanel Width="304" Spacing="10">
                    <!-- 标题：红色电源徽章 + 标题/说明 -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="2,0,0,6">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#26FF5B5B" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7E8;" FontSize="20" Foreground="#FF6B6B"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="电源" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock Text="选择要执行的操作" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 注销 -->
                    <Border x:Name="PowerSignOut" Height="52" CornerRadius="14" Padding="14,0"
                            Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1.5">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="10" Background="#266FA8FF">
                                    <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="#6FA8FF"/>
                                </Border>
                                <TextBlock Text="注销" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                            <FontIcon Glyph="&#xE76C;" FontSize="11" Opacity="0.35"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 睡眠 -->
                    <Border x:Name="PowerSleep" Height="52" CornerRadius="14" Padding="14,0"
                            Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1.5">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="10" Background="#269B7DFF">
                                    <FontIcon Glyph="&#xE708;" FontSize="15" Foreground="#B9A2FF"/>
                                </Border>
                                <TextBlock Text="睡眠" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                            <FontIcon Glyph="&#xE76C;" FontSize="11" Opacity="0.35"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 休眠 -->
                    <Border x:Name="PowerHibernate" Height="52" CornerRadius="14" Padding="14,0"
                            Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1.5">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="10" Background="#264CC2FF">
                                    <FontIcon Glyph="&#xE769;" FontSize="15" Foreground="#4CC2FF"/>
                                </Border>
                                <TextBlock Text="休眠" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                            <FontIcon Glyph="&#xE76C;" FontSize="11" Opacity="0.35"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 重启 -->
                    <Border x:Name="PowerRestart" Height="52" CornerRadius="14" Padding="14,0"
                            Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1.5">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="10" Background="#26FFC15E">
                                    <FontIcon Glyph="&#xE72C;" FontSize="15" Foreground="#FFC15E"/>
                                </Border>
                                <TextBlock Text="重启" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                            <FontIcon Glyph="&#xE76C;" FontSize="11" Opacity="0.35"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 关机 -->
                    <Border x:Name="PowerShutdown" Height="52" CornerRadius="14" Padding="14,0"
                            Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1.5">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="10" Background="#26FF5B5B">
                                    <FontIcon Glyph="&#xE7E8;" FontSize="15" Foreground="#FF6B6B"/>
                                </Border>
                                <TextBlock Text="关机" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                            <FontIcon Glyph="&#xE76C;" FontSize="11" Opacity="0.35"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 触屏：图标行贴住面板底边，图标放大后可点按（DPAD=切换，A=执行，B=取消） -->
                    <ctl:GamepadHintBar x:Name="PowerHintBar" TouchMode="True" CapsuleChips="True"
                                        HorizontalAlignment="Center" Margin="0,8,0,0"
                                        Hints="DPAD:选择|A:执行|B:取消"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 性能控制遮罩：性能控制磁贴 A/点击打开 —— Windows 电源模式三档 + 锁帧/功耗/CPU/核心设置。
             上下切换行、左右在功耗/CPU 两列间切换、右摇杆调值，所有改动先标记“待应用”，按 X 或点“保存”统一生效，B/Y 关闭且不保存 -->
        <Grid x:Name="PerformanceOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <Border x:Name="PerformanceMask" Background="#D80A0C10"/>

            <Border x:Name="PerformancePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    XYFocusKeyboardNavigation="Disabled"
                    CornerRadius="24" Padding="18,20,18,14"
                    BorderBrush="#2EFFFFFF" BorderThickness="1.2"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                        <GradientStop Color="#F22A2E36" Offset="0"/>
                        <GradientStop Color="#F21A1D23" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <CompositeTransform x:Name="PerformancePanelTransform" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>

                <Grid x:Name="PerformancePanelContent" MaxWidth="620" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题：性能徽章 + 当前设备 -->
                    <Grid Grid.Row="0" Margin="2,0,2,2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="42" Height="42" CornerRadius="21" Background="#26FF9A4D" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE945;" FontSize="19" Foreground="#FFB366"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="性能控制" FontSize="21" FontWeight="SemiBold"/>
                                <TextBlock Text="电源方案与处理器性能设置" FontSize="11.5" Opacity="0.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10"
                                Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="8,4">
                            <TextBlock x:Name="PerfDeviceText" Text="—" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="#FFB366" VerticalAlignment="Center"
                                       MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>

                    <!-- 主体：设备状态 + 电源方案一行四卡 + EPP + 双列设置 -->
                    <ScrollViewer x:Name="PerfSettingsScroll" Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="10" Margin="0,0,10,0">
                            <Border CornerRadius="12" Background="#1A000000" Padding="12,8"
                                    BorderBrush="#12FFFFFF" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="设备状态" FontSize="12" FontWeight="Bold" Opacity="0.8"/>
                                    <Grid ColumnSpacing="8" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="CPU 功耗" FontSize="10.5" FontWeight="SemiBold" Opacity="0.62"/>
                                            <TextBlock x:Name="PerfTelemetryPower" Text="—" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="CPU 温度" FontSize="10.5" FontWeight="SemiBold" Opacity="0.62"/>
                                            <TextBlock x:Name="PerfTelemetryCpuTemp" Text="—" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <TextBlock Text="CPU 频率" FontSize="10.5" FontWeight="SemiBold" Opacity="0.62"/>
                                            <TextBlock x:Name="PerfTelemetryCpuFreq" Text="—" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="3" ToolTipService.ToolTip="系统可用物理核心数，不代表游戏 CPU Sets 限制或瞬时活跃核心数">
                                            <TextBlock Text="核心数量" FontSize="10.5" FontWeight="SemiBold" Opacity="0.62"/>
                                            <TextBlock x:Name="PerfTelemetryCores" Text="—" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="3">
                                            <TextBlock Text="GPU 功耗" FontSize="10.5" FontWeight="SemiBold" Opacity="0.62"/>
                                            <TextBlock x:Name="PerfTelemetryGpuPower" Text="—" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                            <TextBlock Text="GPU 温度" FontSize="10.5" FontWeight="SemiBold" Opacity="0.62"/>
                                            <TextBlock x:Name="PerfTelemetryGpuTemp" Text="—" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="3">
                                            <TextBlock Text="GPU 频率" FontSize="10.5" FontWeight="SemiBold" Opacity="0.62"/>
                                            <TextBlock x:Name="PerfTelemetryGpuFreq" Text="—" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3" Spacing="3">
                                            <TextBlock x:Name="PerfTelemetryBatteryLabel" Text="电池功耗" FontSize="10.5" FontWeight="SemiBold" Opacity="0.62"/>
                                            <TextBlock x:Name="PerfTelemetryBatteryPower" Text="—" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="PerfTelemetryHint" Text="正在读取设备传感器…" FontSize="10" Opacity="0.45" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0,0,0">
                                <Border Width="3" Height="11" CornerRadius="1.5" Background="#FF9A4D" VerticalAlignment="Center"/>
                                <TextBlock Text="电源模式" FontSize="11.5" Opacity="0.6" FontWeight="SemiBold" CharacterSpacing="40"/>
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 最佳能效：右上圆点=系统当前生效；待应用=已选中但尚未按 A 应用 -->
                                <Border x:Name="PerfEco" CornerRadius="12" Padding="10,8"
                                        Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1.5">
                                    <Grid>
                                        <StackPanel Spacing="4">
                                            <Border Width="24" Height="24" CornerRadius="8" Background="#3366E08A"
                                                    BorderBrush="#5566E08A" BorderThickness="1" HorizontalAlignment="Left">
                                                <!-- 叶片：能效 / 省电 -->
                                                <Path Fill="#66E08A" Stretch="Uniform" Width="13" Height="13"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M20,4 C10.5,4 4.5,9.5 4.5,16.5 C4.5,17.7 4.7,18.7 5,19.5 C12.2,19.5 20,14 20,4 Z"/>
                                            </Border>
                                            <TextBlock Text="最佳能效" FontSize="13" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border Background="#1F66E08A" CornerRadius="5" Padding="6,1" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="PerfEcoBadge" Text="省电优先" FontSize="9.5" Foreground="#66E08A"/>
                                                </Border>
                                                <TextBlock x:Name="PerfEcoPending" Text="待应用" FontSize="9.5"
                                                           Foreground="#FFB366" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Ellipse x:Name="PerfEcoActive" Width="7" Height="7" Fill="#66E08A"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>

                                <!-- 均衡 -->
                                <Border x:Name="PerfBalanced" Grid.Column="1" CornerRadius="12" Padding="10,8"
                                        Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1.5">
                                    <Grid>
                                        <StackPanel Spacing="4">
                                            <Border Width="24" Height="24" CornerRadius="8" Background="#337AB8FF"
                                                    BorderBrush="#557AB8FF" BorderThickness="1" HorizontalAlignment="Left">
                                                <!-- 调节滑杆：均衡 -->
                                                <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Stroke="#7AB8FF" StrokeThickness="1.8"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              Data="M3.5,8.5 H20.5 M3.5,15.5 H20.5"/>
                                                        <Path Fill="#7AB8FF" Data="M9,6.2 A2.3,2.3 0 1,1 9,10.8 A2.3,2.3 0 1,1 9,6.2 Z"/>
                                                        <Path Fill="#7AB8FF" Data="M15,13.2 A2.3,2.3 0 1,1 15,17.8 A2.3,2.3 0 1,1 15,13.2 Z"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <TextBlock Text="平衡" FontSize="13" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border Background="#1F7AB8FF" CornerRadius="5" Padding="6,1" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="PerfBalancedBadge" Text="均衡运行" FontSize="9.5" Foreground="#7AB8FF"/>
                                                </Border>
                                                <TextBlock x:Name="PerfBalancedPending" Text="待应用" FontSize="9.5"
                                                           Foreground="#FFB366" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Ellipse x:Name="PerfBalancedActive" Width="7" Height="7" Fill="#7AB8FF"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>

                                <!-- 性能 -->
                                <Border x:Name="PerfPerformance" Grid.Column="2" CornerRadius="12" Padding="10,8"
                                        Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1.5">
                                    <Grid>
                                        <StackPanel Spacing="4">
                                            <Border Width="24" Height="24" CornerRadius="8" Background="#33FF9A4D"
                                                    BorderBrush="#55FF9A4D" BorderThickness="1" HorizontalAlignment="Left">
                                                <!-- 闪电：性能 -->
                                                <Path Fill="#FFB366" Stretch="Uniform" Width="13" Height="13"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M13.4,2 L5.6,13.4 H11.2 L10.4,21.8 L18.2,10.4 H12.6 Z"/>
                                            </Border>
                                            <TextBlock Text="最佳性能" FontSize="13" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border Background="#26FF9A4D" CornerRadius="5" Padding="6,1" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="PerfPerformanceBadge" Text="性能优先" FontSize="9.5" Foreground="#FFB366"/>
                                                </Border>
                                                <TextBlock x:Name="PerfPerformancePending" Text="待应用" FontSize="9.5"
                                                           Foreground="#FFB366" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Ellipse x:Name="PerfPerformanceActive" Width="7" Height="7" Fill="#FFB366"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>

                            </Grid>
                            <TextBlock x:Name="PerfSystemMode" Text="当前系统模式：正在读取…" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="4,0,0,0"/>

                            <!-- 全局锁帧 -->
                            <StackPanel x:Name="PerfGlobalSettings" Spacing="8"/>

                            <!-- 功耗控制 / CPU·GPU 两列并排 -->
                            <Grid x:Name="PerfAdvancedSettings" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="PerfPowerSettings" Spacing="8"/>
                                <StackPanel x:Name="PerfCpuSettings" Grid.Column="1" Spacing="8"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- 说明条：独立占一行，透明底 + 细线框，便于识别 -->
                    <Border Grid.Row="2" Height="52" CornerRadius="12" Background="Transparent"
                            BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="12,6">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PerfControlHelp" FontSize="12" FontWeight="SemiBold" Opacity="0.9"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <!-- 面板内状态提示：保存结果/失败原因（主页 toast 会被性能浮层遮住，必须在这里显示） -->
                            <TextBlock x:Name="PerfStatusText" FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                            <!-- 鼠标/触屏保存入口：与手柄 X 等价，一次写入所有待应用修改 -->
                            <Button x:Name="PerfSaveButton" Grid.Column="1" Content="保存"
                                    FontSize="12" FontWeight="SemiBold" Padding="16,5"
                                    CornerRadius="8" BorderThickness="1"
                                    VerticalAlignment="Center"
                                    IsTabStop="False" AllowFocusOnInteraction="False" UseSystemFocusVisuals="False">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFC98A" Offset="0"/>
                                        <GradientStop Color="#FFFF9A4D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Foreground>
                                    <SolidColorBrush Color="#FF241505"/>
                                </Button.Foreground>
                                <Button.BorderBrush>
                                    <SolidColorBrush Color="#66FFFFFF"/>
                                </Button.BorderBrush>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 按键提示：收进面板底部，与内容同宽居中 -->
                    <Border Grid.Row="3" HorizontalAlignment="Center" Margin="0"
                            Padding="12,2" CornerRadius="10" Background="#1F0A0C10">
                        <ctl:GamepadHintBar x:Name="PerformanceHintBar" BadgeScale="0.9"
                                            Hints="UD:选择|LR:切列/选档|A:切换模式|RS:调值|X:保存|B:关闭"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 下载模式遮罩：下载模式磁贴 A/点击打开 —— 先设下载时长与完成动作，进入后熄屏 + 静音 + 整屏纯黑，
             只保留剩余时间 / 当前网速 / 当前时间与两个按钮；「查看下载进度」临时还原屏幕并切回下载页 5 秒 -->
        <Grid x:Name="DownloadOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#FF000000" XYFocusKeyboardNavigation="Disabled">

            <!-- ① 进入前：设定下载时间与完成后的动作 -->
            <Grid x:Name="DownloadSetupPanel" Padding="24">
                <StackPanel Width="430" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="4" Margin="0,0,0,10">
                        <TextBlock Text="下载模式" FontSize="30" FontWeight="Bold" CharacterSpacing="60"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="先把下载页面切到前台，进入后屏幕会熄灭并静音"
                                   FontSize="12" Opacity="0.45" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border x:Name="DlDurationRow" CornerRadius="16" Padding="18,12" Background="#12FFFFFF"
                            BorderBrush="Transparent" BorderThickness="1.5">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="下载时间" FontSize="12" Opacity="0.55"/>
                                <TextBlock x:Name="DlDurationText" Text="60 分钟" FontSize="26" FontWeight="SemiBold"/>
                            </StackPanel>
                            <!-- 触屏：− / + 调节下载时长 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border x:Name="DlDurationMinus" Width="44" Height="40" CornerRadius="10"
                                        Background="#1FFFFFFF" BorderBrush="Transparent" BorderThickness="1.5"
                                        Tapped="OnDownloadDurationMinusTapped"
                                        ToolTipService.ToolTip="减少 5 分钟">
                                    <TextBlock Text="−" FontSize="20" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="DlDurationPlus" Width="44" Height="40" CornerRadius="10"
                                        Background="#1FFFFFFF" BorderBrush="Transparent" BorderThickness="1.5"
                                        Tapped="OnDownloadDurationPlusTapped"
                                        ToolTipService.ToolTip="增加 5 分钟">
                                    <TextBlock Text="+" FontSize="20" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="DlActionRow" CornerRadius="16" Padding="18,12" Background="#12FFFFFF"
                            BorderBrush="Transparent" BorderThickness="1.5">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="下载完成后" FontSize="12" Opacity="0.55"/>
                                <TextBlock x:Name="DlActionText" Text="睡眠" FontSize="26" FontWeight="SemiBold"/>
                            </StackPanel>
                            <!-- 触屏：点击循环切换完成动作 -->
                            <Border x:Name="DlActionSwitch" Grid.Column="1" Width="76" Height="40" CornerRadius="10"
                                    Background="#1FFFFFFF" BorderBrush="Transparent" BorderThickness="1.5"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Tapped="OnDownloadActionSwitchTapped"
                                    ToolTipService.ToolTip="切换完成后的动作">
                                <TextBlock Text="切换" FontSize="14" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="DlStartRow" Height="54" CornerRadius="16" Background="#2EFFB366"
                            BorderBrush="Transparent" BorderThickness="1.5"
                            Tapped="OnDownloadStartTapped">
                        <TextBlock x:Name="DlStartText" Text="开始下载模式" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#FFFFB366" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="DlCancelRow" Height="48" CornerRadius="16" Background="#12FFFFFF"
                            BorderBrush="Transparent" BorderThickness="1.5"
                            Tapped="OnDownloadCancelTapped">
                        <TextBlock x:Name="DlCancelText" Text="取消" FontSize="14.5" Opacity="0.85"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ctl:GamepadHintBar x:Name="DownloadSetupHint" HorizontalAlignment="Center" BadgeScale="0.9"
                                        Hints="UD:选择|LB/RB:调整|A:确认|B:取消"/>
                </StackPanel>
            </Grid>

            <!-- ② 运行中：时钟 + 剩余时间 + 网速 + 两个按钮 -->
            <Grid x:Name="DownloadRunningPanel" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,44,0,0" Spacing="2">
                    <TextBlock x:Name="DlClockText" Text="00:00" FontSize="44" FontWeight="SemiBold"
                               CharacterSpacing="40" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DlClockDate" Text="" FontSize="12" Opacity="0.4"
                               CharacterSpacing="60" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="剩余下载时间" FontSize="13" Opacity="0.45" CharacterSpacing="160"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DlRemainText" Text="60:00" FontSize="86" FontWeight="Light"
                               CharacterSpacing="20" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <StackPanel Spacing="3">
                            <TextBlock Text="当前网速" FontSize="11.5" Opacity="0.4" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DlSpeedText" Text="0 KB/s" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Width="1" Background="#1FFFFFFF" Margin="2,2"/>
                        <StackPanel Spacing="3">
                            <TextBlock Text="完成后" FontSize="11.5" Opacity="0.4" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DlAfterText" Text="睡眠" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,56" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                        <Border x:Name="DlPeekRow" Width="220" Height="56" CornerRadius="16" Background="#14FFFFFF"
                                BorderBrush="Transparent" BorderThickness="1.5"
                                Tapped="OnDownloadPeekTapped">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8A7;" FontSize="15" Opacity="0.85"/>
                                <TextBlock Text="查看下载进度" FontSize="14.5"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="DlCloseRow" Width="220" Height="56" CornerRadius="16" Background="#14FFFFFF"
                                BorderBrush="Transparent" BorderThickness="1.5"
                                Tapped="OnDownloadCloseTapped">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7E8;" FontSize="15" Opacity="0.85"/>
                                <TextBlock Text="关闭下载模式" FontSize="14.5"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ctl:GamepadHintBar x:Name="DownloadRunningHint" HorizontalAlignment="Center" BadgeScale="0.9"
                                        Hints="LR:选择|A:确认|B:关闭下载模式"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 壁纸遮罩：壁纸磁贴 A/点击打开 —— 询问把当前壁纸设为桌面壁纸还是锁屏壁纸。
             DPAD 选择、A 执行、B/点空白取消；点击某一项直接执行（选中项强调色描边高亮） -->
        <Grid x:Name="WallpaperOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <Border x:Name="WallpaperMask" Background="#D80A0C10"/>

            <Border x:Name="WallpaperPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="24" Padding="18,20,18,0"
                    BorderBrush="#2EFFFFFF" BorderThickness="1.2"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                        <GradientStop Color="#F22A2E36" Offset="0"/>
                        <GradientStop Color="#F21A1D23" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <CompositeTransform x:Name="WallpaperPanelTransform" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>

                <StackPanel Width="304" Spacing="10">
                    <!-- 标题：蓝色壁纸徽章 + 标题/说明 -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="2,0,0,6">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#264CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B9;" FontSize="20" Foreground="#4CC2FF"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="壁纸" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock Text="把当前壁纸设为…" FontSize="12" Opacity="0.55"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 桌面壁纸 -->
                    <Border x:Name="WallpaperDesktop" Height="52" CornerRadius="14" Padding="14,0"
                            Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1.5">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="10" Background="#266FA8FF">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="15" Foreground="#6FA8FF"/>
                                </Border>
                                <TextBlock Text="设为桌面壁纸" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                            <FontIcon Glyph="&#xE76C;" FontSize="11" Opacity="0.35"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 锁屏壁纸 -->
                    <Border x:Name="WallpaperLock" Height="52" CornerRadius="14" Padding="14,0"
                            Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1.5">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="10" Background="#269B7DFF">
                                    <FontIcon Glyph="&#xE72E;" FontSize="15" Foreground="#B9A2FF"/>
                                </Border>
                                <TextBlock Text="设为锁屏壁纸" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                            <FontIcon Glyph="&#xE76C;" FontSize="11" Opacity="0.35"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ctl:GamepadHintBar x:Name="WallpaperHintBar" TouchMode="True" CapsuleChips="True"
                                        HorizontalAlignment="Center" Margin="0,8,0,0"
                                        Hints="DPAD:选择|A:执行|B:取消"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 文件传输浮层：搜索局域网设备 → 连接 → 把文件拖进窗口 → 按 X 发送；收到的请求在这里确认 -->
        <Grid x:Name="FileTransferOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <Border x:Name="FileTransferMask" Background="#D80A0C10"/>

            <Border x:Name="FileTransferPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="24" Padding="18,18,18,0"
                    BorderBrush="#2EFFFFFF" BorderThickness="1.2"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.35,1">
                        <GradientStop Color="#F22A2E36" Offset="0"/>
                        <GradientStop Color="#F21A1D23" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <CompositeTransform x:Name="FileTransferPanelTransform" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>

                <StackPanel Width="520" Spacing="10">
                    <!-- 标题：蓝色传输徽章 + 标题/状态 -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="2,0,0,2">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#264CC2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE895;" FontSize="19" Foreground="#4CC2FF"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="文件传输" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FileTransferStatusText" Text="正在搜索局域网设备…"
                                       FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="430"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 设备列表 -->
                    <TextBlock Text="设备" FontSize="12" Opacity="0.5" Margin="4,4,0,0"/>
                    <StackPanel x:Name="FileTransferPeerList" Spacing="6"/>

                    <!-- 接收请求提示条（触屏直接点下方放大的 A/B 图标接受或拒绝） -->
                    <Border x:Name="FileTransferOfferBar" Visibility="Collapsed" CornerRadius="14" Padding="14,10"
                            Background="#2A4CC2FF" BorderBrush="#554CC2FF" BorderThickness="1">
                        <TextBlock x:Name="FileTransferOfferText" FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <!-- 待发送文件：从资源管理器/桌面直接拖进本窗口加入，不再在窗口内浏览目录 -->
                    <TextBlock x:Name="FileTransferFilesHeader" Text="待发送文件（把文件拖进窗口）" FontSize="12" Opacity="0.5" Margin="4,4,0,0"/>
                    <Border x:Name="FileTransferDropZone" CornerRadius="14" Padding="16,20"
                            Background="#104CC2FF" BorderBrush="#664CC2FF" BorderThickness="1">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="#4CC2FF"/>
                            <TextBlock x:Name="FileTransferDropText" Text="将文件拖到这里" FontSize="17"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="从桌面或资源管理器拖入文件，按 X 发送"
                                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FileTransferFileList" Spacing="6"/>
                    </ScrollViewer>

                    <!-- 进度 -->
                    <StackPanel x:Name="FileTransferProgressBox" Spacing="6" Visibility="Collapsed">
                        <ProgressBar x:Name="FileTransferProgressBar" Height="6" Minimum="0" Maximum="1"
                                     Foreground="#4CC2FF" Background="#22FFFFFF"/>
                        <TextBlock x:Name="FileTransferProgressText" FontSize="12" Opacity="0.6"/>
                    </StackPanel>

                    <!-- 触屏：图标行贴住面板底边，图标放大后可点按（连接/发送/清空/关闭） -->
                    <ctl:GamepadHintBar x:Name="FileTransferHintBar" TouchMode="True" CapsuleChips="True"
                                        HorizontalAlignment="Center" Margin="0,8,0,0"
                                        Hints="DPAD:选择|A:连接|X:发送|Y:清空|B:关闭"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 自制搜索浮层：顶栏搜索图标打开（系统 Win+S 搜索被开始菜单接管逻辑屏蔽，这里自建一个面板）。
             输入即搜开始菜单/桌面的应用快捷方式，点结果或按回车直接启动；Esc 或点遮罩关闭 -->
        <Grid x:Name="SearchOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <Border x:Name="SearchMask" Background="#C00A0C10"/>

            <Border x:Name="SearchPanel" Width="600" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,84,0,0" CornerRadius="18" Padding="16,14,16,10"
                    BorderBrush="#2EFFFFFF" BorderThickness="1.2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                        <GradientStop Color="#F22A2E36" Offset="0"/>
                        <GradientStop Color="#F21A1D23" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel Spacing="8">
                    <!-- 搜索行：放大镜 + 输入框 + 关闭按钮（等效 Esc，也给触屏/手柄用） -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="17" Foreground="#4CC2FF" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 FontSize="18" VerticalAlignment="Center"
                                 PlaceholderText="搜索应用、文件或文件夹"
                                 TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown"/>
                        <Border Grid.Column="2" Width="30" Height="30" CornerRadius="9" Background="#1AFFFFFF"
                                VerticalAlignment="Center" Tapped="OnSearchCloseTapped"
                                ToolTipService.ToolTip="关闭搜索（Esc）">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Opacity="0.72"/>
                        </Border>
                    </Grid>

                    <Border Height="1" Background="#1AFFFFFF" Margin="0,2"/>

                    <!-- 空状态/无结果提示 -->
                    <TextBlock x:Name="SearchHint" Text="输入名称开始搜索" FontSize="12.5"
                               Opacity="0.5" Margin="6,10,0,10"/>

                    <!-- 结果列表：图标 + 名称 + 来源说明 -->
                    <ListView x:Name="SearchList" MaxHeight="366" SelectionMode="None"
                              IsItemClickEnabled="True" ItemClick="OnSearchItemClick"
                              Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="9" Background="#22FFFFFF">
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="16"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontSize="14.5"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.45"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
