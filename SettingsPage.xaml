<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.SettingsPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:GameLocker.Controls">

    <Page.Resources>
        <!-- 分类卡片：直角 + 透明描边（选中时由代码换成白框），内容横向铺满 -->
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="84"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent"
          RequestedTheme="Dark" XYFocusKeyboardNavigation="Enabled">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0" Padding="20,14,20,6">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="4" Height="22" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFF7ABF" Offset="0"/>
                            <GradientStop Color="#FF57E0C9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="设置" FontSize="24" FontWeight="Bold"
                           VerticalAlignment="Center" CharacterSpacing="40"/>
            </StackPanel>
        </Grid>

        <!-- 分类入口：两列卡片（图标色块 + 标题 + 描述 + 箭头） -->
        <ScrollViewer x:Name="CategoryScroll" Grid.Row="1" Padding="20,20,20,10"
                      VerticalScrollMode="Auto" HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="CategoryPanel" ColumnSpacing="12" RowSpacing="12"
                  Padding="0,8,0,0"
                  MaxWidth="720" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 常规 -->
                <Button x:Name="GeneralCard" Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CategoryButtonStyle}" Click="OnCategoryCardClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#3858C7E8" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" Background="#26FFFFFF" BorderThickness="1"
                                BorderBrush="#33FFFFFF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="18"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="常规" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="开机自启 · 启动行为 · 停靠位置" FontSize="11"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.45"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- 外观 -->
                <Button x:Name="AppearanceCard" Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource CategoryButtonStyle}" Click="OnCategoryCardClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#38A48CFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" Background="#26FFFFFF" BorderThickness="1"
                                BorderBrush="#33FFFFFF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE790;" FontSize="18"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="玻璃效果 · 背景颜色 · 窗口透明度" FontSize="11"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.45"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- 顶栏 -->
                <Button x:Name="TopbarCard" Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CategoryButtonStyle}" Click="OnCategoryCardClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#388FB3FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" Background="#26FFFFFF" BorderThickness="1"
                                BorderBrush="#33FFFFFF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE917;" FontSize="18"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="顶栏" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="时钟 · 电池 · 网络 · 手柄图标显示" FontSize="11"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.45"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- 控制 -->
                <Button x:Name="ControlCard" Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource CategoryButtonStyle}" Click="OnCategoryCardClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#386FE3A0" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" Background="#26FFFFFF" BorderThickness="1"
                                BorderBrush="#33FFFFFF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7FC;" FontSize="18"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="控制" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="呼出组合键 · 手柄/触控操作对照" FontSize="11"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.45"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- 抽屉 -->
                <Button x:Name="DrawerCard" Grid.Row="2" Grid.Column="0"
                        Style="{StaticResource CategoryButtonStyle}" Click="OnCategoryCardClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#38FFD166" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" Background="#26FFFFFF" BorderThickness="1"
                                BorderBrush="#33FFFFFF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A4;" FontSize="18"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="抽屉" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="抽屉开关 · 固定在主页下方" FontSize="11"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.45"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- 关于 -->
                <Button x:Name="AboutCard" Grid.Row="2" Grid.Column="1"
                        Style="{StaticResource CategoryButtonStyle}" Click="OnCategoryCardClick">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#389FB6C9" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" Background="#26FFFFFF" BorderThickness="1"
                                BorderBrush="#33FFFFFF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontSize="18"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="软件信息 · GitHub · QQ 群" FontSize="11"
                                       Opacity="0.55" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.45"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>
        </ScrollViewer>

        <!-- 底部按键提示：手柄图标徽章，单行，透明背景 -->
        <ctl:GamepadHintBar Grid.Row="2" Margin="0,8,0,12"
                            Hints="DPAD:选择|A:进入|B:返回"/>
    </Grid>
</Page>
