<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.KeybindPage"
    IsTabStop="True"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:GameLocker.Controls"
    xmlns:local="using:GameLocker">

    <Page.Resources>
        <!-- 卡片：手柄焦点以"整张卡片"为一个选中框（代码里只改描边与底色），卡内内容只读 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12,14,12"/>
        </Style>

        <!-- 场景标签：卡片左上角的小胶囊 -->
        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="Background" Value="#2A4C9AFF"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="PillTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#BBD8FF"/>
        </Style>

        <!-- 说明行：左=手柄操作键帽，右=触控 / 鼠标等价操作 -->
        <DataTemplate x:Key="RowTpl" x:DataType="local:ControlRow">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1FFFFFFF" BorderBrush="#3DFFFFFF"
                        BorderThickness="1,1,1,2" CornerRadius="7" Padding="8,4"
                        VerticalAlignment="Top">
                    <TextBlock Text="{x:Bind Pad}" FontSize="13" FontWeight="SemiBold"
                               Foreground="#9ECBFF" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{x:Bind Touch}" FontSize="13.5"
                           Opacity="0.88" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>

        <!-- 说明列表只展示内容，不产生"行级选中"（手柄按卡片整体选择） -->
        <Style x:Key="RowListStyle" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource RowTpl}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="7"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 键位捕获按钮：外形像一枚键帽，可点可按 A -->
        <Style x:Key="KeyCapStyle" TargetType="Button">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#3DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent"
          RequestedTheme="Dark" XYFocusKeyboardNavigation="Enabled">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 -->
        <Grid Grid.Row="0" Padding="20,16,20,10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="BackButton" Background="Transparent" BorderThickness="0" Click="OnBackClick" IsTabStop="False">
                    <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                </Button>
                <TextBlock Text="控制" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 内容区：每张卡片就是一个手柄选中框，方向键整卡上下切换 -->
        <ScrollViewer x:Name="PageScroller" Grid.Row="1" Padding="20,4,20,12" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- 阅读提示：说明每张卡片内的左右两列各代表什么，放在最上方先讲读法 -->
                <Border x:Name="CardLegend" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <Border Style="{StaticResource PillStyle}">
                            <TextBlock Style="{StaticResource PillTextStyle}" Text="阅读提示"/>
                        </Border>
                        <TextBlock Text="左列 = 手柄操作，右列 = 对应的触控 / 鼠标操作"
                                   FontSize="13.5" Opacity="0.88" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 呼出窗口组合键 -->
                <Border x:Name="CardSummon" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <Border Style="{StaticResource PillStyle}">
                            <TextBlock Style="{StaticResource PillTextStyle}" Text="呼出窗口组合键"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="CaptureButton" Style="{StaticResource KeyCapStyle}" Click="OnCaptureClick">
                                <TextBlock x:Name="CaptureText" FontSize="15" FontWeight="SemiBold" Foreground="#CFE2FF"/>
                            </Button>
                            <TextBlock Text="按 A 或点击后按住想要的组合键，全部松开即保存"
                                       FontSize="12.5" Opacity="0.55" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 切换全屏组合键 -->
                <Border x:Name="CardFullscreen" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <Border Style="{StaticResource PillStyle}">
                            <TextBlock Style="{StaticResource PillTextStyle}" Text="切换全屏组合键"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="FsCaptureButton" Style="{StaticResource KeyCapStyle}" Click="OnFsCaptureClick">
                                <TextBlock x:Name="FsCaptureText" FontSize="15" FontWeight="SemiBold" Foreground="#CFE2FF"/>
                            </Button>
                            <TextBlock Text="按 A 或点击后按住想要的组合键，全部松开即保存"
                                       FontSize="12.5" Opacity="0.55" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 主页 / 磁贴集 -->
                <Border x:Name="CardHome" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <Border Style="{StaticResource PillStyle}">
                            <TextBlock Style="{StaticResource PillTextStyle}" Text="主页 / 磁贴集"/>
                        </Border>
                        <ItemsControl x:Name="LvHome" Style="{StaticResource RowListStyle}"/>
                    </StackPanel>
                </Border>

                <!-- 编辑模式 -->
                <Border x:Name="CardEdit" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <Border Style="{StaticResource PillStyle}">
                            <TextBlock Style="{StaticResource PillTextStyle}" Text="编辑模式"/>
                        </Border>
                        <ItemsControl x:Name="LvEdit" Style="{StaticResource RowListStyle}"/>
                    </StackPanel>
                </Border>

                <!-- 设置 -->
                <Border x:Name="CardSettings" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <Border Style="{StaticResource PillStyle}">
                            <TextBlock Style="{StaticResource PillTextStyle}" Text="设置"/>
                        </Border>
                        <ItemsControl x:Name="LvSettings" Style="{StaticResource RowListStyle}"/>
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border x:Name="CardAbout" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <Border Style="{StaticResource PillStyle}">
                            <TextBlock Style="{StaticResource PillTextStyle}" Text="关于"/>
                        </Border>
                        <ItemsControl x:Name="LvAbout" Style="{StaticResource RowListStyle}"/>
                    </StackPanel>
                </Border>

                <!-- 全局呼出 -->
                <Border x:Name="CardGlobal" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <Border Style="{StaticResource PillStyle}">
                            <TextBlock Style="{StaticResource PillTextStyle}" Text="全局呼出"/>
                        </Border>
                        <ItemsControl x:Name="LvGlobal" Style="{StaticResource RowListStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ctl:GamepadHintBar Grid.Row="2" Margin="0,8,0,12"
                            Hints="DPAD:切换卡片|A:捕获键位|B:返回"/>
    </Grid>
</Page>
