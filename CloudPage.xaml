<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="GameLocker.CloudPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="using:GameLocker.Controls">
    <Grid Background="Transparent" RequestedTheme="Dark" XYFocusKeyboardNavigation="Enabled">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10" Padding="20,16">
            <Button Background="Transparent" BorderThickness="0" Click="OnBackClick" IsTabStop="False">
                <FontIcon Glyph="&#xE72B;" FontSize="16"/>
            </Button>
            <TextBlock Text="游戏存档云端备份" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="24,8" VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="20">
                <TextBlock x:Name="IntroText" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                <StackPanel Spacing="8">
                    <TextBlock Text="备份网盘" FontSize="17" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <RadioButton x:Name="TianyiProviderRadio" Content="天翼云盘" GroupName="CloudProvider" Checked="OnProviderChanged"/>
                        <RadioButton x:Name="BaiduProviderRadio" Content="百度网盘" GroupName="CloudProvider" Checked="OnProviderChanged"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="AccountTitle" Text="天翼云账号" FontSize="17" FontWeight="Bold"/>
                    <TextBlock x:Name="AccountText" FontSize="13" TextWrapping="Wrap"/>
                    <Button x:Name="LoginButton" Content="扫码登录 / 刷新二维码" Click="OnLoginClick"/>
                    <Image x:Name="QrImage" Width="220" Height="220" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    <Button x:Name="LogoutButton" Content="退出登录" Click="OnLogoutClick"/>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="云端目录名" FontSize="17" FontWeight="Bold"/>
                    <TextBlock x:Name="RootHint" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                    <TextBox x:Name="RootBox" PlaceholderText="GameLocker"/>
                </StackPanel>
                <StackPanel Spacing="10">
                    <Button x:Name="SaveButton" Content="保存目录" Click="OnSaveClick"/>
                    <Button x:Name="TestButton" Content="测试连接" Click="OnTestClick"/>
                    <TextBlock x:Name="StatusText" FontSize="13" Opacity="0.8" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Text="在存档磁贴中选择「云端」：A 键上传备份，Y 键选择云端版本恢复。恢复前会自动备份当前存档。" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <ctl:GamepadHintBar Grid.Row="2" Margin="0,8,0,12" Hints="DPAD:选择|A:确认/输入|B:返回"/>
    </Grid>
</Page>
