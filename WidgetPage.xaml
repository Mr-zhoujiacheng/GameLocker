<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GameLocker.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameLocker"
    xmlns:ctl="using:GameLocker.Controls">

    <Page.Resources>
        <!-- 小组件卡片：直角 + 类型色底（各卡片本地覆盖 Background）；
             背后两层错位卡片由代码统一加到每张卡片上（WidgetPage.WrapStack），"多个"角标只给可重复添加的卡片 -->
        <Style x:Key="WidgetCardStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent" RequestedTheme="Dark">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：左侧标题（彩条 + 渐变字 + 入场动效） -->
        <Grid Grid.Row="0" Padding="20,12,20,6">
            <StackPanel x:Name="TitlePanel" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <StackPanel.RenderTransform>
                    <CompositeTransform/>
                </StackPanel.RenderTransform>
                <Border Width="4" Height="22" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF7ABF" Offset="0"/>
                            <GradientStop Color="#58C7E8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="小组件" FontSize="22" FontWeight="SemiBold" CharacterSpacing="40">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#B9D9FF" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- 组件列表：磁贴式自适应排布 —— 卡片尺寸固定，列数按可用宽度算（侧边栏 3 列、全屏/居中更多列），
             整块水平居中；实际坐标由 WidgetPage.LayoutCards() 写入，与主页磁贴同一套做法 -->
        <ScrollViewer x:Name="FormScroll" Grid.Row="1" Padding="12,4"
                      HorizontalContentAlignment="Left"
                      VerticalScrollMode="Auto" VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Canvas x:Name="FormPanel">

                <!-- 音乐控制器：粉 -->
                <Button x:Name="MusicWidgetCard" Tag="music" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="控制正在播放的音乐：播放 / 暂停、上一首 / 下一首，A 键执行播放暂停">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#38FF7ABF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="TilePreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="音乐控制器" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 图片组：青绿 -->
                <Button x:Name="PhotoWidgetCard" Tag="photo" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="轮番展示指定文件夹中的图片：添加后按 R3 选择图片文件夹">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#3857E0C9" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="PhotoPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="图片组" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 天气：黄 -->
                <Button x:Name="WeatherWidgetCard" Tag="weather" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="显示当前位置当天的天气、温度、湿度与风力">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#38FFD166" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="WeatherPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="天气" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 磁贴映射：青，可多个 -->
                <Button x:Name="MappingWidgetCard" Tag="mapping" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="把手柄或键盘按键映射成一个宏，点按即触发；可添加多个">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#3858C7E8" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="MappingPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="磁贴映射" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 修改器：绿 -->
                <Button x:Name="TrainerWidgetCard" Tag="trainer" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="自动下载并打开当前游戏的修改器">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#388FE388" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="TrainerPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="修改器" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 游戏存档：蓝 -->
                <Button x:Name="BackupWidgetCard" Tag="backup" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="一键备份当前游戏存档；退出游戏后按 Y 键从最新备份恢复（覆盖本地）">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#386FA8FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="BackupPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="游戏存档" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 手柄映射：紫，可多个 -->
                <Button x:Name="GamepadMapWidgetCard" Tag="gamepadmap" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="把手柄按键映射成键盘 / 鼠标操作；可添加多个">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#38A48CFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="GamepadMapPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="手柄映射" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- OptiScaler：青蓝 -->
                <Button x:Name="OptiScalerWidgetCard" Tag="optiscaler" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="检测当前游戏适配性，一键注入 / 还原 OptiScaler">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#387DE8FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="OptiScalerPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="OptiScaler" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 回收站：灰蓝 -->
                <Button x:Name="RecycleBinWidgetCard" Tag="recyclebin" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="A 打开回收站，Y 一键清空回收站">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#389FB6C9" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="RecycleBinPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="回收站" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 前台应用：绿 -->
                <Button x:Name="ForegroundWidgetCard" Tag="foreground" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="监测当前前台应用；A 冻结 / 解冻，Y 结束进程">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#386FE3A0" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="ForegroundPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="前台应用" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 系统：蓝紫 -->
                <Button x:Name="SystemWidgetCard" Tag="system" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="系统面板：设置、电脑、音量、亮度、WiFi、蓝牙、热点、夜间模式">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#388FB3FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="SystemPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="系统" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 性能监控：黄绿 -->
                <Button x:Name="MonitorWidgetCard" Tag="monitor" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="A 开启置顶监控条：帧率、CPU、GPU、电池、内存与当前时间">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#38A8E86F" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="MonitorPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="性能监控" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 文件传输：天蓝 -->
                <Button x:Name="FileTransferWidgetCard" Tag="filetransfer" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="局域网互传文件：搜索设备、连接、发送与接收">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#384CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="FileTransferPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="文件传输" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 小黄鸭：橙 -->
                <Button x:Name="LosslessScalWidgetCard" Tag="lossless" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="窗口捕获插帧：一键启动小黄鸭并发送热键">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#38FFC46B" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="LosslessScalPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="小黄鸭" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 屏幕键盘：淡紫 -->
                <Button x:Name="KeyboardWidgetCard" Tag="keyboard" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="贴边竖向屏幕键盘，点按直接输入到当前前台应用">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#389B9BFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="KeyboardPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="屏幕键盘" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- 小猫咪：蓝紫 -->
                <Button x:Name="ClashWidgetCard" Tag="clash" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="Clash：A 开关系统代理连接，Y 测速并自动选择最快的服务器">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#386E7BFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="ClashPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="Clash" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- 壁纸：青蓝 -->
                <Button x:Name="WallpaperWidgetCard" Tag="wallpaper" Style="{StaticResource WidgetCardStyle}" Click="OnAddClick"
                        ToolTipService.ToolTip="轮番展示 Bing / Picsum 壁纸，固定大磁贴；A 可设为桌面或锁屏壁纸">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#384CC2FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Spacing="10">
                        <Viewbox MaxHeight="126" Stretch="Uniform" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="WallpaperPreviewHost"/>
                        </Viewbox>
                        <TextBlock Text="壁纸" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Canvas>
        </ScrollViewer>

        <!-- 底部：选中组件的说明条 -->
        <Border x:Name="DescBar" Grid.Row="2" HorizontalAlignment="Center" Margin="20,0,20,8"
                Background="#14FFFFFF" BorderThickness="1" BorderBrush="#1FFFFFFF" Padding="16,6"
                Visibility="Collapsed">
            <TextBlock x:Name="SelDescText" MaxWidth="640" FontSize="16" FontWeight="Bold"
                       CharacterSpacing="10" Foreground="#F0FFFFFF" Opacity="0.92"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- 底部：按键提示 -->
        <ctl:GamepadHintBar Grid.Row="3" Margin="0,2,0,10"
                            Hints="A:添加到主页|B:返回"/>
    </Grid>
</Page>
